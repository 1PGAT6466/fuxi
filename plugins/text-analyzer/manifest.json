{
  "name": "text-analyzer",
  "version": "1.0.0",
  "type": "api",
  "display_name": "文本分析器",
  "description": "分析文本的字数、句数、关键词提取、情感分析",
  "author": "伏羲团队",
  "icon": "📝",
  "routes": [
    {
      "path": "/api/plugins/text-analyzer/analyze",
      "method": "POST",
      "handler": "analyze_text",
      "description": "分析文本内容"
    },
    {
      "path": "/api/plugins/text-analyzer/keywords",
      "method": "POST",
      "handler": "extract_keywords",
      "description": "提取关键词"
    }
  ],
  "events": ["on_text_input"],
  "dependencies": [],
  "config_schema": {
    "max_text_length": {
      "type": "number",
      "default": 10000,
      "description": "最大分析文本长度"
    },
    "language": {
      "type": "string",
      "default": "zh",
      "description": "默认语言"
    }
  }
}
