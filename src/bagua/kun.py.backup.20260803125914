    def _try_auto_graph(self, content: str, doc_id: str) -> Dict[str, Any]:
        """灏濊瘯瀵规枃妗ｅ唴瀹规墽琛岃嚜鍔ㄥ浘璋辨瀯寤猴紙鍐呴儴鏂规硶锛岄潪闃诲锛?

        鍦?push_to_wiki 鎴愬姛鍚庤嚜鍔ㄨ皟鐢ㄣ€?
        绾鍒欓┍鍔紝闆?LLM 璋冪敤锛屼笉鎶涘紓甯搞€?

        Args:
            content: 鏂囨。鍐呭
            doc_id:  鏂囨。鏍囪瘑

        Returns:
            {"ok": True/False, "entities": int, "edges": int, ...}
        """
        result = {"ok": False, "doc_id": doc_id, "entities": 0, "edges": 0}

        try:
            builder = get_auto_graph_builder()

            # 鎻愬彇瀹炰綋
            entities = builder.extract_entities(content)

            # 鏋勫缓杈?
            edges = builder.build_from_text(content, doc_id)

            result["entities"] = len(entities)
            result["edges"] = len(edges)

            # 濡傛灉鏈夊疄浣撴垨杈癸紝鍐欏叆瀛樺偍
            if entities or edges:
                graph_data = builder.build_full_graph(content, doc_id)

                store_result = self.store_graph(
                    entities=graph_data["entities"],
                    relations=graph_data["edges"],
                    doc_id=doc_id,
                )
                result["ok"] = store_result.get("ok", False)
                result["stored"] = store_result.get("ok", False)
            else:
                result["ok"] = True
                result["stored"] = False

            logger.debug(
                "鈽?[鍧 auto_graph: doc=%s 鈫?%d 瀹炰綋, %d 杈?,
                doc_id,
                len(entities),
                len(edges),
            )

        except (ValueError, KeyError, OSError) as e:
            logger.warning(
                "鈽?[鍧 auto_graph 璺宠繃 (doc=%s): %s",
                doc_id,
                e,
            )
            result["error"] = str(e)

        return result

    def auto_graph_from_doc(
        self,
        doc_id: str = "",
        content: str = "",
        doc_name: str = "",
    ) -> Dict[str, Any]:
        """瀵规寚瀹氭枃妗ｆ墽琛岃嚜鍔ㄥ浘璋辨瀯寤猴紙鏄惧紡 API锛?

        鏀寔閫氳繃 execute(action="auto_graph") 鏄惧紡璋冪敤銆?
        鍙敤浜庢壒閲忓悗绔噸寤哄浘璋便€?

        Args:
            doc_id:   鏂囨。鏍囪瘑锛堜负绌烘椂浠?content hash 鐢熸垚锛?
            content:  鏂囨。鍐呭
            doc_name: 鏂囨。鍚嶇О锛堝彲閫夛紝鐢ㄤ簬鏃ュ織锛?

        Returns:
            {
                "ok": True/False,
                "doc_id": str,
                "doc_name": str,
                "entities": [...],   # 鎻愬彇鐨勫疄浣撳垪琛?
                "edges": [...],       # 鎻愬彇鐨勮竟鍒楄〃
                "entity_count": int,
                "edge_count": int,
                "graph_stored": bool,
                "error": str (浠呭け璐ユ椂),
            }
        """
        result: Dict[str, Any] = {
            "ok": False,
            "doc_id": doc_id,
            "doc_name": doc_name,
            "entities": [],
            "edges": [],
            "entity_count": 0,
            "edge_count": 0,
            "graph_stored": False,
        }

        if not content or not content.strip():
            result["error"] = "content 涓虹┖"
            return result

        if not doc_id:
            doc_id = hashlib.sha256(content.encode("utf-8")).hexdigest()[:16]
            result["doc_id"] = doc_id

        try:
            builder = get_auto_graph_builder()
            graph_data = builder.build_full_graph(content, doc_id)

            result["entities"] = graph_data["entities"]
            result["edges"] = graph_data["edges"]
            result["entity_count"] = graph_data["stats"]["entity_count"]
            result["edge_count"] = graph_data["stats"]["edge_count"]

            # 鍐欏叆鐭ヨ瘑鍥捐氨瀛樺偍
            if result["entities"] or result["edges"]:
                store_result = self.store_graph(
                    entities=result["entities"],
                    relations=result["edges"],
                    doc_id=doc_id,
                )
                result["graph_stored"] = store_result.get("ok", False)

            result["ok"] = True

            logger.info(
                "鈽?[鍧 auto_graph_from_doc: doc=%s 鈫?%d 瀹炰綋, %d 杈?,
                doc_id,
                result["entity_count"],
                result["edge_count"],
            )

        except (ValueError, KeyError, OSError) as e:
            logger.error(
                "鈽?[鍧 auto_graph_from_doc 澶辫触: %s",
                e,
                exc_info=True,
            )
            result["error"] = str(e)

        return result

    def get_auto_graph_stats(self) -> Dict[str, Any]:
        """鑾峰彇鑷姩鍥捐氨鏋勫缓鍣ㄧ粺璁′俊鎭?

        Returns:
            AutoGraphBuilder stats + 鍧ゅ崷鍐呴儴鐭ヨ瘑鍥捐氨缁熻
        """
        builder = get_auto_graph_builder()
        builder_stats = builder.get_stats()

        # 璇诲彇鐭ヨ瘑鍥捐氨瀛樺偍缁熻
        kg_stats = {"nodes_count": 0, "edges_count": 0, "graph_file": ""}
        try:
            from src.config import GRAPH_PATH

            kg_stats["graph_file"] = str(GRAPH_PATH)
            if os.path.exists(GRAPH_PATH):
                with open(GRAPH_PATH, "r", encoding="utf-8") as f:
                    kg_data = json.load(f)
                    nodes = kg_data.get("nodes", kg_data.get("entities", {}))
                    kg_stats["nodes_count"] = len(nodes)
