    # v1.50 Phase E: Company Brain 鏉冮檺闅旂 鈥?甯︽潈闄愯繃婊ょ殑妫€绱?
    # ========================================================================

    def recall_memory(
        self,
        query: str = "",
        top_k: int = 10,
        user_id: str = "",
        team_id: Optional[str] = None,
        use_vector: bool = True,
    ) -> List[Dict[str, Any]]:
        """甯︽潈闄愯繃婊ょ殑鏂囨。妫€绱?

        瀵规爣 GBrain Company Brain锛氬洟闃熸瘡涓垚鍛樺彧鐪嬪埌鑷繁鏈夋潈闄愮殑鏁版嵁銆?

        妫€绱㈡祦绋?
          1. 鎵ц鍚戦噺/keyword 妫€绱?
          2. 璋冪敤 PermissionManager 杩囨护缁撴灉
          3. 鍙繑鍥炵敤鎴锋湁鏉冭闂殑鏂囨。

        Args:
            query:     妫€绱㈡煡璇㈣瘝
            top_k:     杩斿洖缁撴灉鏁帮紙杩囨护鍓嶏級
            user_id:   褰撳墠鐢ㄦ埛 ID
            team_id:   褰撳墠鐢ㄦ埛鍥㈤槦 ID锛堝彲閫夛級
            use_vector: 鏄惁灏濊瘯鍚戦噺妫€绱?

        Returns:
            杩囨护鍚庣殑缁撴灉鍒楄〃
        """
        # 姝ラ 1: 妫€绱?
        results = self.recall_wiki(query=query, top_k=max(top_k * 2, 20))

        if not results:
            return []

        # 姝ラ 2: 鏉冮檺杩囨护
        try:
            from src.api.permissions import get_permission_manager

            pm = get_permission_manager()
        except ImportError:
            logger.warning("鈽?[鍧 permissions 妯″潡涓嶅彲鐢紝璺宠繃鏉冮檺杩囨护")
            return results[:top_k]

        # 濡傛灉鏈寚瀹?team_id锛屽皾璇曚粠鐢ㄦ埛淇℃伅涓幏鍙?
        if not team_id and user_id:
            team_id = pm.get_user_team_id(user_id)

        filtered = []
        for r in results:
            metadata = r if isinstance(r, dict) else {}
            doc_owner_id = metadata.get("owner_id", "")
            doc_team_id = metadata.get("team_id", "public")
            doc_visibility = metadata.get("visibility", "public")

            if pm.check_read(
                user_id=user_id,
                team_id=team_id,
                doc_owner_id=doc_owner_id,
                doc_team_id=doc_team_id,
                doc_visibility=doc_visibility,
            ):
                filtered.append(r)
                if len(filtered) >= top_k:
                    break

        filtered_count = len(results) - len(filtered)
        if filtered_count > 0:
            logger.debug(
                "鈽?[鍧 馃敀 鏉冮檺杩囨护: %d/%d 鏉＄粨鏋滃凡杩囨护 (user=%s, team=%s)",
                filtered_count,
                len(results),
                user_id,
                team_id,
            )

        return filtered

