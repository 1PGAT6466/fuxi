    def store_conversation(
        self,
        session_id: str = "default",
        role: str = "user",
        content: str = "",
    ) -> Dict[str, Any]:
        """瀛樺偍涓€鏉″璇濆埌鐭湡璁板繂

        杩佺Щ鑷?HeartAgent._handle_store_memory銆?
        姣忎釜 session_id 鐙珛瀛樺偍锛屽叏灞€涓婇檺 SHORT_TERM_MAX 鏉°€?

        Args:
            session_id: 浼氳瘽鏍囪瘑
            role:       瑙掕壊锛?user" / "assistant" / "system"锛?
            content:    瀵硅瘽鍐呭鏂囨湰

        Returns:
            {"ok": True, "stored": int} 鈥?褰撳墠瀛樺偍鏉℃暟
        """
        if not content:
            return {"ok": False, "stored": 0, "error": "绌哄唴瀹?}

        # ---- 姣忔鍐欏叆鍓嶆竻鐞嗚繃鏈?session ----
        self._cleanup_expired_sessions()

        if session_id not in self._short_term:
            self._short_term[session_id] = []

        # 鏇存柊娲诲姩鏃堕棿鎴?
        self._session_activity[session_id] = time.time()

        entry: Dict[str, Any] = {
            "role": role,
            "content": content,
            "time": time.time(),
        }
        self._short_term[session_id].append(entry)

        # 瓒呰繃涓婇檺 鈫?鎴柇淇濈暀鏈€鏂?N 鏉?
        if len(self._short_term[session_id]) > self.SHORT_TERM_MAX:
            self._short_term[session_id] = self._short_term[session_id][-self.SHORT_TERM_MAX :]
            logger.debug(
                "鈽?[鍧 Session %s 璁板繂瓒?%d 鏉★紝宸叉埅鏂?,
                session_id,
                self.SHORT_TERM_MAX,
            )

        self._memories_stored += 1
        return {"ok": True, "stored": len(self._short_term[session_id])}

    # ========================================================================
    # Session 鐢熷懡鍛ㄦ湡绠＄悊
    # ========================================================================

    def _cleanup_expired_sessions(self) -> None:
        """娓呯悊杩囨湡 session 鍜岃秴閲忕殑 session

        娓呯悊绛栫暐锛?
          1. 绉婚櫎瓒呰繃 SESSION_TTL 鏈椿鍔ㄧ殑 session
          2. 濡傛灉 session 鎬绘暟瓒呰繃 SESSION_MAX_COUNT锛?
             鎸?last_activity 鎺掑簭锛屾竻鐞嗘渶涔呮湭娲诲姩鐨勬渶澶?20% session
        """
        now = time.time()

        # ---- 姝ラ 1: 鎸?TTL 娓呯悊 ----
        expired_ids = [sid for sid, last_act in self._session_activity.items() if now - last_act > self.SESSION_TTL]
        for sid in expired_ids:
            self._remove_session(sid)

        if expired_ids:
            logger.debug(
                "鈽?[鍧 TTL 娓呯悊: 绉婚櫎 %d 涓繃鏈?session",
                len(expired_ids),
            )

        # ---- 姝ラ 2: 鎸夋暟閲忎笂闄愭竻鐞?----
        current_count = len(self._session_activity)
        if current_count > self.SESSION_MAX_COUNT:
            # 鎸?last_activity 鍗囧簭锛屾渶涔呮湭娲诲姩鐨勬帓鍓嶉潰
            sorted_sessions = sorted(
                self._session_activity.items(),
                key=lambda item: item[1],
            )
            # 娓呯悊瓒呭嚭涓婇檺鐨?20%锛堣嚦灏戞竻鐞?1 涓級
            overflow = current_count - self.SESSION_MAX_COUNT
            remove_count = max(overflow, int(current_count * 0.2), 1)
            to_remove = sorted_sessions[:remove_count]
            for sid, _ in to_remove:
                self._remove_session(sid)
            logger.warning(
                "鈽?[鍧 瀹归噺娓呯悊: session %d/%d锛岀Щ闄?%d 涓渶涔呮湭娲诲姩 session",
                current_count,
                self.SESSION_MAX_COUNT,
                remove_count,
            )

    def _remove_session(self, session_id: str) -> None:
        """绉婚櫎鎸囧畾 session 鐨勬墍鏈夋暟鎹?

        Args:
            session_id: 瑕佺Щ闄ょ殑浼氳瘽鏍囪瘑
        """
        self._short_term.pop(session_id, None)
        self._preferences.pop(session_id, None)
        self._session_activity.pop(session_id, None)

    def recall_conversation(
        self,
        session_id: str = "default",
        n: int = 10,
    ) -> Dict[str, Any]:
        """鍙洖鏈€杩?N 鏉″璇濊褰?

        杩佺Щ鑷?HeartAgent._handle_recall銆?

        Args:
            session_id: 浼氳瘽鏍囪瘑
            n:          鍙洖鏉℃暟锛堥粯璁?10锛?

        Returns:
            {"history": [{"role": ..., "content": ..., "time": ...}, ...]}
        """
        memories = self._short_term.get(session_id, [])
        return {"history": list(memories[-n:])}

