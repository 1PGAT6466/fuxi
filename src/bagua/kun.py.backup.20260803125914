    def store_graph(
        self,
        entities: List[Dict[str, Any]],
        relations: List[Dict[str, Any]],
        doc_id: str = "",
    ) -> Dict[str, Any]:
        """缁熶竴鐭ヨ瘑鍥捐氨瀛樺偍鎺ュ彛

        鏁版嵁鏍￠獙 鈫?鍐欏叆 knowledge_graph.json + chunks.db (entities/relations 琛? 鈫?杩斿洖纭銆?

        Args:
            entities: 瀹炰綋鍒楄〃 [{"name": str, "type": str, "description": str, ...}]
            relations: 鍏崇郴鍒楄〃 [{"source": str, "target": str, "relation": str, ...}]
            doc_id: 鍏宠仈鏂囨。 ID

        Returns:
            {
                "ok": True/False,
                "entities_count": int,
                "relations_count": int,
                "graph_file": str,
                "error": str (浠呭け璐ユ椂),
            }
        """
        result: Dict[str, Any] = {
            "ok": False,
            "entities_count": 0,
            "relations_count": 0,
            "graph_file": "",
        }

        # === 鏁版嵁鏍￠獙 ===
        if not entities and not relations:
            result["error"] = "entities 鍜?relations 鍧囦负绌?
            return result

        try:
            import sqlite3

            from src.config import DATA_DIR, GRAPH_PATH

            graph_file = str(GRAPH_PATH)
            result["graph_file"] = graph_file

            # 1. 鍐欏叆 knowledge_graph.json锛堝悎骞跺凡鏈夋暟鎹級
            existing_graph: Dict[str, Any] = {"nodes": {}, "edges": []}
            if os.path.exists(graph_file):
                try:
                    with open(graph_file, "r", encoding="utf-8") as f:
                        content = f.read().strip()
                        if content and content != "{}":
                            existing_graph = json.loads(content)
                except (json.JSONDecodeError, IOError):
                    logger.warning("[%s] knowledge_graph.json 璇诲彇澶辫触锛屼娇鐢ㄧ┖鍥?, self.GUA_NAME)

            # 鍚堝苟鑺傜偣
            nodes = existing_graph.get("nodes", existing_graph.get("entities", {}))
            if not isinstance(nodes, dict):
                nodes = {}

            for entity in entities:
                name = entity.get("name", "")
                if not name:
                    continue
                if name not in nodes:
                    nodes[name] = {
                        "type": entity.get("type", entity.get("entity_type", "")),
                        "description": entity.get("description", ""),
                        "aliases": entity.get("aliases", []),
                        "source_doc": doc_id,
                        "created_at": time.strftime("%Y-%m-%d %H:%M"),
                    }
                else:
                    # 鏇存柊宸叉湁鑺傜偣淇℃伅
                    existing_node = nodes[name]
                    if isinstance(existing_node, dict):
                        if entity.get("description") and not existing_node.get("description"):
                            existing_node["description"] = entity["description"]

            # 鍚堝苟杈?
            edges = list(existing_graph.get("edges", []))
            seen_edges = set()
            for edge in edges:
                key = (edge.get("from", ""), edge.get("to", ""), edge.get("relation", ""))
                seen_edges.add(key)

            for rel in relations:
                source = rel.get("source", rel.get("from", ""))
                target = rel.get("target", rel.get("to", ""))
                relation_type = rel.get("relation", rel.get("relation_type", "related_to"))
                if not source or not target:
                    continue
                key = (source, target, relation_type)
                if key not in seen_edges:
                    edges.append(
                        {
                            "from": source,
                            "to": target,
                            "relation": relation_type,
                            "description": rel.get("description", ""),
                            "source_doc": doc_id,
                        }
                    )
                    seen_edges.add(key)

            new_graph = {"nodes": nodes, "edges": edges}

            # 鍘熷瓙鍐欏叆
            tmp_path = graph_file + ".tmp"
            with open(tmp_path, "w", encoding="utf-8") as f:
                json.dump(new_graph, f, ensure_ascii=False, indent=2)
            os.replace(tmp_path, graph_file)

            # 2. 鍐欏叆 chunks.db 鐨?entities 鍜?relations 琛?
            chunks_db_path = str(DATA_DIR / "chunks.db")
            conn = sqlite3.connect(chunks_db_path, timeout=10)
            conn.execute("PRAGMA journal_mode=WAL")
            conn.execute("PRAGMA busy_timeout=5000")

            # 纭繚琛ㄥ瓨鍦?
            conn.execute("""
                CREATE TABLE IF NOT EXISTS entities (
                    entity_id TEXT PRIMARY KEY,
                    name TEXT NOT NULL,
                    entity_type TEXT DEFAULT '',
                    description TEXT DEFAULT '',
                    aliases TEXT DEFAULT '[]',
                    mentions INTEGER DEFAULT 1,
                    file_hash TEXT DEFAULT '',
                    file_name TEXT DEFAULT '',
                    created_at TEXT DEFAULT ''
                )
            """)
            conn.execute("""
                CREATE TABLE IF NOT EXISTS relations (
                    relation_id TEXT PRIMARY KEY,
                    source_type TEXT DEFAULT '',
                    source_id TEXT DEFAULT '',
                    target_type TEXT DEFAULT '',
                    target_id TEXT DEFAULT '',
                    relation_type TEXT DEFAULT '',
                    weight REAL DEFAULT 1.0,
                    created_at TEXT DEFAULT ''
                )
            """)
            conn.execute("CREATE INDEX IF NOT EXISTS idx_entities_name ON entities(name)")
            conn.execute("CREATE INDEX IF NOT EXISTS idx_entities_type ON entities(entity_type)")
            conn.commit()

            now = time.strftime("%Y-%m-%d %H:%M")

            # 鍐欏叆瀹炰綋
            for entity in entities:
                name = entity.get("name", "")
                if not name:
                    continue
                entity_id = entity.get("entity_id", f"ent_{hashlib.sha256(name.encode()).hexdigest()[:12]}")
                entity_type = entity.get("type", entity.get("entity_type", ""))
                description = entity.get("description", "")
                aliases = json.dumps(entity.get("aliases", []), ensure_ascii=False)
                conn.execute(
                    """INSERT OR REPLACE INTO entities
                       (entity_id, name, entity_type, description, aliases, file_hash, file_name, created_at)
                       VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                    (entity_id, name, entity_type, description, aliases, doc_id, entity.get("file_name", ""), now),
                )

            # 鍐欏叆鍏崇郴
            for rel in relations:
                source = rel.get("source", rel.get("from", ""))
                target = rel.get("target", rel.get("to", ""))
                if not source or not target:
                    continue
                relation_id = rel.get(
                    "relation_id", f"rel_{hashlib.sha256(f'{source}_{target}'.encode()).hexdigest()[:12]}"
                )
                relation_type = rel.get("relation", rel.get("relation_type", "related_to"))
                conn.execute(
                    """INSERT OR REPLACE INTO relations
                       (relation_id, source_type, source_id, target_type, target_id, relation_type, weight, created_at)
                       VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                    (relation_id, "entity", source, "entity", target, relation_type, rel.get("weight", 1.0), now),
                )

            conn.commit()
            conn.close()

            result["ok"] = True
            result["entities_count"] = len(entities)
            result["relations_count"] = len(relations)

            logger.info(
                "[%s] store_graph: %d 瀹炰綋, %d 鍏崇郴 鈫?%s + %s/entities,relations",
                self.GUA_NAME,
                len(entities),
                len(relations),
                graph_file,
                chunks_db_path,
            )

        except (sqlite3.Error, OSError, json.JSONDecodeError, ValueError) as e:
            logger.error("[%s] store_graph 寮傚父: %s", self.GUA_NAME, e, exc_info=True)
            result["error"] = str(e)

        return result

