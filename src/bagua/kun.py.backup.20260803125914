        Returns:
            {
                "ok": True/False,
                "doc_id": str,
                "page_id": str,
                "is_new": bool,
                "error": str (浠呭け璐ユ椂),
            }
        """
        result: Dict[str, Any] = {
            "ok": False,
            "doc_id": doc_id,
            "page_id": "",
            "is_new": False,
        }

        # === 鏁版嵁鏍￠獙 ===
        if not content or not content.strip():
