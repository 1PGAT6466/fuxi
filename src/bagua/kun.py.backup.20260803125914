    def set_preference(
        self,
        session_id: str = "default",
        key: str = "",
        value: str = "",
    ) -> None:
        """璁剧疆鐢ㄦ埛鍋忓ソ

        杩佺Щ鑷?HeartAgent._handle_user_preference 鐨勫啓鍏ヨ矾寰勩€?
        鍋忓ソ鎸?session_id 闅旂銆?

        Args:
            session_id: 浼氳瘽鏍囪瘑
            key:        鍋忓ソ閿悕
            value:      鍋忓ソ鍊?
        """
        if not key:
            logger.debug("鈽?[鍧 set_preference: key 涓虹┖锛屽拷鐣?)
            return

        if session_id not in self._preferences:
            self._preferences[session_id] = {}

        self._preferences[session_id][key] = value
        logger.debug(
            "鈽?[鍧 Session %s 鍋忓ソ璁剧疆: %s = %s",
            session_id,
            key,
            str(value)[:60],
        )

    def get_preference(
        self,
        session_id: str = "default",
        key: str = "",
    ) -> Optional[str]:
        """璇诲彇鐢ㄦ埛鍋忓ソ

        杩佺Щ鑷?HeartAgent._handle_user_preference 鐨勮鍙栬矾寰勩€?

        Args:
            session_id: 浼氳瘽鏍囪瘑
            key:        鍋忓ソ閿悕

        Returns:
            鍋忓ソ鍊硷紙瀛楃涓诧級锛屾湭鎵惧埌鏃惰繑鍥?None
        """
        if not key:
            return None

        session_prefs = self._preferences.get(session_id, {})
        value = session_prefs.get(key, None)
