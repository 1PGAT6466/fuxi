    def push_to_wiki(
        self,
        doc_id: str = "",
        content: str = "",
        category: str = "",
        tags: Optional[List[str]] = None,
    ) -> Dict[str, Any]:
        """瀛樺偍 Wiki 椤甸潰

        鍔熻兘瀵归綈鑴剧殑 _handle_nutrition锛?
          - 璁＄畻 content 鐨?hash 鐢ㄤ簬鍘婚噸
          - 鐩稿悓鍐呭鐨勯〉闈笉閲嶅瀛樺偍
          - 鑷姩鏇存柊鍏抽敭璇嶅€掓帓绱㈠紩
          - 閫掑 _stored_total

        Args:
            doc_id: 椤甸潰 ID锛屼负绌烘椂鑷姩鐢熸垚锛圡D5 鍓?16 浣嶏級
            content: 椤甸潰鍐呭
            category: 鍒嗙被鏍囩锛堜负绌烘椂鑷姩鍒嗙被锛?
            tags:   鏍囩鍒楄〃

        Returns:
            {"ok": True/False, "doc_id": str, "is_new": bool,
             "stored_total": int, "error": str (浠呭け璐ユ椂)}
        """
        if not content:
            return {"ok": False, "doc_id": "", "is_new": False, "error": "content 涓虹┖"}

        try:
            # 鐢熸垚/纭 doc_id
            if not doc_id:
                doc_id = hashlib.sha256(content.encode("utf-8")).hexdigest()[:16]

            content_hash = hashlib.sha256(content.encode("utf-8")).hexdigest()

            # 鍘婚噸锛氬悓 content hash 鐨勯〉闈笉閲嶅瀛樺偍
            existing_doc_id = self._content_hash_index.get(content_hash)
            is_new = existing_doc_id is None

            if is_new:
                self._stored_total += 1
            else:
                # 鍐呭瀹屽叏鐩稿悓锛屾洿鏂板厓鏁版嵁
                if existing_doc_id in self._wiki_store:
                    self._wiki_store[existing_doc_id]["accessed_at"] = time.time()
                    self._wiki_store[existing_doc_id]["access_count"] = (
                        self._wiki_store[existing_doc_id].get("access_count", 0) + 1
                    )
                    logger.debug(
                        "[%s] Wiki 椤甸潰宸插瓨鍦紝鏇存柊璁块棶: %s",
                        self.GUA_NAME,
                        existing_doc_id,
                    )
                    return {
                        "ok": True,
                        "doc_id": existing_doc_id,
                        "is_new": False,
                        "stored_total": self._stored_total,
                    }

            # 瀛樺偍椤甸潰
            doc = {
                "doc_id": doc_id,
                "content": content,
                "content_hash": content_hash,
                "content_len": len(content),
                "category": category or self._classify_content(content),
                "tags": tags or [],
                "created_at": time.time(),
                "accessed_at": time.time(),
                "access_count": 0,
            }
            self._wiki_store[doc_id] = doc
            self._content_hash_index[content_hash] = doc_id

            # 鏇存柊鍏抽敭璇嶅€掓帓绱㈠紩
            self._index_keywords(doc_id, content)

            # 璁板綍鏂矾鍣ㄦ垚鍔?
            wiki_cb = self._circuits.get("wiki_engine")
            if wiki_cb:
                wiki_cb.record_success()

            # v1.50 Phase B: 鑷姩寤哄浘 鈥?闆?LLM 鎶藉彇瀹炰綋+杈?
            auto_graph_result = self._try_auto_graph(content, doc_id)

            logger.info(
                "[%s] Wiki 椤甸潰宸插瓨鍌? %s (len=%d, cat=%s) | auto_graph=%s",
                self.GUA_NAME,
                doc_id,
                len(content),
                doc["category"],
                "ok" if auto_graph_result and auto_graph_result.get("ok") else "skip",
            )
            return {
                "ok": True,
                "doc_id": doc_id,
                "is_new": True,
                "stored_total": self._stored_total,
                "auto_graph": auto_graph_result,
            }

        except (hashlib.Error, ValueError, KeyError, OSError) as e:
            logger.error(
                "[%s] push_to_wiki 澶辫触: %s",
                self.GUA_NAME,
                e,
                exc_info=True,
            )
            wiki_cb = self._circuits.get("wiki_engine")
            if wiki_cb:
                wiki_cb.record_failure()
            return {"ok": False, "doc_id": "", "is_new": False, "error": str(e)}

    def recall_wiki(self, query: str = "", top_k: int = 5) -> List[Dict[str, Any]]:
        """妫€绱?Wiki 鍐呭

        鍔熻兘瀵归綈鑴剧殑 _search_wiki / _handle_pump锛?
          1. 灏濊瘯鍚戦噺鎼滅储锛堝鏋滃閮ㄥ祵鍏ユ湇鍔″彲鐢級
          2. Fallback: 鍏抽敭璇嶅€掓帓绱㈠紩鎼滅储
          3. 缁撴灉鎸夊尮閰嶅垎鏁版帓搴?

        Args:
            query: 妫€绱㈡煡璇㈣瘝
            top_k: 杩斿洖缁撴灉鏁帮紙榛樿 5锛?

        Returns:
            缁撴灉鍒楄〃锛屾瘡椤瑰寘鍚?{doc_id, content, preview, score, category, tags, ...}
        """
        if not query or not self._wiki_store:
            return []

        try:
            # 鍏抽敭璇嶆绱?
            results = self._keyword_search(query, top_k)

            # 鏇存柊璁块棶璁℃暟
            for r in results:
                doc_id = r.get("doc_id", "")
                if doc_id in self._wiki_store:
                    self._wiki_store[doc_id]["accessed_at"] = time.time()
                    self._wiki_store[doc_id]["access_count"] = self._wiki_store[doc_id].get("access_count", 0) + 1

            # 璁板綍鏂矾鍣ㄦ垚鍔?
            wiki_cb = self._circuits.get("wiki_engine")
            if wiki_cb:
                wiki_cb.record_success()

            return results

        except (ValueError, KeyError, re.error) as e:
            logger.error(
                "[%s] recall_wiki 澶辫触: %s",
                self.GUA_NAME,
                e,
                exc_info=True,
            )
            wiki_cb = self._circuits.get("wiki_engine")
            if wiki_cb:
                wiki_cb.record_failure()
            return []

