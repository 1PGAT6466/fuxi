                (page_id, title, category, tags_json, summary, content, sources_json, 1, 0.7, author, now, now),
            )
            conn.commit()
            conn.close()

            result["ok"] = True
            result["page_id"] = page_id
            result["is_new"] = is_new

            # 鍚屾椂鏇存柊鍐呭瓨缂撳瓨
            self.push_to_wiki(doc_id=doc_id, content=content, category=category, tags=tags)

