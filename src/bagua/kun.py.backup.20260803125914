                            # 灏濊瘯鐢ㄥ悓姝ユ柟寮?
                            import json as _json

                            from src.services.llm import call_llm

                            # 瀹炰綋鎻愬彇
                            entity_prompt = f"""浠庝互涓嬫枃妗ｄ腑鎶藉彇瀹炰綋銆傚彧杈撳嚭 JSON 鏁扮粍銆?
瀹炰綋绫诲瀷锛歱erson / organization / product / material / device / concept / location

鏂囨。锛歿file_name}
鍐呭锛歿combined_text[:3000]}

杈撳嚭锛歔{{"name":"瀹炰綋鍚?,"type":"绫诲瀷","description":"涓€鍙ヨ瘽鎻忚堪"}}]"""

                            entity_raw = (
                                loop.run_until_complete(call_llm(entity_prompt, max_tokens=2000))
                                if not loop.is_running()
