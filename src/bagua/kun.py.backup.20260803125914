    @staticmethod
    def _classify_content(text: str) -> str:
        """绠€鍗曞唴瀹瑰垎绫?

        瀵归綈鑴剧殑 _classify_text 鏂规硶銆?

        Args:
            text: 鏂囨湰鍐呭

        Returns:
            鍒嗙被鏍囩
        """
        t = text.lower()
        if any(kw in t for kw in ["api", "鎺ュ彛", "閮ㄧ讲", "杩愮淮", "鏈嶅姟鍣?, "docker", "kubernetes"]):
            return "鎶€鏈枃妗?
        if any(kw in t for kw in ["璐㈡姤", "璐㈠姟", "鏀跺叆", "鍒╂鼎", "鎴愭湰"]):
            return "璐㈠姟"
        if any(kw in t for kw in ["浜у搧", "闇€姹?, "璁捐", "涓婄嚎"]):
            return "浜у搧"
        if any(kw in t for kw in ["浼氳", "鍛ㄦ姤", "鏃ユ姤", "璁″垝"]):
            return "鍔炲叕"
        return "閫氱敤鍔炲叕"

    def _index_keywords(self, doc_id: str, content: str) -> None:
        """涓洪〉闈㈡瀯寤虹畝鍗曞叧閿瘝鍊掓帓绱㈠紩

        Args:
            doc_id: 椤甸潰 ID
            content: 椤甸潰鍐呭
        """
        # 绠€鍗曞垎璇嶏細涓枃 鈮? 瀛?鎴?鑻辨枃 鈮? 瀛楁瘝
        tokens = re.findall(r"[\u4e00-\u9fff]{2,}|[a-zA-Z]{2,}", content.lower())
        seen: set = set()
        for token in tokens:
            if token not in seen:
                seen.add(token)
                if token not in self._keyword_index:
                    self._keyword_index[token] = []
                self._keyword_index[token].append(doc_id)

    def _keyword_search(self, query: str, top_k: int = 5) -> List[Dict[str, Any]]:
        """鍏抽敭璇嶆悳绱?

        瀵?query 鍒嗚瘝鍚庯紝鎸夊叧閿瘝鍖归厤 doc 鏁拌鍒嗐€?

        Args:
            query: 妫€绱㈡煡璇?
            top_k: 杩斿洖缁撴灉鏁?

        Returns:
            缁撴灉鍒楄〃
        """
        query_tokens = re.findall(r"[\u4e00-\u9fff]{2,}|[a-zA-Z]{2,}", query.lower())

        if not query_tokens:
            return []

        # 璁＄畻姣忎釜 doc 鐨勫垎鏁?
        scores: Dict[str, float] = {}
        for token in query_tokens:
            matched_docs = self._keyword_index.get(token, [])
            for doc_id in matched_docs:
                scores[doc_id] = scores.get(doc_id, 0) + 1

        # 鎸夊垎鏁版帓搴?
        sorted_docs = sorted(scores.items(), key=lambda x: x[1], reverse=True)
        top_docs = sorted_docs[:top_k]

        results: List[Dict[str, Any]] = []
        for doc_id, score in top_docs:
            doc = self._wiki_store.get(doc_id)
            if doc:
                preview = doc["content"][:500]
                results.append(
                    {
                        "doc_id": doc_id,
                        "content": doc["content"],
                        "preview": preview,
                        "score": score,
                        "category": doc.get("category", ""),
                        "tags": doc.get("tags", []),
                        "content_len": doc.get("content_len", 0),
                        "created_at": doc.get("created_at", 0),
                    }
                )

        return results

