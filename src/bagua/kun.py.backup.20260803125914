    def build_knowledge_graph(self, doc_id: str = "") -> Dict[str, Any]:
        """浠庢枃妗ｈ嚜鍔ㄦ瀯寤虹煡璇嗗浘璋?

        浠?chunks.db 涓寜 doc_id 妫€绱㈣鏂囨。鐨勬墍鏈?chunk锛?
        璋冪敤 SAG 鎻愬彇鍣ㄨ幏鍙栧疄浣撳拰鍏崇郴锛?
        鐒跺悗鍐欏叆 knowledge_graph.json 鍜?entities/relations 琛ㄣ€?

        瀹炵幇鏂规瑕佹眰鐨?鍧ゅ崷璐熻矗鐭ヨ瘑鍥捐氨鑷姩鏋勫缓"銆?

        Args:
            doc_id: 鏂囨。 file_hash 鎴栨爣璇嗙

        Returns:
            {
                "ok": True/False,
                "doc_id": str,
                "chunks_processed": int,
                "entities_extracted": int,
                "relations_extracted": int,
                "graph_stored": bool,
                "error": str (浠呭け璐ユ椂),
            }
        """
        result: Dict[str, Any] = {
            "ok": False,
            "doc_id": doc_id,
            "chunks_processed": 0,
            "entities_extracted": 0,
            "relations_extracted": 0,
            "graph_stored": False,
        }

        if not doc_id:
            # 鏃?doc_id 鏃讹紝灏濊瘯浠?wiki_store 鑾峰彇鍐呭
            result["error"] = "doc_id 涓虹┖锛屾棤娉曟绱?chunk 鏁版嵁"
            return result

        try:
            # === 姝ラ 1: 浠?chunks.db 璇诲彇鏂囨。鐨勬墍鏈?chunk ===
            from src.db.memory_store import get_store

            store = get_store()

            # 鎸?file_hash 鎴栨ā绯婂尮閰嶆绱?
            chunks = store.get_by_hash(doc_id)

            # 濡傛灉绮剧‘鍖归厤澶辫触锛屽皾璇曠煭 hash 鍓嶇紑鍖归厤锛堝吋瀹?16 浣嶇煭 hash锛?
            if not chunks:
                short = doc_id[:16] if len(doc_id) > 16 else doc_id
                chunks = store.get_by_hash(short)

            # 鏈€鍚庡皾璇曟ā绯婏細閫氳繃鎵€鏈?chunk 鐨?file_hash 鍋?LIKE 鎼滅储
            if not chunks:
                try:
                    raw_rows = store._db_conn.execute(
                        "SELECT id, doc FROM chunks WHERE file_hash LIKE ? AND status='active' LIMIT 100",
                        (doc_id[:8] + "%",),
                    ).fetchall()
                    if raw_rows:
                        import json as _json

                        chunks = []
                        for row_id, doc_json in raw_rows:
                            c = _json.loads(doc_json) if isinstance(doc_json, str) else doc_json
                            c["_db_id"] = row_id
                            chunks.append(c)
                except (json.JSONDecodeError, KeyError, ValueError):
                    pass

            if not chunks:
                logger.warning(
                    "[%s] build_knowledge_graph: 鏈壘鍒?doc_id=%s 鐨?chunk 鏁版嵁",
                    self.GUA_NAME,
                    doc_id,
                )
                result["error"] = f"鏈壘鍒?doc_id={doc_id} 鐨?chunk 鏁版嵁"
                return result

            result["chunks_processed"] = len(chunks)

            # === 姝ラ 2: 璋冪敤 SAG 鎻愬彇鍣ㄨ幏鍙栧疄浣撳拰鍏崇郴 ===
            all_entities: List[Dict[str, Any]] = []
            all_relations: List[Dict[str, Any]] = []

            try:
                # E-1 (Round 2 瀹¤): 鍏崷灞傚欢杩熷鍏ュ洓璞℃ā鍧楋紙shaoyang/kg_extractor锛夈€?
                # 椋庨櫓宸茶瘎浼帮細姝?import 浠呭湪 build_knowledge_graph() 鏂规硶浣撳唴銆乼ry/except 涓欢杩熸墽琛岋紝
                # 涓嶉樆濉炴ā鍧楀姞杞斤紝涓嶆瀯鎴愬惎鍔ㄦ椂寰幆渚濊禆銆俿haoyang 涓嶅弽鍚戝鍏?bagua锛屼緷璧栧浘涓?DAG銆?
                # 闀挎湡鏂瑰悜 (Phase 3)锛氬皢瀹炰綋鎻愬彇鑳藉姏涓嬬Щ鑷?src/infra/ 鍏变韩灞傘€?
                import asyncio

                # 鍚堝苟鎵€鏈?chunk 鏂囨湰锛堟渶澶?10000 瀛楃锛?
                combined_text = ""
                for c in chunks:
                    text = c.get("text", "")
                    if len(combined_text) + len(text) > 10000:
                        combined_text += text[: 10000 - len(combined_text)]
                        break
                    combined_text += text + "\n\n"

                if combined_text.strip():
