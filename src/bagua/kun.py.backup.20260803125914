    def store_vector(
        self,
        doc_id: str,
        chunks: List[Any],
        metadata: Optional[Dict[str, Any]] = None,
    ) -> Dict[str, Any]:
        """缁熶竴鍚戦噺瀛樺偍鎺ュ彛

        鏁版嵁鏍￠獙 鈫?鍐欏叆 ChromaDB 鈫?杩斿洖纭銆?
        灏嗗甫鏈?embedding 鐨?chunk 鍐欏叆 ChromaDB 鍚戦噺鏁版嵁搴撱€?

        Args:
            doc_id: 鏂囨。鍞竴鏍囪瘑
            chunks: Chunk 瀵硅薄鍒楄〃锛堝繀椤诲寘鍚?embedding 灞炴€э級
            metadata: 闄勫姞鍏冩暟鎹?

        Returns:
            {
                "ok": True/False,
                "doc_id": str,
                "vectors_stored": int,
                "collection": str,
                "error": str (浠呭け璐ユ椂),
            }
        """
        result: Dict[str, Any] = {
            "ok": False,
            "doc_id": doc_id,
            "vectors_stored": 0,
            "collection": "kb_chunks",
        }

        # === 鏁版嵁鏍￠獙 ===
        if not doc_id:
            result["error"] = "doc_id 涓虹┖"
            return result

        if not chunks:
            result["error"] = "chunks 涓虹┖"
            return result

        # 绛涢€夋湁 embedding 鐨?chunk
        vectorized = []
        for c in chunks:
            emb = getattr(c, "embedding", None)
            if emb is not None:
                vectorized.append(c)

        if not vectorized:
            result["ok"] = True
            result["vectors_stored"] = 0
            result["message"] = "鏃犲悜閲忓寲鏁版嵁锛岃烦杩?
            return result

        meta = metadata or {}

        try:
            from src.db.vector_store import get_vector_store

            vs = get_vector_store()
            if vs is None:
                result["error"] = "VectorStore 涓嶅彲鐢?
                return result

            ids = []
            embeddings = []
            metadatas = []
            documents = []

            for i, c in enumerate(vectorized):
                chunk_id = f"{doc_id}_{i}"
                ids.append(chunk_id)
                embeddings.append(c.embedding)
                doc_text = getattr(c, "text", "")
                documents.append(doc_text)
                m = {
                    "doc_id": doc_id,
                    "chunk_index": str(getattr(c, "chunk_index", i)),
                    "file_name": str(getattr(c, "file_name", "")),
                    "category": str(getattr(c, "category", "")),
                    "source_file": str(getattr(c, "source_file", "")),
                }
                m.update({k: str(v)[:512] for k, v in meta.items()})
                metadatas.append(m)

            success = vs.add(
                ids=ids,
                embeddings=embeddings,
                metadata=metadatas,
                documents=documents,
            )

            if success:
                result["ok"] = True
                result["vectors_stored"] = len(ids)
                logger.info(
                    "[%s] store_vector: %d 鏉″悜閲忓啓鍏?ChromaDB (doc_id=%s)",
                    self.GUA_NAME,
                    len(ids),
                    doc_id,
                )
            else:
                result["error"] = "ChromaDB 鍐欏叆澶辫触"

