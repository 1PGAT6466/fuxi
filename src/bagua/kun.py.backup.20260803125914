                self.GUA_NAME,
                e,
                exc_info=True,
            )
            result["error"] = str(e)

        return result

    def _rule_based_kg_extraction(
        self,
        chunks: List[Dict[str, Any]],
    ) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
        """鍩轰簬瑙勫垯鐨勫叧閿瘝瀹炰綋/鍏崇郴鎻愬彇锛圠LM 涓嶅彲鐢ㄦ椂鐨?fallback锛?

        浣跨敤姝ｅ垯鍖归厤鍜屽叡鐜板垎鏋愪粠 chunk 鏂囨湰涓彁鍙栧疄浣撳拰鍏崇郴銆?

        Args:
            chunks: chunk 瀛楀吀鍒楄〃

        Returns:
            (entities, relations) 鍏冪粍
        """
        entities: List[Dict[str, Any]] = []
        relations: List[Dict[str, Any]] = []
        entity_set: Dict[str, Dict[str, Any]] = {}

        # 瀹氫箟甯歌瀹炰綋妯″紡
        patterns = [
            # 涓枃缁勭粐鏈烘瀯
            (r"(?:鍏徃|闆嗗洟|浼佷笟|宸ュ巶|鐮旂┒闄瀹為獙瀹閮ㄩ棬|鍥㈤槦|濮斿憳浼?", "organization"),
            # 鎶€鏈?浜у搧鏈
            (r"(?:绯荤粺|骞冲彴|妗嗘灦|寮曟搸|绠楁硶|妯″瀷|鍗忚|鎺ュ彛|缁勪欢|妯″潡|鏈嶅姟)", "concept"),
            # 鏉愭枡
            (r"(?:PA\d{2}|PC|ABS|PP|PE|PVC|POM|PMMA|PBT|PET|TPE|TPU|涓嶉攬閽閾濆悎閲憒閽涘悎閲憒纰崇氦缁?", "material"),
            # 璁惧
            (r"(?:娉ㄥ鏈簗鎸ゅ嚭鏈簗CNC|鍔犲伐涓績|閾ｅ簥|杞﹀簥|纾ㄥ簥|妫€娴嬩华|浼犳劅鍣▅鎺у埗鍣▅PLC)", "device"),
            # 浜哄憳
            (r"(?:宸ョ▼甯坾璁捐甯坾缁忕悊|鎬荤洃|涓讳换|鎿嶄綔鍛榺鎶€鏈憳)", "person"),
        ]

        all_text = ""
        for c in chunks:
            text = c.get("text", "")
            if text:
                all_text += text + "\n"

        # 绠€鍗曞疄浣撹瘑鍒?
        for pattern, entity_type in patterns:
            matches = re.findall(pattern, all_text)
            for match in matches:
                name = match.strip()
                if name and name not in entity_set:
                    entity_set[name] = {
                        "name": name,
                        "type": entity_type,
                        "description": f"浠庢枃妗ｄ腑鎻愬彇鐨剓entity_type}",
                    }

        entities = list(entity_set.values())

        # 鍩轰簬鍏辩幇鐨勫叧绯绘彁鍙?
        if len(entities) >= 2:
            entity_names = list(entity_set.keys())
            for i in range(min(len(entity_names), 20)):
                for j in range(i + 1, min(len(entity_names), 20)):
                    name_a = entity_names[i]
                    name_b = entity_names[j]
                    # 妫€鏌ユ槸鍚﹀湪鍚屼竴鍙ュ瓙涓叡鐜?
                    for sentence in re.split(r"[銆傦紱.!?\n]", all_text):
                        if name_a in sentence and name_b in sentence:
                            relations.append(
                                {
                                    "source": name_a,
                                    "target": name_b,
                                    "relation": "related_to",
                                    "description": f"{name_a} 涓?{name_b} 鍦ㄥ悓涓€涓婁笅鏂囦腑鎻愬強",
                                }
                            )
                            break

        logger.info(
            "[%s] 瑙勫垯鎻愬彇: %d 瀹炰綋, %d 鍏崇郴",
            self.GUA_NAME,
            len(entities),
            len(relations),
        )

        return entities, relations

