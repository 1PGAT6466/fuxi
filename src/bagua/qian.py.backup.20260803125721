        logger.warning("鈽?[涔綸 淇濆瓨鎰忓浘棰勫姞杞界紦瀛樺け璐? %s", exc)


def _match_intent_preload(query: str, cache: Dict[str, str]) -> Optional[str]:
    """鏌ヨ棰勫姞杞界紦瀛橈紝鍖归厤鎰忓浘

    鍖归厤瑙勫垯锛?
      1. 绮剧‘鍖归厤锛坬uery 瀹屽叏鐩稿悓锛?
      2. 鍓嶇紑閫氶厤鍖归厤锛堟ā寮?"鎼?" 鍖归厤 "鎼? 寮€澶寸殑 query锛?
      3. 鍖呭惈鍖归厤锛坬uery 鍖呭惈妯″紡鍏抽敭璇嶏紝闈為€氶厤妯″紡锛?

    Args:
        query: 鐢ㄦ埛鏌ヨ鏂囨湰锛堝凡鍋?strip锛?
        cache: 棰勫姞杞界紦瀛樺瓧鍏?

    Returns:
        鍖归厤鐨勬剰鍥撅紝鎴?None锛堟湭鍛戒腑锛?
    """
    if not query:
        return None

    # 绮剧‘鍖归厤
    if query in cache:
        return cache[query]

    # 鍓嶇紑閫氶厤鍖归厤
    for pattern, intent in cache.items():
        if pattern.endswith("*") and query.startswith(pattern[:-1]):
            return intent

    # 鍖呭惈鍖归厤锛堢煭 query 涓旀棤閫氶厤绗︾殑妯″紡锛?
    for pattern, intent in cache.items():
        if "*" not in pattern and len(pattern) <= len(query) and pattern in query:
            return intent

    return None


