    def _build_runtime_state(
        self,
        round_num: int,
        session: Optional[QianSession] = None,
    ) -> str:
        """鏋勫缓杩愯鏃剁姸鎬佹憳瑕侊紝娉ㄥ叆鍒扮郴缁?Prompt

        鍖呮嫭锛?
          - 褰撳墠杞暟 / 鏈€澶ц疆鏁?
          - 鍚勫崷鐨?health_level 涓庢柇璺櫒鐘舵€?
          - 宸叉嫤鎴鏁?
          - 绯荤粺寤鸿

        Args:
            round_num: 褰撳墠杞暟
            session:   褰撳墠浼氳瘽锛堢敤浜庤幏鍙栨嫤鎴鏁扮瓑锛?

        Returns:
            Markdown 鏍煎紡鐨勮繍琛屾椂鐘舵€佸瓧绗︿覆
        """
        lines: List[str] = []
        lines.append("\n## 褰撳墠绯荤粺鐘舵€?)
        lines.append(f"- 杞: {round_num}/{self.MAX_ROUNDS}")

        # 鍚勫崷鐨勫仴搴蜂笌鏂矾鍣ㄧ姸鎬?
        lines.append("- 鍙敤鍗︾姸鎬?")

        # 鎰忓浘鈫掑崷鍚嶁啋涓枃鎻忚堪鐨勬煡璇㈣〃
        intent_to_pairs: List[Tuple[str, str, str]] = [
            ("SEARCH", "宸?, "鎼滅储"),
            ("SEARCH_X", "鍧?, "澶栭儴鎼滅储"),
            ("REFINE", "鍧?, "绮剧偧"),
            ("DECIDE", "涔?, "鍐崇瓥"),
            ("FUSION", "绂?, "铻嶅悎"),
            ("UPLOAD", "闇?, "娑堝寲鍚姩"),
            ("GUARD", "鑹?, "瀹夊叏"),
            ("PRESENT", "鍏?, "杈撳嚭"),
        ]

        for intent, gua_name, gua_label in intent_to_pairs:
            health_str = self._get_gua_health_summary(gua_name)
            circuit_status = self._get_gua_circuit_status(intent)
            cb_tag = "OPEN(鏂矾)" if circuit_status == "open" else "CLOSED"
            lines.append(f"  - {gua_name}({gua_label}/{intent}): {health_str}, 鏂矾鍣? {cb_tag}")

        # 宸叉嫤鎴鏁?
        if session is not None:
            guard_count = session.cycle_state.guard_intervention_count
            lines.append(f"- 宸叉嫤鎴鏁? {guard_count}")
            if guard_count > 0:
                lines.append(f"- 绯荤粺寤鸿: CycleGuard 宸叉嫤鎴?{guard_count} 娆★紝" f"璇烽伩鍏嶉噸澶嶅悓鏍烽敊璇?)

        return "\n".join(lines)

    def _get_gua_health_summary(self, gua_name: str) -> str:
        """鑾峰彇鏌愪釜鍗︾殑鍋ュ悍鎽樿瀛楃涓?

        Args:
            gua_name: 鍗﹀悕锛堜腑鏂囷級

        Returns:
            "FULL" | "DEGRADED" | "MINIMAL" | "OFF" | "UNKNOWN"
        """
        try:
            registered = self._intent_bus.get_registered_guas() if self._intent_bus else []
            if gua_name in registered:
                return "FULL"
            return "UNREGISTERED"
        except (ImportError, ModuleNotFoundError, ValueError, KeyError, AttributeError):
            return "UNKNOWN"

    def _get_gua_circuit_status(self, intent: str) -> str:
        """鑾峰彇鏌愪釜鎰忓浘瀵瑰簲鐩爣鍗︾殑鏂矾鍣ㄧ姸鎬?

        Args:
            intent: 鎰忓浘鍚嶇О

        Returns:
            "open" | "closed" | "unknown"
        """
        target_gua = INTENT_TO_TARGET_GUA.get(intent)
        if not target_gua:
            return "unknown"
        try:
            dep = self.get_dependency(target_gua)
            if dep is not None:
                return "open" if dep.circuit_state == CircuitState.OPEN else "closed"
            return "closed"  # 鏈敞鍐屾柇璺櫒鍗宠涓烘甯?
        except (ImportError, ModuleNotFoundError, ValueError, KeyError, AttributeError):
            return "unknown"

    # ========================================================================
    # 鍐呴儴鏂规硶 鈥?Level 0 鍥哄畾瑙勫垯鍐崇瓥锛堜笉璋?LLM锛?
    # ========================================================================

    def _decide_fixed_rule(
        self,
        round_num: int,
        context: str = "",
        suggestion: Optional[str] = None,
    ) -> Dict[str, Any]:
        """Level 0 鍥哄畾瑙勫垯鍐崇瓥 鈥?瀹屽叏鍩轰簬瑙勫垯锛屼笉璋?LLM

        鎸?FIXED_RULE_SEQUENCE 椤哄簭渚濇杈撳嚭鎰忓浘锛?
        搴忓垪鎵ц瀹屾瘯鍚庤緭鍑?DONE銆?

        FIXED_RULE_SEQUENCE = ["SEARCH", "REFINE", "DECIDE", "PRESENT", "DONE"]

        瀵规瘡涓楠わ細
          - SEARCH:     confidence=0.95, reasoning="鍥哄畾瑙勫垯-妫€绱㈢煡璇嗗簱"
          - REFINE:     confidence=0.92, reasoning="鍥哄畾瑙勫垯-绮剧偧鎺掑簭"
          - DECIDE:     confidence=0.90, reasoning="鍥哄畾瑙勫垯-缁煎悎鍒ゆ柇"
          - PRESENT:    confidence=0.88, reasoning="鍥哄畾瑙勫垯-杈撳嚭绛旀"
          - DONE:       confidence=0.95, reasoning="鍥哄畾瑙勫垯-娴佺▼缁撴潫"

        Args:
            round_num:  褰撳墠杞暟锛?-based锛?
            context:    绱Н涓婁笅鏂囷紙鍙傝€冪敤锛?
            suggestion: SafetyCruise 寤鸿锛堝弬鑰冪敤锛?

        Returns:
            {"intent": "...", "confidence": ..., "reasoning": "..."}
        """
        # 灏嗚疆鏁版槧灏勫埌鍥哄畾搴忓垪绱㈠紩锛?-based锛?
        seq_index = round_num - 1
        seq_len = len(self.FIXED_RULE_SEQUENCE)

        # 濡傛灉杞暟瓒呰繃搴忓垪闀垮害 鈫?DONE
        if seq_index >= seq_len:
            return {
                "intent": "DONE",
                "confidence": 1.0,
                "reasoning": "鍥哄畾瑙勫垯-鍏ㄩ儴姝ラ瀹屾垚",
            }

        intent = self.FIXED_RULE_SEQUENCE[seq_index]

        # 姣忎釜鎰忓浘鐨勬弿杩颁笌缃俊搴?
        step_map: Dict[str, Tuple[float, str]] = {
            "SEARCH": (0.95, "鍥哄畾瑙勫垯-妫€绱㈢煡璇嗗簱"),
            "REFINE": (0.92, "鍥哄畾瑙勫垯-绮剧偧鎺掑簭"),
            "DECIDE": (0.90, "鍥哄畾瑙勫垯-缁煎悎鍒ゆ柇"),
            "PRESENT": (0.88, "鍥哄畾瑙勫垯-杈撳嚭绛旀"),
            "DONE": (0.95, "鍥哄畾瑙勫垯-娴佺▼缁撴潫"),
        }

        confidence, reasoning = step_map.get(intent, (0.85, f"鍥哄畾瑙勫垯-{intent}"))

        logger.info(
            "鈽?[涔綸 _decide_fixed_rule R%d: intent=%s conf=%.2f",
            round_num,
            intent,
            confidence,
        )

        return {
            "intent": intent,
            "confidence": confidence,
            "reasoning": reasoning,
        }

    def _parse_decide_output(self, raw: str, round_num: int) -> Dict[str, Any]:
        """瑙ｆ瀽 LLM 鍐崇瓥杈撳嚭涓烘爣鍑嗗寲 dict

        Args:
            raw:       LLM 鍘熷杈撳嚭
            round_num: 褰撳墠杞暟

        Returns:
            {"intent": "...", "confidence": ..., "reasoning": "..."}
        """
        # 娓呯悊 markdown 浠ｇ爜鍧?
        cleaned = raw.strip()
        cleaned = re.sub(r"^```(?:json)?\s*", "", cleaned)
        cleaned = re.sub(r"\s*```$", "", cleaned)

        try:
            parsed = json.loads(cleaned)
        except json.JSONDecodeError:
            # 灏濊瘯鎻愬彇 JSON 瀛愪覆
            json_match = re.search(r'\{[^{}]*"intent"[^{}]*\}', cleaned)
            if json_match:
                try:
                    parsed = json.loads(json_match.group(0))
                except json.JSONDecodeError:
                    return self._decide_fallback(round_num)
            else:
                return self._decide_fallback(round_num)

        intent = parsed.get("intent", "DONE")
        confidence = float(parsed.get("confidence", 0.5))
        reasoning = str(parsed.get("reasoning", ""))[:40]

        # 楠岃瘉鎰忓浘鏈夋晥鎬?
        if intent not in AVAILABLE_TRIGRAMS:
            logger.warning("鈽?[涔綸 鏃犳晥鎰忓浘 '%s'锛屼娇鐢ㄥ厹搴?, intent)
            return self._decide_fallback(round_num)

        return {
            "intent": intent,
            "confidence": min(max(confidence, 0.0), 1.0),
            "reasoning": reasoning,
        }

    def _decide_fallback(self, round_num: int) -> Dict[str, Any]:
        """鍐崇瓥鍏滃簳閫昏緫 鈥?鏍规嵁褰撳墠杞暟杩斿洖鍚堢悊榛樿鎰忓浘

        Args:
            round_num: 褰撳墠杞暟锛?-based锛?

        Returns:
            鍏滃簳鎰忓浘 dict
        """
        if round_num == 1:
            return {"intent": "SEARCH", "confidence": 0.6, "reasoning": "棣栬疆鍏滃簳妫€绱?}
        elif round_num >= self.MAX_ROUNDS - 1:
            return {"intent": "DONE", "confidence": 0.7, "reasoning": "鏈€缁堣疆鍏滃簳缁撴潫"}
        else:
            return {"intent": "PRESENT", "confidence": 0.5, "reasoning": "鍏滃簳灏濊瘯杈撳嚭"}

    # ========================================================================
    # 鍐呴儴鏂规硶 鈥?褰卞瓙妯″紡瀵规瘮
    # ========================================================================

    async def _shadow_compare(
        self,
        query: str,
        history: List[Dict[str, str]],
        context: str,
        round_num: int,
        suggestion: Optional[str],
        session: Optional[QianSession],
        kun_history_summary: str,
        rule_decision: Dict[str, Any],
    ) -> None:
        """褰卞瓙妯″紡锛歀LM 浜х敓鎰忓浘 鈫?璁板綍宸紓 鈫?瀹為檯鎵ц鐢ㄥ浐瀹氳鍒?

        鏃ュ織璁板綍 LLM 鍐崇瓥 vs 鍥哄畾瑙勫垯宸紓鍒?data/shadow_decisions.jsonl銆?
        杩欐槸娓愯繘閲婃斁绛栫暐鐨勬牳蹇冿細鍏堢湅 LLM 鎯冲仛浠€涔堬紝鍐嶉€愭鏀炬潈銆?

        Args:
            query:                鐢ㄦ埛鎻愰棶
            history:              瀵硅瘽鍘嗗彶
            context:              绱Н涓婁笅鏂?
            round_num:            褰撳墠杞暟
            suggestion:           SafetyCruise 寤鸿
            session:              褰撳墠浼氳瘽
            kun_history_summary:  鍧ゅ崷鍘嗗彶
            rule_decision:        鍥哄畾瑙勫垯鍐崇瓥缁撴灉
        """
        try:
            # 璧?LLM 鍐崇瓥璺緞锛堜笉闃诲涓绘祦绋嬶級
            runtime_state = self._build_runtime_state(round_num, session)
            filled_prompt = _QIAN_SYSTEM_PROMPT.replace("{runtime_state}", runtime_state)

            parts: List[str] = [f"## 鐢ㄦ埛鍘熷鎻愰棶\n{query}\n"]
            if context and context != "锛堝皻鏃犱笂涓嬫枃淇℃伅锛?:
                parts.append(f"## 宸茶幏鍙栫殑淇℃伅\n{context}\n")
            parts.append(f"## 褰撳墠鐘舵€乗n绗?{round_num}/{self.MAX_ROUNDS} 杞甛n")
            if suggestion:
                parts.append(f"## 鎻愮ず\n{suggestion}\n")
            parts.append("璇疯緭鍑轰笅涓€姝ュ喅绛栵紙浠?JSON锛夛細")
            user_message = "\n".join(parts)

            llm_raw = await self._call_llm_with_retry(
                system_prompt=filled_prompt,
                user_message=user_message,
                max_tokens=200,
                temperature=0.1,
                task_type="planning",
                session_id=session.session_id if session else "shadow",
            )

            llm_decision = self._parse_decide_output(llm_raw or "", round_num)

            # 瀵规瘮 LLM vs 瑙勫垯
            matched = llm_decision.get("intent") == rule_decision.get("intent")

            # 鍐欏叆褰卞瓙鍐崇瓥鏃ュ織
            shadow_log = {
                "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime()),
                "session_id": session.session_id if session else "unknown",
                "query_preview": query[:100],
                "round": round_num,
                "rule_intent": rule_decision.get("intent"),
                "rule_confidence": rule_decision.get("confidence"),
                "llm_intent": llm_decision.get("intent"),
                "llm_confidence": llm_decision.get("confidence"),
                "llm_reasoning": llm_decision.get("reasoning", "")[:200],
                "matched": matched,
                "engine_version": self._engine_version,
            }

            _DATA_DIR.mkdir(parents=True, exist_ok=True)
            shadow_path = _DATA_DIR / "shadow_decisions.jsonl"

            def _write_shadow():
                with open(shadow_path, "a", encoding="utf-8") as f:
                    f.write(json.dumps(shadow_log, ensure_ascii=False) + "\n")

            await asyncio.to_thread(_write_shadow)

            logger.info(
                "鈽?[涔綸[褰卞瓙] R%d LLM鈫?s vs 瑙勫垯鈫?s (match=%s)",
                round_num,
                llm_decision.get("intent"),
                rule_decision.get("intent"),
                matched,
            )

        except (ImportError, ModuleNotFoundError, json.JSONDecodeError, ValueError) as exc:
            logger.debug("鈽?[涔綸 褰卞瓙瀵规瘮寮傚父锛堥潪鑷村懡锛? %s", exc)

    # ========================================================================
    # 鍐呴儴鏂规硶 鈥?涓夊眰闄嶇骇鎵ц
    # ========================================================================

    async def _execute_with_degradation(
        self,
        intent: str,
        session: QianSession,
        query: str,
    ) -> Dict[str, Any]:
        """涓夊眰闄嶇骇鎵ц鎰忓浘

        L1: 姝ｅ父 IntentBus.dispatch()锛堝甫閲嶈瘯 + 鎸囨暟閫€閬匡級
        L2: ShaoyinBrain 鍥哄畾娴佹按绾匡紙鐩存帴 LLM 鍥炵瓟锛?
        L3: 鍏滃簳鐩寸瓟锛堢函鏂囨湰闄嶇骇鍝嶅簲锛?

        Args:
            intent:  鐩爣鎰忓浘鍚嶇О
            session: 褰撳墠浼氳瘽
            query:   鐢ㄦ埛鎻愰棶

        Returns:
            {"status": "ok"|"error", "data": ..., "error": "...", "degraded": bool}
        """
        target_gua = INTENT_TO_TARGET_GUA.get(intent)
        if not target_gua:
            return {"status": "error", "error": f"鎰忓浘 {intent} 鏃犲搴旂洰鏍囧崷", "data": "", "degraded": False}

        # ---- L1: 姝ｅ父 dispatch锛堝甫閲嶈瘯+鎸囨暟閫€閬匡級 ----
        result = await self._dispatch_with_retry(
            intent=intent,
            target_gua=target_gua,
            session_id=session.session_id,
            query=query,
        )
        if result.status == DispatchStatus.OK and result.payload:
            return {
                "status": "ok",
                "data": result.payload.get("result", str(result.payload)),
                "degraded": False,
            }

        # ---- L1 澶辫触璁板綍 ----
        self._degradation_counter.record_l1_failure()
        logger.warning("鈽?[涔綸 L1 dispatch 澶辫触 (%s), 杩涘叆 L2 闄嶇骇", result.status.value)

        # ---- L2: ShaoyinBrain 鍥哄畾娴佹按绾?----
        self._degradation_counter.record_l2_trigger()
        l2_result = await self._shaoyin_brain_fallback(intent, query)
        if l2_result:
            # ---- L2 瓒呴鍛婅 - 閫氱煡鑹崷 ----
            await self._check_and_alert_degradation_l2()
            return {"status": "ok", "data": l2_result, "degraded": True}

        logger.warning("鈽?[涔綸 L2 ShaoyinBrain 澶辫触, 杩涘叆 L3 鍏滃簳")

        # ---- L3: 鍏滃簳鐩存嫾锛堟绱㈢粨鏋滄嫾鎺?prompt锛屼笉璋?LLM锛?----
        self._degradation_counter.record_l3_trigger()
        l3_data = await self._l3_no_llm_fallback(intent, session, query)
        return {
            "status": "ok",
            "data": l3_data,
            "degraded": True,
            "level": 3,
        }

    async def _dispatch_with_retry(
        self,
        intent: str,
        target_gua: str,
        session_id: str,
        query: str,
    ) -> IntentResult:
        """L1 璋冨害锛氬甫閲嶈瘯 + 鎸囨暟閫€閬跨殑 dispatch

        灏濊瘯 3 娆★紝寤舵椂鍒嗗埆 1s / 2s / 4s銆?

        褰?SEARCH鈫掑方鏃讹紝payload 涓寘鍚?operation="search"銆乹uery銆乼op_k锛?
        纭繚宸藉崷鐨?_execute_core 鑳借矾鐢卞埌鏈湴 ChromaDB 妫€绱㈣矾寰勩€?

        Args:
            intent:      鎰忓浘鍚嶇О
            target_gua:  鐩爣鍗﹀悕
            session_id:  浼氳瘽 ID
            query:       鍘熷鏌ヨ

        Returns:
            IntentResult
        """
        last_result: Optional[IntentResult] = None
        retry_delays = [1.0, 2.0, 4.0]

        for attempt in range(3):
            # 鏋勫缓 payload锛歋EARCH鈫掑方 闇€瑕?operation="search" + query + top_k
            payload: Dict[str, Any] = {
                "intent": intent,
                "query": query,
                "attempt": attempt + 1,
            }
            if intent == "SEARCH" and target_gua == "宸?:
                payload["operation"] = "search"
                payload["top_k"] = 5

            signal = Signal(
                source="涔?,
                target=target_gua,
                signal_type=SignalType.REQUEST,
                priority=Priority.HIGH,
                payload=payload,
                session_id=session_id,
                ttl=30.0,
            )

            last_result = self._intent_bus.dispatch(signal)

            if last_result.status == DispatchStatus.OK:
                return last_result

            if last_result.status == DispatchStatus.CIRCUIT_OPEN:
                logger.warning(
                    "鈽?[涔綸 鏂矾鍣ㄦ柇寮€ %s鈫?s锛岃烦杩囬噸璇?,
                    "涔?,
                    target_gua,
                )
                break

            if attempt < 2:
                delay = retry_delays[attempt]
                logger.info(
                    "鈽?[涔綸 dispatch 閲嶈瘯 %d/2 (delay=%.1fs): %s鈫?s",
                    attempt + 1,
                    delay,
                    "涔?,
                    target_gua,
                )
                await asyncio.sleep(delay)

        return last_result or IntentResult(
            status=DispatchStatus.UNKNOWN_ERROR,
            error_message="鎵€鏈夐噸璇曡€楀敖",
        )

