    # 鍐呴儴鏂规硶 鈥?LLM 璋冪敤灏佽
    # ========================================================================

    async def dispatch_llm(
        self,
        system_prompt: str,
        user_message: str,
        max_tokens: int = 200,
        temperature: float = 0.1,
        task_type: str = "default",
        session_id: str = "default",
        tools: Optional[list] = None,
        tool_choice: Optional[str] = None,
    ) -> Optional[str]:
        """涔惧崷缁熶竴 LLM 璋冨害鍣?鈥?鎵€鏈夊叓鍗?LLM 璋冪敤鐨勫敮涓€鍏ュ彛锛坴1.50锛?

        杩欐槸涔惧崷浣滀负銆屾剰璇嗕腑鏋€嶇殑鏍稿績鑱岃兘涔嬩竴锛氱粺涓€璋冨害鎵€鏈?LLM 璇锋眰锛?
        鍖呮嫭鏅鸿兘妯″瀷閫夋嫨銆佹垚鏈绠楃啍鏂€佷笁灞傞檷绾ч摼銆?

        涓夊眰闄嶇骇閾撅紙L1鈫扡2鈫扡3锛?
          L1 妯″瀷閲嶈瘯: Mimo-pro 鈫?DeepSeek-pro 鈫?4o-mini
          L2 鍥哄畾娴佺▼: 閫€鍥炵‖缂栫爜 8 姝ヨ鍒欑閬?
          L3 鍏滃簳鐩存嫾: 妫€绱㈢粨鏋滄嫾鎺?prompt 涓嶈皟 LLM

        妯″瀷閫夋嫨鏅鸿兘鍖?
          - JSON 鎻愬彇/鍒嗙被/鏁寸悊 鈫?闈?pro 鐗堬紙mimo-v2.5 / mimo-v2.5-turbo锛?
          - 鎺ㄧ悊/缁煎悎/鍐崇瓥 鈫?pro 鐗堬紙mimo-v2.5-pro锛?
          - 杞婚噺浠诲姟锛坒ast_*锛夆啋 turbo锛坢imo-v2.5-turbo锛?

        Args:
            system_prompt: 绯荤粺鎻愮ず
            user_message:  鐢ㄦ埛娑堟伅
            max_tokens:    鏈€澶ц緭鍑?token 鏁?
            temperature:   娓╁害鍙傛暟
            task_type:     浠诲姟绫诲瀷锛堝奖鍝嶆ā鍨嬮€夋嫨锛夛紝鍙€夊€硷細
                             "default", "extraction", "classification", "parsing",
                             "validation", "distillation", "synthesis", "reflection",
                             "reasoning", "planning", "fast_classify", "fast_extract"
            session_id:    浼氳瘽 ID锛堢敤浜?TokenBudget 璺熻釜锛?
            tools:         Function calling tools 瀹氫箟
            tool_choice:   宸ュ叿閫夋嫨绛栫暐

        Returns:
            LLM 杈撳嚭鏂囨湰鎴?None
        """
        # ---- L1 鏅鸿兘妯″瀷閫夋嫨 ----
        model_sequence = self._select_model_chain(task_type)

        # ---- TokenBudget 妫€鏌?----
        try:
            from src.services.llm import TokenBudgetExceeded, get_session_budget

            budget = await get_session_budget(session_id)
            warn_msg = budget.warn_if_near_limit()
            if warn_msg:
                logger.warning("鈽?[涔綸 %s", warn_msg)
            if budget.is_tripped:
                logger.error(
                    "鈽?[涔綸 Session=%s 棰勭畻宸茬啍鏂?楼%.4f/楼%.2f, " "寮哄埗璧?L2 鍥哄畾娴佺▼",
                    session_id,
                    budget.consumed_cny,
                    budget.budget_cny,
                )
                return None  # 杩斿洖 None 瑙﹀彂涓婂眰 L2 闄嶇骇
        except ImportError:
            budget = None

        # ---- L1: 閫愭ā鍨嬪皾璇曪紙Mimo 鈫?DeepSeek 鈫?4o-mini锛?----
        messages = [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_message},
        ]

        from src.config import (
            DEEPSEEK_API_KEY,
            DEEPSEEK_BASE_URL,
            DEEPSEEK_TIMEOUT,
            MIMO_API_KEY,
            MIMO_BASE_URL,
            MIMO_TIMEOUT,
        )
        from src.services.llm import _call_api

        last_error = None
        for model_name in model_sequence:
            logger.info(
                "鈽?[涔綸 dispatch_llm L1 灏濊瘯妯″瀷=%s task=%s session=%s",
                model_name,
                task_type,
                session_id,
            )

            try:
                # 纭畾浣跨敤鍝釜 API 绔偣
                if model_name.startswith("mimo"):
                    if not MIMO_API_KEY:
                        logger.debug("鈽?[涔綸 Mimo API Key 鏈厤缃紝璺宠繃 %s", model_name)
                        continue
                    result = await _call_api(
                        base_url=MIMO_BASE_URL,
                        api_key=MIMO_API_KEY,
                        model=model_name,
                        messages=messages,
                        max_tokens=max_tokens,
                        temperature=temperature,
                        timeout=MIMO_TIMEOUT,
                        tools=tools,
                        tool_choice=tool_choice,
                    )
                elif model_name.startswith("deepseek"):
                    if not DEEPSEEK_API_KEY:
                        logger.debug("鈽?[涔綸 DeepSeek API Key 鏈厤缃紝璺宠繃 %s", model_name)
                        continue
                    result = await _call_api(
                        base_url=DEEPSEEK_BASE_URL,
                        api_key=DEEPSEEK_API_KEY,
                        model=model_name,
                        messages=messages,
                        max_tokens=max_tokens,
                        temperature=temperature,
                        timeout=DEEPSEEK_TIMEOUT,
                        tools=tools,
                        tool_choice=tool_choice,
                    )
                elif model_name == "4o-mini":
                    if not _OPENAI_4O_MINI_API_KEY:
                        logger.debug("鈽?[涔綸 4o-mini API Key 鏈厤缃紝璺宠繃")
                        continue
                    result = await _call_api(
                        base_url=_OPENAI_4O_MINI_BASE_URL,
                        api_key=_OPENAI_4O_MINI_API_KEY,
                        model="gpt-4o-mini",
                        messages=messages,
                        max_tokens=max_tokens,
                        temperature=temperature,
                        timeout=_OPENAI_4O_MINI_TIMEOUT,
                        tools=tools,
                        tool_choice=tool_choice,
                    )
                else:
                    continue

                if result:
                    # 鎴愬姛 鈫?鏇存柊棰勭畻
                    if budget is not None:
                        try:
                            budget.consume(
                                model=model_name,
                                input_chars=len(system_prompt) + len(user_message),
                                output_chars=len(result),
                            )
                        except TokenBudgetExceeded:
                            logger.warning(
                                "鈽?[涔綸 dispatch_llm 鍚庢鏌? Session=%s 棰勭畻宸茬啍鏂?,
                                session_id,
                            )
                            # 浠嶇劧杩斿洖缁撴灉锛屼絾涓嬫璋冪敤浼氭彁鍓嶆嫤鎴?
                    logger.info(
                        "鈽?[涔綸 dispatch_llm OK model=%s output=%d chars",
                        model_name,
                        len(result),
                    )
                    return result

            except (ImportError, ModuleNotFoundError, ValueError, KeyError, OSError) as exc:
                last_error = exc
                logger.warning(
                    "鈽?[涔綸 dispatch_llm 妯″瀷 %s 寮傚父: %s",
                    model_name,
                    exc,
                )
                continue

        if last_error:
            logger.error("鈽?[涔綸 dispatch_llm L1 鍏ㄩ儴妯″瀷澶辫触: %s", last_error)
        else:
            logger.error("鈽?[涔綸 dispatch_llm L1 鍏ㄩ儴妯″瀷涓嶅彲鐢?)

        # ---- L2: ShaoyinBrain 鍥哄畾娴佹按绾匡紙鐢变笂灞傝皟鐢ㄨ€呰礋璐ｏ紝杩欓噷杩斿洖 None锛?----
        return None

    @staticmethod
    def _select_model_chain(task_type: str) -> list:
        """鏍规嵁 task_type 杩斿洖妯″瀷灏濊瘯搴忓垪

        鏅鸿兘閫夋嫨閫昏緫锛?
          - JSON 鎻愬彇/鍒嗙被/瑙ｆ瀽 鈫?闈?pro 鐗堬紙mimo-v2.5 / mimo-v2.5-turbo锛?
          - 鎺ㄧ悊/缁煎悎/鍐崇瓥/鍙嶆€?鈫?pro 鐗堬紙mimo-v2.5-pro锛?
          - 鎵€鏈夐檷绾ч摼璺? 鈫?deepseek-v4-pro 鈫?4o-mini

        Args:
            task_type: 浠诲姟绫诲瀷

        Returns:
            妯″瀷鍚嶅垪琛紝鎸変紭鍏堢骇闄嶅簭
        """
        # JSON 杈撳嚭绫?鈫?闈?pro 鐗?
        json_tasks = {"extraction", "classification", "parsing", "validation", "distillation"}
        # 鎺ㄧ悊绫?鈫?pro 鐗?
        reason_tasks = {"synthesis", "reflection", "reasoning", "planning"}
        # 杞婚噺绫?鈫?turbo
        fast_tasks = {"fast_classify", "fast_extract"}

        if task_type in json_tasks:
            # JSON 鎻愬彇锛氫笉闇€瑕佹槀璐电殑 reasoning锛岄潪 pro 鐗堝嵆鍙?
            return ["mimo-v2.5", "deepseek-v4-pro", "4o-mini"]
        elif task_type in reason_tasks:
            # 鎺ㄧ悊锛氶渶瑕?pro 鐗?reasoning 鑳藉姏
            return ["mimo-v2.5-pro", "deepseek-v4-pro", "4o-mini"]
        elif task_type in fast_tasks:
            # 杞婚噺锛氱洿鎺?turbo
            return ["mimo-v2.5-turbo", "deepseek-v4-flash", "4o-mini"]
        else:
            # 榛樿
            return ["mimo-v2.5-pro", "mimo-v2.5", "deepseek-v4-pro", "4o-mini"]

