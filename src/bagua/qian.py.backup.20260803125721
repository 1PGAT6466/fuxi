    def check_health(self) -> Dict[str, Any]:
        """鎵ц涓€杞叏绯荤粺鍋ュ悍妫€鏌?

        妫€鏌ユ墍鏈夊凡娉ㄥ唽鍗︼紙閫氳繃 IntentBus锛夌殑鍋ュ悍鐘舵€侊紝
        浠ュ強鏍稿績鏈嶅姟鐘舵€併€傜瓑鍚屼簬鍘?HeartAgent._beat() 鐨勫姛鑳姐€?

        Returns:
            {
                "organs": {guaname: {"name": ..., "alive": bool, ...}},
                "services": {"vector_store": str, "llm": str},
                "anomalies": [str, ...],
                "timestamp": float,
                "beat_number": int,
            }
        """
        health: Dict[str, Any] = {
            "timestamp": time.time(),
            "beat_number": self._beat_count + 1,
            "organs": {},
            "services": {},
            "anomalies": [],
        }

        # 1. 妫€鏌ユ墍鏈夊凡娉ㄥ唽鍗︾殑鍋ュ悍鐘舵€?
        try:
            registered_guas = self._intent_bus.get_registered_guas()
            for trigram_name in registered_guas:
                # 鐢?dispatch 鐨?TargetUnregistered 鐘舵€佸垽鏂瓨娲?
                is_alive = trigram_name in registered_guas
                health["organs"][trigram_name] = {
                    "name": trigram_name,
                    "alive": is_alive,
                    "last_heartbeat_ago": 0.0,
                }
                if not is_alive:
                    health["anomalies"].append(f"鍗?{trigram_name} 鏃犲搷搴?)
        except (ImportError, ModuleNotFoundError, ValueError, KeyError) as exc:
            logger.debug("鈽?[涔綸 鍗﹀仴搴锋鏌ュ紓甯? %s", exc)

        # 涔熸鏌ヨ嚜韬?
        health["organs"][self.GUA_NAME] = {
            "name": self.GUA_NAME,
            "alive": self._alive,
            "last_heartbeat_ago": 0.0,
        }

        # 2. 妫€鏌ユ牳蹇冩湇鍔?
        health["services"]["vector_store"] = self._check_vector_store()
        health["services"]["llm"] = self._check_llm_service()

        # 3. 澶勭悊寮傚父
        if health["anomalies"]:
            self._heal(health["anomalies"])

        self._beat_count += 1
        self._last_health = health

        logger.info(
            "鈽?[涔綸 鍋ュ悍妫€鏌?#%d: %d 鍗? %d 寮傚父",
            self._beat_count,
            len(health["organs"]),
            len(health["anomalies"]),
        )
        return health

    def get_stats(self) -> Dict[str, Any]:
        """鑾峰彇蹇冭烦缁熻淇℃伅

        Returns:
            {
                "beat_count": int,
                "anomalies_24h": int,
                "last_beat_ago": float,
                "running": bool,
                "alive": bool,
            }
        """
        last_beat_ago: float = 0.0
        last_ts = self._last_health.get("timestamp", 0.0)
        if last_ts > 0:
            last_beat_ago = round(time.time() - last_ts, 1)

        anomalies_24h = len([a for a in self._anomalies if time.time() - a.get("time", 0) < 86400])

        return {
            "beat_count": self._beat_count,
            "anomalies_24h": anomalies_24h,
            "last_beat_ago": last_beat_ago,
            "running": self._health_running,
            "alive": self._alive,
        }

    def start_beating(self) -> None:
        """鍚姩瀹氭椂鍋ュ悍妫€鏌ュ績璺?

        绛夊悓浜?HeartAgent.start_beating()锛屽惎鍔ㄤ竴涓紓姝ュ惊鐜?
        瀹氭椂鎵ц check_health()銆?
        """
        if self._health_running:
            return
        self._health_running = True
        try:
            loop = asyncio.get_event_loop()
            if loop.is_running():
                self._health_task = asyncio.ensure_future(self._beat_loop())
            else:
                self._health_task = loop.create_task(self._beat_loop())
        except RuntimeError:
            logger.debug("鈽?[涔綸 鏃犱簨浠跺惊鐜紝鍋ュ悍蹇冭烦寤惰繜鍚姩")
        logger.info("鈽?[涔綸 鍋ュ悍蹇冭烦宸插惎鍔?(interval=%.1fs)", self.BEAT_INTERVAL)

    async def stop_beating(self) -> None:
        """鍋滄瀹氭椂鍋ュ悍妫€鏌ュ績璺?""
        self._health_running = False
        if self._health_task:
            self._health_task.cancel()
            try:
                await self._health_task
            except asyncio.CancelledError:
                pass
            except Exception as exc:
                logger.debug("鈽?[涔綸 鍋ュ悍蹇冭烦鍋滄寮傚父: %s", exc)
            self._health_task = None
        logger.info("鈽?[涔綸 鍋ュ悍蹇冭烦宸插仠姝?)

    # ========================================================================
    # 鍐呴儴鏂规硶 鈥?鍋ュ悍妫€鏌?
    # ========================================================================

    async def _beat_loop(self) -> None:
        """瀹氭椂蹇冭烦寰幆"""
        while self._health_running:
            try:
                await asyncio.sleep(self.BEAT_INTERVAL)
                self.check_health()
            except asyncio.CancelledError:
                break
            except Exception as exc:
                logger.error("鈽?[涔綸 蹇冭烦寮傚父: %s", exc, exc_info=True)

    def _heal(self, anomalies: List[str]) -> None:
        """鍙戠幇寮傚父鍚庡彂閫佸憡璀︿俊鍙?

        杩佺Щ鑷?HeartAgent._heal()銆?
        灏嗗紓甯镐俊鎭箍鎾粰鍏虫敞寮傚父鐨勫叾浠栧崷锛堝鍏戝崷/PRESENT锛夈€?

        Args:
            anomalies: 寮傚父鎻忚堪鍒楄〃
        """
        for anomaly in anomalies:
            if "LLM" in anomaly or "鍚戦噺" in anomaly or "vector" in anomaly:
                logger.warning("鈽?[涔綸 寮傚父鍛婅: %s 鈥?閫氱煡鍏戝崷(杈撳嚭灞?", anomaly)
                try:
                    alert = Signal(
                        source="涔?,
                        target="鍏?,
                        signal_type=SignalType.ERROR,
                        priority=Priority.HIGH,
                        payload={"message": anomaly},
                        ttl=30.0,
                    )
                    self._intent_bus.dispatch(alert)
                except (ImportError, ModuleNotFoundError, ValueError, KeyError) as exc:
                    logger.debug("鈽?[涔綸 鍛婅娲惧彂寮傚父: %s", exc)

            self._anomalies.append(
                {
                    "time": time.time(),
                    "message": anomaly,
                }
