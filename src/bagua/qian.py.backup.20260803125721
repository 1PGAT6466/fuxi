@dataclass
class CycleGuardState:
    """CycleGuard 鍐呴儴鐘舵€?

    Attributes:
        round_count:                宸叉墽琛岃疆鏁?
        last_intent:                涓婁竴杞殑鎰忓浘
        consecutive_same:           杩炵画鐩稿悓鎰忓浘璁℃暟
        per_trigram_count:          姣忎釜鎰忓浘鐨勭疮璁¤皟鐢ㄦ鏁?
        has_searched:               鏄惁宸茬粡鎵ц杩?SEARCH/SEARCH_X
        guard_intervention_count:   CycleGuard 杩炵画鎷︽埅娆℃暟
        anomaly_cache:              寮傚父妯″紡缂撳瓨锛堟渶杩?100 娆¤鎷︽埅鐨勬剰鍥剧粍鍚堬級
        known_issues:               宸茬煡闂绛惧悕闆嗗悎锛堝悓涓€妯″紡杩炵画鎷︽埅 >=3 娆″悗鏍囪锛?
    """

    round_count: int = 0
    last_intent: Optional[str] = None
    consecutive_same: int = 0
    per_trigram_count: Dict[str, int] = field(default_factory=dict)
