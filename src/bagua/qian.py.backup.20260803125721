            {
                "source": source,
                "content": str(content),
                "timestamp": time.time(),
            }
        )
        self.last_activity = time.time()

    def get_context_for_decide(self) -> str:
        """鐢熸垚娉ㄥ叆涓嬩竴杞?LLM 鍐崇瓥鐨勪笂涓嬫枃鎽樿

        鍙栨渶杩?5 鏉＄疮绉笂涓嬫枃锛屾埅鏂繃闀垮唴瀹广€?

        Returns:
            鏍煎紡鍖栫殑涓婁笅鏂囧瓧绗︿覆
        """
        if not self.accumulated_context:
            return "锛堝皻鏃犱笂涓嬫枃淇℃伅锛?

        lines: List[str] = []
        recent = self.accumulated_context[-5:]
        for i, item in enumerate(recent, 1):
            content = str(item["content"])
            if len(content) > 300:
                content = content[:300] + "..."
            lines.append(f"[{i}] {item['source']}: {content}")
        return "\n".join(lines)


