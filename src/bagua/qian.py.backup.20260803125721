    guard_intervention_count: int = 0
    anomaly_cache: List[str] = field(default_factory=list)  # 鏈€杩?100 娆¤鎷︽埅鐨勬剰鍥剧粍鍚?
    known_issues: set = field(default_factory=set)  # 宸茬煡闂绛惧悕闆嗗悎


class CycleGuard:
    """寰幆瀹堟姢鍣?鈥?闃叉鎰忓浘寰幆澶辨帶

    鎷︽埅瑙勫垯锛?
      - 瓒呰繃 max_rounds 鈫?寮哄埗缁堟
      - 杩炵画鍚屽崷 > max_consecutive_same 鈫?鎷︽埅
      - DONE 鍓嶆湭鎵ц SEARCH 鈫?鎷︽埅
      - DONE 浣?confidence < min_confidence_for_done 鈫?鎷︽埅
      - 鍗曞崷鎬昏皟鐢ㄨ秴杩囦笂闄?鈫?鎷︽埅

    Attributes:
        max_rounds:              鏈€澶у惊鐜疆鏁帮紙榛樿 8锛?
        max_consecutive_same:    鍚屽崷杩炵画涓婇檺锛堥粯璁?2锛?
        max_per_trigram:         姣忓崷鎬昏皟鐢ㄤ笂闄?
        min_confidence_for_done: DONE 鏈€浣庣疆淇″害锛堥粯璁?0.7锛?
        AnomalyCacheSize:          寮傚父妯″紡缂撳瓨鏈€澶у閲忥紙榛樿 100锛?
        KnownIssueThreshold:      鍚屼竴妯″紡杩炵画鎷︽埅 N 娆″悗鏍囪涓哄凡鐭ラ棶棰橈紙榛樿 3锛?
    """

    # 缂撳瓨瀹归噺
    MAX_ANOMALY_CACHE_SIZE: int = 100
    # 宸茬煡闂闃堝€?
    KNOWN_ISSUE_THRESHOLD: int = 3

    def __init__(
        self,
        max_rounds: int = 8,
        max_consecutive_same: int = 2,
        max_per_trigram: Optional[Dict[str, int]] = None,
        min_confidence_for_done: float = 0.7,
    ) -> None:
        self.max_rounds = max_rounds
        self.max_consecutive_same = max_consecutive_same
        self.max_per_trigram: Dict[str, int] = max_per_trigram or {
            "SEARCH": 3,
            "SEARCH_X": 2,
            "REFINE": 3,
            "DECIDE": 2,
            "GUARD": 2,
            "PRESENT": 2,
            "DONE": 1,
        }
        self.min_confidence_for_done = min_confidence_for_done
        # 寮傚父妯″紡缂撳瓨锛堟ā鍧楃骇鍏变韩锛岀敤浜庤法 session 瀛︿範锛?
        self._anomaly_cache: List[str] = []
        self._known_issues: set = set()

    def pre_check(
        self,
        intent: str,
        confidence: float,
        state: CycleGuardState,
        query: str = "",
    ) -> Tuple[bool, str]:
        """鎵ц棰勬鏌ワ紝杩斿洖 (閫氳繃, 鍘熷洜)

        瑙勫垯椤哄簭锛?
          0. 宸茬煡闂閫忎紶锛氬鏋滄鎰忓浘缁勫悎宸插湪 known_issues 涓紝鐩存帴閫氳繃
          1. 瓒呰繃 max_rounds
          2. 杩炵画鍚屽崷 > max_consecutive_same
          3. 姣忓崷鎬昏皟鐢ㄤ笂闄?
          4. DONE 鍓嶆湭鎵ц SEARCH
          5. DONE 浣?confidence < min

        Args:
            intent:     鏈疆鎰忓浘
            confidence: 鍐崇瓥缃俊搴?
            state:      褰撳墠寰幆鐘舵€侊紙浼氳淇敼浠ユ洿鏂?consecutive_same 绛夛級
            query:      鐢ㄦ埛鏌ヨ锛堢敤浜庣敓鎴愬紓甯哥鍚嶏級

        Returns:
            (鏄惁閫氳繃, 鍘熷洜璇存槑)銆傞€氳繃鏃?reason 涓虹┖瀛楃涓层€?
        """
        # 瑙勫垯 0: 宸茬煡闂閫忎紶 鈥?鍚屼竴妯″紡宸茶 learn 璇嗗埆锛岀洿鎺ユ斁琛?
        signature = self._make_anomaly_signature(intent, query, state)
        if signature in self._known_issues:
            logger.info(
                "鈽?[涔綸 CycleGuard 宸茬煡闂閫忎紶: %s (signature=%s)",
                intent,
                signature[:60],
            )
            return True, ""

        # 瑙勫垯 1: 瓒呰繃 max_rounds
        if state.round_count >= self.max_rounds:
            self._record_anomaly(intent, query, state, reason=f"瓒呰繃鏈€澶ц疆鏁?({self.max_rounds})")
            return False, f"瓒呰繃鏈€澶ц疆鏁伴檺鍒?({self.max_rounds})"

        # 瑙勫垯 2: 杩炵画鍚屽崷 > max_consecutive_same
        if intent == state.last_intent:
            state.consecutive_same += 1
        else:
            state.consecutive_same = 1
            state.last_intent = intent

        if state.consecutive_same > self.max_consecutive_same:
            self._record_anomaly(intent, query, state, reason=f"杩炵画璋冪敤 {intent} 瓒呰繃 {self.max_consecutive_same} 娆?)
            return False, f"杩炵画璋冪敤 {intent} 瓒呰繃 {self.max_consecutive_same} 娆?

        # 瑙勫垯 3: 姣忓崷鎬昏皟鐢ㄤ笂闄?
        per_trigram_count = state.per_trigram_count.get(intent, 0)
        max_for_this = self.max_per_trigram.get(intent, 999)
        if per_trigram_count >= max_for_this:
            self._record_anomaly(intent, query, state, reason=f"{intent} 璋冪敤娆℃暟宸茶揪涓婇檺 ({max_for_this})")
            return False, f"{intent} 璋冪敤娆℃暟宸茶揪涓婇檺 ({max_for_this})"

        # 瑙勫垯 4: DONE 鍓嶆湭鎵ц SEARCH
        if intent == "DONE" and not state.has_searched:
            self._record_anomaly(intent, query, state, reason="鏈墽琛?SEARCH 鍓嶇姝?DONE")
            return False, "鏈墽琛?SEARCH 鍓嶇姝?DONE"

        # 瑙勫垯 5: DONE 浣?confidence < min
        if intent == "DONE" and confidence < self.min_confidence_for_done:
            self._record_anomaly(
                intent, query, state, reason=f"DONE 缃俊搴?{confidence:.2f} < {self.min_confidence_for_done}"
            )
            return False, f"DONE 缃俊搴?{confidence:.2f} < {self.min_confidence_for_done}"

        return True, ""

    def force_fallback(self) -> str:
        """杩斿洖寮哄埗闄嶇骇淇″彿"""
        return "FALLBACK_FIXED_PIPELINE"

    def record_intent(self, intent: str, state: CycleGuardState) -> None:
        """璁板綍鏈疆鎰忓浘鎵ц锛堥€氳繃棰勬鏌ュ悗璋冪敤锛?

        Args:
            intent: 鏈疆鎰忓浘
            state:  寰幆鐘舵€?
        """
        state.round_count += 1
        state.per_trigram_count[intent] = state.per_trigram_count.get(intent, 0) + 1
        if intent in ("SEARCH", "SEARCH_X"):
            state.has_searched = True

    # ========================================================================
    # 寮傚父妯″紡瀛︿範 鈥?璁板綍鎷︽埅銆佽瘑鍒凡鐭ラ棶棰樸€佽嚜鍔ㄩ€忎紶
    # ========================================================================

    @staticmethod
    def _make_anomaly_signature(intent: str, query: str, state: CycleGuardState) -> str:
        """鐢熸垚寮傚父妯″紡绛惧悕

        绛惧悕鏍煎紡锛歩ntent|round_count|consecutive_same|query_prefix
        鐢ㄤ簬璺?session 璇嗗埆鐩稿悓鐨勬嫤鎴ā寮忋€?

        Args:
            intent:  琚嫤鎴殑鎰忓浘
            query:   鐢ㄦ埛鏌ヨ鏂囨湰
            state:   褰撳墠寰幆鐘舵€?

        Returns:
            绛惧悕瀛楃涓?
        """
        q = (query or "").strip()[:40]
        return f"{intent}|R{state.round_count}|CS{state.consecutive_same}|q={q}"

    def _record_anomaly(
        self,
        intent: str,
        query: str,
        state: CycleGuardState,
        reason: str,
    ) -> None:
        """璁板綍涓€娆″紓甯告嫤鎴埌缂撳瓨锛圕ycleGuard 妯″潡绾э級

        鍚屾椂妫€鏌ユ槸鍚﹀簲鏍囪涓?宸茬煡闂"锛?
        鍚屼竴绛惧悕杩炵画鍑虹幇 >= KNOWN_ISSUE_THRESHOLD 娆℃椂鑷姩鏍囪銆?

        Args:
            intent:  琚嫤鎴殑鎰忓浘
            query:   鐢ㄦ埛鏌ヨ
            state:   褰撳墠寰幆鐘舵€?
            reason:  鎷︽埅鍘熷洜
        """
        signature = self._make_anomaly_signature(intent, query, state)

        # 缁存姢妯″潡绾у紓甯哥紦瀛橈紙FIFO + 鍘婚噸锛?
        self._anomaly_cache.append(signature)
        if len(self._anomaly_cache) > self.MAX_ANOMALY_CACHE_SIZE:
            self._anomaly_cache = self._anomaly_cache[-self.MAX_ANOMALY_CACHE_SIZE :]

        # 涔熸洿鏂?session 绾х紦瀛?
        state.anomaly_cache.append(signature)
        if len(state.anomaly_cache) > self.MAX_ANOMALY_CACHE_SIZE:
            state.anomaly_cache = state.anomaly_cache[-self.MAX_ANOMALY_CACHE_SIZE :]

        # 妫€鏌ユ槸鍚﹁揪鍒板凡鐭ラ棶棰橀槇鍊?
        self._check_known_issue(signature, state, intent, reason)

    def _check_known_issue(
        self,
        signature: str,
        state: CycleGuardState,
        intent: str,
        reason: str,
    ) -> None:
        """妫€鏌ュ紓甯哥鍚嶆槸鍚﹀簲鏍囪涓哄凡鐭ラ棶棰?

        鏈€杩?N 娆″紓甯哥紦瀛樹腑鍚屼竴绛惧悕鍑虹幇 >= KNOWN_ISSUE_THRESHOLD 娆?
        鍒欒嚜鍔ㄦ爣璁颁负 known_issue锛屽悗缁洿鎺ラ€忎紶銆?

        Args:
            signature:  寮傚父绛惧悕
            state:      褰撳墠寰幆鐘舵€?
            intent:     琚嫤鎴殑鎰忓浘
            reason:     鎷︽埅鍘熷洜
        """
        # 鐢?session 绾х紦瀛樺仛蹇€熺粺璁?
        recent = state.anomaly_cache[-self.KNOWN_ISSUE_THRESHOLD * 2 :]
        count = sum(1 for s in recent if s == signature)
        if count >= self.KNOWN_ISSUE_THRESHOLD and signature not in self._known_issues:
            self._known_issues.add(signature)
            logger.warning(
                "鈽?[涔綸 CycleGuard 鑷姩鏍囪宸茬煡闂: intent=%s reason='%s' signature=%s (杩炵画 %d 娆?",
                intent,
                reason,
                signature[:60],
                count,
            )

    def get_anomaly_stats(self) -> Dict[str, Any]:
        """鑾峰彇寮傚父妯″紡缁熻

        Returns:
            {"cache_size": int, "known_issues_count": int, "known_issues": [str, ...]}
        """
        return {
            "cache_size": len(self._anomaly_cache),
            "known_issues_count": len(self._known_issues),
            "known_issues": list(self._known_issues)[-20:],  # 鏈€杩?20 涓?
        }

    def clear_anomaly_cache(self) -> None:
        """娓呯悊寮傚父妯″紡缂撳瓨"""
        self._anomaly_cache.clear()
        self._known_issues.clear()
        logger.info("鈽?[涔綸 CycleGuard 寮傚父缂撳瓨宸叉竻鐞?)


