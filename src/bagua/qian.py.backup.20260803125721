class ParallelPipeline:
    """娴佹按绾垮苟琛屽寲 鈥?骞跺彂鎵ц澶氫釜鐙珛鍗︾殑浠诲姟

    褰撳畨鍏ㄥ贰鑸?鍥哄畾娴佹按绾夸腑鏈夊涓棤鏁版嵁渚濊禆鐨勬楠ゆ椂锛?
    鍙互灏嗗畠浠苟琛屾淳鍙戜互闄嶄綆绔埌绔欢杩熴€?

    骞惰缁勫畾涔夛細
      - Group A (妫€绱?: SEARCH + SEARCH_X 鈫?鏃犱緷璧栵紝鍙苟琛?
      - Group B (鍚庡鐞?: REFINE + GUARD 鈫?渚濊禆浜?A 鐨勭粨鏋?
      - Group C (缁堝眬): DECIDE + PRESENT 鈫?渚濊禆浜?B 鐨勭粨鏋?

    浣跨敤鏂瑰紡锛?
        pipeline = ParallelPipeline(qian_gua, intent_bus, session)
        results = await pipeline.execute_parallel_group(
            intents=["SEARCH", "SEARCH_X"],
            query="..."
        )
    """

    # 鍙苟琛岀殑鎰忓浘缁?
    PARALLEL_GROUPS: Dict[str, List[str]] = {
        "retrieval": ["SEARCH", "SEARCH_X"],  # 妫€绱㈢粍锛氭湰鍦?+ 澶栭儴鍚屾椂杩涜
        "process": ["REFINE", "GUARD"],  # 鍚庡鐞嗙粍锛氱簿鐐?+ 瀹夊叏瀹℃煡
    }

    def __init__(
        self,
        qian_gua: Any,
        intent_bus: IntentBus,
        session: "QianSession",
    ) -> None:
        self._qian = qian_gua
        self._intent_bus = intent_bus
        self._session = session

    async def execute_parallel_group(
        self,
        intents: List[str],
        query: str,
    ) -> Dict[str, Dict[str, Any]]:
        """骞惰娲惧彂涓€缁勬剰鍥撅紝杩斿洖姣忎釜鎰忓浘鐨勭粨鏋?

        Args:
            intents: 瑕佸苟鍙戞墽琛岀殑鎰忓浘鍒楄〃
            query:   鍘熷鏌ヨ

        Returns:
            {intent: {"status": "ok"|"error", "data": ..., "error": ...}}
        """
        if not intents:
            return {}

        tasks = []
        intent_map: Dict[int, str] = {}

        for i, intent in enumerate(intents):
            target_gua = INTENT_TO_TARGET_GUA.get(intent)
            if not target_gua:
                continue
            intent_map[i] = intent
            tasks.append(self._dispatch_one(intent, target_gua, query))

        results_list = await asyncio.gather(*tasks, return_exceptions=True)

        results: Dict[str, Dict[str, Any]] = {}
        for i, r in enumerate(results_list):
            intent = intent_map.get(i, f"unknown_{i}")
            if isinstance(r, Exception):
                results[intent] = {"status": "error", "error": str(r), "data": ""}
                logger.warning("鈽?[涔綸 骞惰娲惧彂 %s 寮傚父: %s", intent, r)
            else:
                results[intent] = r

        return results

    async def _dispatch_one(
        self,
        intent: str,
        target_gua: str,
        query: str,
    ) -> Dict[str, Any]:
        """娲惧彂鍗曚釜鎰忓浘锛堝唴閮ㄧ敱 execute_with_degradation 璋冪敤锛?""
        signal = Signal(
            source="涔?,
            target=target_gua,
            signal_type=SignalType.REQUEST,
            priority=Priority.HIGH,
            payload={"intent": intent, "query": query},
            session_id=self._session.session_id,
            ttl=30.0,
        )
        result = self._intent_bus.dispatch(signal)
        if result.status == DispatchStatus.OK and result.payload:
            return {"status": "ok", "data": result.payload.get("result", str(result.payload))}
        return {"status": "error", "error": result.error_message, "data": ""}

    @classmethod
    def get_parallel_schedule(cls, remaining_intents: List[str]) -> List[List[str]]:
        """缁欏畾鍓╀綑鐨勬剰鍥惧垪琛紝杩斿洖寤鸿鐨勫苟琛屾墽琛岃鍒?

        Returns:
            [[batch1], [batch2], ...] 姣忎釜 batch 鍐呯殑鎰忓浘鍙互骞惰
        """
        schedule: List[List[str]] = []
        for group_name, group_intents in cls.PARALLEL_GROUPS.items():
            batch = [i for i in remaining_intents if i in group_intents]
            if batch:
                schedule.append(batch)
        # 鍓╀綑涓嶅湪骞惰缁勪腑鐨勬剰鍥惧悇鑷崟鐙墽琛?
        remaining = [i for i in remaining_intents if not any(i in g for g in cls.PARALLEL_GROUPS.values())]
        for intent in remaining:
            schedule.append([intent])
        return schedule


