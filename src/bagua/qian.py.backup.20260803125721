        if session_id not in self._sessions:
            self._sessions[session_id] = QianSession(
                session_id=session_id,
                query=query,
                history=history,
            )
        self._intent_bus.open_session(session_id)
        return self._sessions[session_id]

    async def _execute_decision_loop(
        self,
        session: "QianSession",
        query: str,
        history: list,
        kun_history_summary: str,
    ) -> tuple:
        """鎵ц鍐崇瓥寰幆锛岃繑鍥?(final_answer, intents_used, fallback_used)"""
        intents_used = []
        fallback_used = False
        final_answer = ""

        while session.cycle_state.round_count < self.MAX_ROUNDS:
            # SafetyCruise 鎺ョ妫€鏌?
            sc_override = session.safety_cruise.override(session.cycle_state)
            if sc_override is not None:
                decision = sc_override
                logger.info(
                    "鈽?[涔綸 R%d SafetyCruise 鎺ョ: intent=%s",
                    session.cycle_state.round_count + 1,
                    decision["intent"],
                )
            else:
                # 姝ｅ父 LLM 鍐崇瓥
                suggestion = session.safety_cruise.suggest(session.cycle_state)
                decision = await self._decide(
                    query=query,
                    history=history,
                    context=session.get_context_for_decide(),
                    round_num=session.cycle_state.round_count + 1,
                    suggestion=suggestion,
                    session=session,
                    kun_history_summary=kun_history_summary,
                )

            intent = decision.get("intent", "DONE")
            confidence = float(decision.get("confidence", 0.5))
            reasoning = str(decision.get("reasoning", ""))[:40]

            logger.info(
                "鈽?[涔綸 R%d 鍐崇瓥: intent=%s conf=%.2f reason='%s'",
                session.cycle_state.round_count + 1,
                intent,
                confidence,
                reasoning,
            )

            # CycleGuard 棰勬鏌?
            passed, block_reason = self._cycle_guard.pre_check(
                intent,
                confidence,
                session.cycle_state,
                query=query,
            )
            if not passed:
                logger.warning(
                    "鈽?[涔綸 R%d CycleGuard 鎷︽埅: %s",
                    session.cycle_state.round_count + 1,
                    block_reason,
                )
                session.cycle_state.guard_intervention_count += 1

                if session.cycle_state.guard_intervention_count > 2:
                    if not session.safety_cruise.is_active:
                        session.safety_cruise.activate()
                        logger.warning("鈽?[涔綸 SafetyCruise 婵€娲?)
                    continue

                if session.cycle_state.round_count >= self.MAX_ROUNDS - 1:
                    fallback_used = True
                    final_answer = self._build_fallback_answer(session)
                    break
                continue

            # 閫氳繃棰勬鏌?鈫?姝ｅ紡璁板綍
            self._cycle_guard.record_intent(intent, session.cycle_state)
            intents_used.append(intent)

            # 绗節瀹弽棣堟ˉ鎺?
            await self._evo_record_step(
                session_id=session.session_id,
                query=query,
                intent=intent,
                confidence=confidence,
                round_num=session.cycle_state.round_count,
            )

            # 妫€鏌?DONE
            if intent == "DONE":
                final_answer = await self._generate_final_answer(session)
                break

            # 娲惧彂鎰忓浘鍒扮洰鏍囧崷
            if intent in INTENT_TO_TARGET_GUA:
                dispatch_result = await self._execute_with_degradation(
                    intent=intent,
                    session=session,
                    query=query,
                )
                if dispatch_result.get("status") == "ok":
                    session.add_context(
                        source=f"{intent}({INTENT_TO_TARGET_GUA[intent]}鍗?",
                        content=dispatch_result.get("data", ""),
                    )
                else:
                    session.add_context(
                        source=f"{intent}({INTENT_TO_TARGET_GUA[intent]}鍗?",
                        content=f"[鎵ц寮傚父] {dispatch_result.get('error', '鏈煡')}",
                    )
            else:
                logger.warning("鈽?[涔綸 鏈煡鎰忓浘: %s", intent)
                session.add_context(
                    source="鏈煡鎰忓浘",
                    content=f"绯荤粺鏃犳硶澶勭悊鎰忓浘 '{intent}'",
                )

        # 瓒呰繃鏈€澶ц疆鏁?
        if not final_answer and session.cycle_state.round_count >= self.MAX_ROUNDS:
            fallback_used = True
            final_answer = self._build_fallback_answer(session)
            logger.warning("鈽?[涔綸 杈惧埌鏈€澶ц疆鏁?%d锛屽己鍒剁粓姝?, self.MAX_ROUNDS)

        return final_answer, intents_used, fallback_used

    def _build_think_result(
        self,
        final_answer: str,
        intents_used: list,
        fallback_used: bool,
        session: "QianSession",
        elapsed_ms: float,
    ) -> Dict[str, Any]:
        """鏋勫缓 think 缁撴灉"""
        confidence = self._compute_confidence(
            intents_used=intents_used,
            fallback_used=fallback_used,
            session=session,
        )
        sources = self._collect_sources(session)

        return {
            "answer": final_answer,
            "sources": sources,
            "mode": f"qian_{self._intent_mode}",
            "confidence": confidence,
            "rounds": len(intents_used),
            "intents_used": intents_used,
            "fallback_used": fallback_used,
            "elapsed_ms": round(elapsed_ms, 1),
        }

    async def think(
        self,
        query: str,
        history: Optional[List[Dict[str, str]]] = None,
        session_id: str = "default",
    ) -> Dict[str, Any]:
        """涔惧崷鎰忚瘑涓灑 鈥?鎰忓浘寰幆涓诲叆鍙ｏ紙閲嶆瀯 v1.50锛?""
        start_time = time.time()
        history = history or []

        # 闄愭祦妫€鏌?
        rate_limit_result = await self._check_rate_limit()
        if rate_limit_result:
            return rate_limit_result

        # 骞跺彂妲戒綅
        acquired = await self._acquire_semaphore()

        # 鍑嗗浼氳瘽
        session = self._prepare_session(session_id, query, history)

        final_answer = ""
        intents_used = []
        fallback_used = False

        logger.info("鈽?[涔綸 Session=%s 寮€濮嬫剰鍥惧惊鐜?query='%s...'", session_id, query[:60])

        try:
            self._degradation_counter.try_hourly_reset()
            self._degradation_counter.record_request()

            # 鑾峰彇鍧ゅ崷鍘嗗彶涓婁笅鏂?
            kun_history_summary = await self._fetch_kun_history(session_id)
            if kun_history_summary:
                logger.debug("鈽?[涔綸 鍧ゅ崷鍘嗗彶涓婁笅鏂? %d chars", len(kun_history_summary))

            # 鎵ц鍐崇瓥寰幆
            final_answer, intents_used, fallback_used = await self._execute_decision_loop(
                session,
                query,
                history,
                kun_history_summary,
            )

        except (ImportError, ModuleNotFoundError, ValueError, TypeError, KeyError) as exc:
            logger.error("鈽?[涔綸 鎰忓浘寰幆寮傚父: %s", exc, exc_info=True)
            fallback_used = True
            final_answer = "鎶辨瓑锛屽鐞嗘偍鐨勮姹傛椂鍑洪敊浜嗐€傝绋嶅悗閲嶈瘯銆?

        finally:
            if acquired:
                self._think_semaphore.release()

        elapsed_ms = (time.time() - start_time) * 1000
        return self._build_think_result(
            final_answer,
            intents_used,
            fallback_used,
            session,
            elapsed_ms,
        )

    def clear_session(self, session_id: str) -> None:
        """娓呯悊鎸囧畾浼氳瘽

        Args:
            session_id: 浼氳瘽鏍囪瘑
        """
        if session_id in self._sessions:
            del self._sessions[session_id]
            logger.debug("鈽?[涔綸 Session %s 宸叉竻鐞?, session_id)
        self._intent_bus.close_session(session_id)

    def clear_all_sessions(self) -> None:
        """娓呯悊鎵€鏈変細璇?""
        for sid in list(self._sessions.keys()):
            self.clear_session(sid)

    def _cleanup_expired_sessions(self) -> None:
        """娓呯悊杩囨湡 session

        绉婚櫎瓒呰繃 SESSION_TTL 绉掓湭娲诲姩鐨?session銆?
        鍦ㄦ瘡娆?think() 璋冪敤寮€澶存墽琛岋紝闃叉 _sessions 瀛楀吀鏃犻檺澧為暱銆?
        """
        now = time.time()
        expired_ids = [sid for sid, session in self._sessions.items() if now - session.last_activity > SESSION_TTL]
        for sid in expired_ids:
            self.clear_session(sid)
        if expired_ids:
            logger.debug(
                "鈽?[涔綸 TTL 娓呯悊: 绉婚櫎 %d 涓繃鏈?session",
                len(expired_ids),
            )

    # ========================================================================
    # 绗節瀹嚜杩涘寲妗ユ帴鏂规硶 鈥?鍙嶉璁板綍 + 瀹氭湡瀛︿範
    # ========================================================================

    async def _evo_record_step(
        self,
        session_id: str,
        query: str,
        intent: str,
        confidence: float,
        round_num: int,
    ) -> None:
        """灏嗕咕鍗︽瘡涓€姝ユ墽琛岀粨鏋滃弽棣堢粰绗節瀹殑 feedback_loop

        姣忓綋涔惧崷閫氳繃 CycleGuard 鍚庤褰曚竴鏉?feedback锛?
          - action 鏄犲皠锛歋EARCH/SEARCH_X/REFINE/DECIDE/FUSION 鈫?"click"
          - DONE 鍗曠嫭璁板綍涓?"copy"锛堣〃绀虹敤鎴锋渶缁堣幏寰椾簡绛旀锛?
          - metadata 涓寘鍚?round_num銆乮ntent銆乧onfidence 绛変俊鎭緵 learner 鍒嗘瀽

        鍚屾椂锛屾瘡娆¤褰曞悗妫€鏌ユ槸鍚﹂渶瑕佽Е鍙戝畾鏈熷涔狅紙榛樿姣忓皬鏃讹級銆?

        Args:
            session_id: 浼氳瘽 ID
            query:      鐢ㄦ埛鍘熷鏌ヨ
            intent:     褰撳墠鎰忓浘
            confidence: LLM 鍐崇瓥缃俊搴?
            round_num:  褰撳墠杞暟
        """
        if not _EVO_FEEDBACK_AVAILABLE:
            return

        action = "copy" if intent == "DONE" else "click"

        try:
            await _evo_record_feedback(
                user_id=session_id,
                query=query,
                action=action,
                metadata={
                    "step": intent,
                    "round": round_num,
                    "qian_confidence": confidence,
                    "source": "qian_think_loop",
                },
            )
        except (ImportError, ModuleNotFoundError, ValueError, TypeError) as exc:
            logger.debug("鈽?[涔綸 鍙嶉妗ユ帴璁板綍寮傚父锛堥潪鑷村懡锛? %s", exc)

        # 姣忔璁板綍鍚庢鏌ユ槸鍚﹂渶瑕佽Е鍙戝畾鏈熷涔?
        await self._evo_maybe_learn(session_id)

    async def _evo_maybe_learn(self, session_id: str) -> None:
        """瀹氭湡浠?feedback 涓涔犳柊瑙勫垯锛堥粯璁ゆ瘡灏忔椂瑙﹀彂涓€娆★級

        妫€鏌?learner 鏄惁鍙敤锛屽苟鍩轰簬鍙嶉鏃ュ織涓渶杩戠殑鏁版嵁瑙﹀彂瀛︿範銆?
        浣跨敤 _evo_last_learn_time 鎺у埗棰戠巼锛岄伩鍏嶈繃浜庨绻併€?
        """
        if not _LEARN_BUFFER_AVAILABLE or _learn_buffer is None:
            return

        now = time.time()
        if not hasattr(self, "_evo_last_learn_time"):
            self._evo_last_learn_time: float = 0.0

        # 姣忓皬鏃舵渶澶氬涔犱竴娆?
        LEARN_INTERVAL = 3600.0
        if now - self._evo_last_learn_time < LEARN_INTERVAL:
            return

        self._evo_last_learn_time = now

        try:
            if len(_learn_buffer) > 0:
                from src.evolution.learner import EvolutionLearner

                learner = EvolutionLearner()
                buffer_copy = list(_learn_buffer)
                _learn_buffer.clear()
                result = await learner.learn_from_feedback(buffer_copy)
                logger.info(
                    "鈽?[涔綸 瀹氭湡瀛︿範瑙﹀彂: processed=%d terms_updated=%d",
                    result.get("processed", 0),
                    result.get("terms_updated", 0),
                )

                # 瀛︿範瀹屾垚鍚庤Е鍙?evolver 璋冨弬
                await self._evo_maybe_evolve()

        except (ImportError, ModuleNotFoundError, ValueError) as exc:
            logger.debug("鈽?[涔綸 瀹氭湡瀛︿範妫€鏌ュ紓甯革紙闈炶嚧鍛斤級: %s", exc)

    async def _evo_maybe_evolve(self) -> None:
        """鏍规嵁 learner 杈撳嚭鑷姩璋冨弬锛堢煡璇嗗浘璋卞閲忔洿鏂帮級

        褰?learner 鏇存柊浜嗘湳璇潈閲嶅悗锛屾鏌ユ槸鍚﹂渶瑕佽Е鍙戠煡璇嗗浘璋辫繘鍖栥€?
        浠庡弽棣堟棩蹇椾腑鎻愬彇鏂板疄浣撳苟鏇存柊鐭ヨ瘑鍥捐氨銆?
        """
        try:
            from src.evolution.evolver import EvolutionEvolver
            from src.services.learner import load_term_weights

            weights = load_term_weights()

            # 濡傛灉鏈夋樉钁楀彉鍖栫殑鏈锛堟潈閲?> 0.5锛夛紝瑙嗕綔鏂板彂鐜板疄浣?
            new_terms = {k: v for k, v in weights.items() if abs(v) > 0.5}

            if new_terms:
                evolver = EvolutionEvolver()
                # 灏嗛珮棰戞湳璇綔涓哄疄浣撳€欓€夋帹閫佺粰 evolver
                entities = {"term": list(new_terms.keys())}
                result = evolver.evolve(entities, file_name="auto_tune_from_learner")
                if result.get("entities_added", 0) > 0:
                    logger.info(
                        "鈽?[涔綸 鑷姩璋冨弬瀹屾垚: entities_added=%d",
                        result.get("entities_added", 0),
                    )
        except (ImportError, ModuleNotFoundError, ValueError, KeyError) as exc:
            logger.debug("鈽?[涔綸 鑷姩璋冨弬寮傚父锛堥潪鑷村懡锛? %s", exc)

    # ========================================================================
    # 杈呭姪鏂规硶 鈥?缃俊搴﹁绠?& 鏉ユ簮鏀堕泦
    # ========================================================================

    def _compute_confidence(
        self,
        intents_used: List[str],
        fallback_used: bool,
        session: QianSession,
    ) -> float:
        """璁＄畻鏈疆鎬濊€冪殑缃俊搴?

        鍩轰簬浠ヤ笅鍥犵礌鍔犳潈璁＄畻锛?
          - 鏄惁浣跨敤闄嶇骇锛堜弗閲嶆墸鍒嗭級
          - 鎰忓浘鎵ц杞暟锛堣疆鏁拌秺灏戣秺鑷俊锛?
          - 鏄惁鏈夋绱㈢粨鏋滐紙鏈夋棤涓婁笅鏂囷級
          - 鏈€缁堢瓟妗堟槸鍚﹂潪绌?

        Args:
            intents_used:  宸蹭娇鐢ㄧ殑鎰忓浘搴忓垪
            fallback_used: 鏄惁瑙﹀彂闄嶇骇
            session:       褰撳墠浼氳瘽

        Returns:
            缃俊搴?[0.0, 1.0]
        """
        if fallback_used:
            return 0.3

        score = 0.5  # 鍩虹鍒?

        # 鏈夋绱?鈫?鍔犲垎
        if any(i in ("SEARCH", "SEARCH_X") for i in intents_used):
            score += 0.15

        # 鏈夌簿鐐煎喅绛?鈫?鍔犲垎
        if any(i in ("REFINE", "DECIDE") for i in intents_used):
            score += 0.10

        # 杞暟鎯╃綒锛堣疆鏁拌秺澶氭墸鍒嗚秺澶氾級
        rounds = len(intents_used)
        if rounds <= 3:
            score += 0.10
        elif rounds <= 5:
            score += 0.05
        else:
            score -= 0.05 * (rounds - 5)

        # 鏈夋渶缁堢瓟妗?鈫?鍔犲垎
        if session.final_answer and len(session.final_answer) > 20:
            score += 0.10

        # 鏈変笂涓嬫枃 鈫?鍔犲垎
        if session.accumulated_context:
            score += 0.05

        return min(max(round(score, 2), 0.0), 1.0)

    @staticmethod
    def _collect_sources(session: QianSession) -> List[str]:
        """浠庝細璇濈疮绉笂涓嬫枃涓彁鍙栨潵婧愬垪琛?

        鍘婚噸骞惰繃婊ゆ帀寮傚父鏉ユ簮锛堝 '[鎵ц寮傚父]'锛夛紝杩斿洖骞插噣鏉ユ簮鍒楄〃銆?

        Args:
            session: 褰撳墠浼氳瘽

        Returns:
            鏉ユ簮瀛楃涓插垪琛紝濡?["SEARCH(绂诲崷)", "REFINE(宸藉崷)"]
        """
        seen: set = set()
        sources: list = []
        for item in session.accumulated_context:
            source = item.get("source", "")
            if source and source not in seen and "[鎵ц寮傚父]" not in source:
                seen.add(source)
                sources.append(source)
        return sources

    # ========================================================================
    # 鍐呴儴鏂规硶 鈥?LLM 鍐崇瓥
    # ========================================================================

    async def _decide(
        self,
        query: str,
        history: List[Dict[str, str]],
        context: str,
        round_num: int,
        suggestion: Optional[str] = None,
        session: Optional[QianSession] = None,
        kun_history_summary: str = "",
    ) -> Dict[str, Any]:
        """鎰忓浘鍐崇瓥锛堟敮鎸?5 闃舵 intent_mode + 棰勫姞杞界紦瀛?+ 涓婁笅鏂囨劅鐭ワ級

        intent_mode 鍐冲畾鏄惁璋冪敤 LLM锛?
          - "rule_based"锛堥粯璁わ級锛氳蛋鍥哄畾瑙勫垯锛屼笉璋?LLM锛堝畨鍏ㄨ捣姝ワ級
          - "shadow"锛歀LM 浜х敓鎰忓浘 鈫?璁板綍宸紓鏃ュ織 鈫?瀹為檯鎵ц鍥哄畾瑙勫垯
          - "low_risk"锛氫綆椋庨櫓鍦烘櫙璋?LLM锛屽叾浠栫敤瑙勫垯
          - "medium_risk"锛氬ぇ閮ㄥ垎璋?LLM锛岄珮椋庨櫓浠嶇敤瑙勫垯
          - "full_llm"锛氬叏閮ㄨ皟 LLM 鍐崇瓥

        Args:
            query:                鐢ㄦ埛鍘熷鎻愰棶
            history:              瀵硅瘽鍘嗗彶
            context:              绱Н涓婁笅鏂囷紙涔嬪墠鍚勫崷杩斿洖鐨勭粨鏋滄眹鎬伙級
            round_num:            褰撳墠杞暟锛?-based锛?
            suggestion:           SafetyCruise 寤鸿鏂囨湰锛堝彲閫夛級
            session:              褰撳墠 QianSession锛堢敤浜庢敞鍏ヨ繍琛屾椂鐘舵€侊級
            kun_history_summary:  鍧ゅ崷瀵硅瘽鍘嗗彶鎽樿锛堜笂涓嬫枃鎰熺煡锛?

        Returns:
            {"intent": "SEARCH|...|DONE", "confidence": 0.85, "reasoning": "..."}
        """
        # ---- intent_mode 鍒嗘敮 ----
        if self._intent_mode == "rule_based":
            return self._decide_fixed_rule(round_num, context, suggestion)

        if self._intent_mode == "shadow":
            # 褰卞瓙妯″紡锛歀LM 浜х敓鎰忓浘 鈫?璁板綍鏃ュ織 鈫?瀹為檯鎵ц鍥哄畾瑙勫垯
            rule_decision = self._decide_fixed_rule(round_num, context, suggestion)
            # 寮傛璁板綍 LLM 鍐崇瓥锛堜笉闃诲锛?
            asyncio.ensure_future(
                self._shadow_compare(
                    query=query,
                    history=history,
                    context=context,
                    round_num=round_num,
                    suggestion=suggestion,
                    session=session,
                    kun_history_summary=kun_history_summary,
                    rule_decision=rule_decision,
                )
            )
            return rule_decision

        # ---- low_risk / medium_risk / full_llm: LLM 椹卞姩璺緞 ----
        # ---- 棣栬疆鎰忓浘棰勫姞杞界紦瀛樻鏌ワ紙浠?R1 妫€娴嬶紝鍑忓皯 LLM 璋冪敤锛?---
        if round_num == 1:
            preload_intent = _match_intent_preload(query.strip(), self._intent_preload_cache)
            if preload_intent and preload_intent in AVAILABLE_TRIGRAMS:
                logger.info(
                    "鈽?[涔綸 鎰忓浘棰勫姞杞藉懡涓? query='%s...' 鈫?intent=%s",
                    query.strip()[:30],
                    preload_intent,
                )
                # 璁板綍鍐崇瓥鏃ュ織
                self._log_intent_decision(
                    session_id=session.session_id if session else "unknown",
                    query=query,
                    intent=preload_intent,
                    confidence=0.98,
                    reasoning="棰勫姞杞界紦瀛樺懡涓?,
                )
                return {
                    "intent": preload_intent,
                    "confidence": 0.98,
                    "reasoning": "棰勫姞杞界紦瀛樺懡涓?,
                }

        # ---- LLM 椹卞姩璺緞 ----
        # 鏋勫缓杩愯鏃剁姸鎬佹憳瑕侊紙娉ㄥ叆鍒扮郴缁?Prompt锛?
        runtime_state = self._build_runtime_state(round_num, session)
        filled_prompt = _QIAN_SYSTEM_PROMPT.replace("{runtime_state}", runtime_state)

        # 鏋勫缓 user message
        parts: List[str] = [f"## 鐢ㄦ埛鍘熷鎻愰棶\n{query}\n"]

        # ---- 涓婁笅鏂囨劅鐭ワ細娉ㄥ叆鍧ゅ崷瀵硅瘽鍘嗗彶鎽樿 ----
        if kun_history_summary and round_num == 1:
            parts.append(f"## 瀵硅瘽鍘嗗彶涓婁笅鏂嘰n{kun_history_summary}\n")
            parts.append(
                "## 涓婁笅鏂囨劅鐭ユ寚寮昞n"
                "- 鑻ュ巻鍙蹭笂涓嬫枃涓嚭鐜颁笌褰撳墠鎻愰棶绱у瘑鐩稿叧鐨勫璇濓紝鍒欒繖寰堝彲鑳芥槸杩介棶锛?
                "璇蜂紭鍏堟部鐢ㄤ笌鍘嗗彶鐩稿悓鐨勬绱㈢瓥鐣ワ紙SEARCH 鈫?...锛塡n"
                "- 鑻ュ巻鍙蹭笂涓嬫枃涓庡綋鍓嶆彁闂棤鏄庢樉鍏宠仈锛屽垯杩欐槸鏂拌瘽棰橈紝"
                "璇锋寜甯歌棣栬疆鍐崇瓥鏂瑰紡澶勭悊\n"
            )

        if context and context != "锛堝皻鏃犱笂涓嬫枃淇℃伅锛?:
            parts.append(f"## 宸茶幏鍙栫殑淇℃伅\n{context}\n")

        parts.append(f"## 褰撳墠鐘舵€乗n绗?{round_num}/{self.MAX_ROUNDS} 杞甛n")

        if suggestion:
            parts.append(f"## 鎻愮ず\n{suggestion}\n")

        parts.append("璇疯緭鍑轰笅涓€姝ュ喅绛栵紙浠?JSON锛夛細")
        user_message = "\n".join(parts)

        try:
            raw = await self._call_llm_with_retry(
                system_prompt=filled_prompt,
                user_message=user_message,
                max_tokens=200,
                temperature=0.1,
                task_type="planning",
                session_id=session.session_id if session else "default",
            )

            if not raw:
                logger.warning("鈽?[涔綸 LLM 杩斿洖绌猴紝浣跨敤鍐崇瓥鍏滃簳")
                return self._decide_fallback(round_num)

            parsed = self._parse_decide_output(raw, round_num)

            # ---- 鍐崇瓥鏃ュ織璁板綍 ----
            self._log_intent_decision(
                session_id=session.session_id if session else "unknown",
                query=query,
                intent=parsed.get("intent", "UNKNOWN"),
                confidence=float(parsed.get("confidence", 0.5)),
                reasoning=str(parsed.get("reasoning", ""))[:100],
            )

            return parsed

        except (ImportError, ModuleNotFoundError, json.JSONDecodeError, ValueError, KeyError) as exc:
            logger.error("鈽?[涔綸 LLM 璋冪敤寮傚父: %s", exc)
            return self._decide_fallback(round_num)

    # ========================================================================
    # 鍐呴儴鏂规硶 鈥?杩愯鏃剁姸鎬佹憳瑕?
