class SafetyCruise:
    """瀹夊叏宸¤埅 鈥?CycleGuard 杩炵画鎷︽埅 >2 娆″悗鎺ョ锛屾寜鍥哄畾娴佹按绾挎墽琛?

    Attributes:
        FIXED_SEQUENCE: 鍥哄畾鎵ц搴忓垪 [SEARCH, REFINE, DECIDE, PRESENT, DONE]
    """

    FIXED_SEQUENCE: List[str] = list(FIXED_PIPELINE)

    def __init__(self) -> None:
        self._sequence_index: int = 0
        self._active: bool = False

    @property
    def is_active(self) -> bool:
        """鏄惁宸叉縺娲伙紙鎺ョ涓級"""
        return self._active

    def activate(self) -> None:
        """婵€娲?SafetyCruise 鈥?寮€濮嬪浐瀹氭祦姘寸嚎"""
        self._active = True
        self._sequence_index = 0
        logger.warning("[SafetyCruise] 鎺ョ鍚姩锛屾墽琛屽浐瀹氭祦姘寸嚎 %s", self.FIXED_SEQUENCE)

    def deactivate(self) -> None:
        """鍋滅敤 SafetyCruise"""
        self._active = False
        self._sequence_index = 0

    def reset(self) -> None:
        """閲嶇疆鐘舵€侊紙鍋滅敤 + 绱㈠紩褰掗浂锛?""
        self._active = False
        self._sequence_index = 0

    def suggest(self, state: CycleGuardState) -> Optional[str]:
        """缁?LLM 鐨勫缓璁紙鎻愮ず鎬э紝涓嶅己鍒舵帴绠★級

        褰?SafetyCruise 宸叉縺娲讳絾杩樻病鍒板簭鍒楃粓鐐规椂锛?
        缁欏嚭鏀舵潫寤鸿銆?

        Args:
            state: 褰撳墠寰幆鐘舵€?

        Returns:
            寤鸿鏂囨湰锛屾垨 None锛堟殏鏃犲缓璁級
        """
        if not self._active:
            return None

        r = state.round_count + 1
        remaining = len(self.FIXED_SEQUENCE) - self._sequence_index
        if remaining > 0:
            return (
                f"SafetyCruise 寤鸿锛氬綋鍓嶇 {r} 杞紝"
                f"寤鸿鎵ц娴佹按绾挎楠?{self._sequence_index+1}/{len(self.FIXED_SEQUENCE)}: "
                f"{self.FIXED_SEQUENCE[self._sequence_index]}"
            )
        return "褰撳墠宸插埌鏈€鍚庝竴杞紝璇峰敖蹇緭鍑?DONE銆?

    def override(self, state: CycleGuardState) -> Optional[Dict[str, Any]]:
        """寮哄埗鎸夊浐瀹氬簭鍒楄繑鍥炰笅涓€姝ユ剰鍥?

        鎸?FIXED_SEQUENCE 椤哄簭渚濇杈撳嚭鎰忓浘銆?
        搴忓垪鎵ц瀹屾瘯鍚庤緭鍑?DONE 骞惰嚜鍔ㄥ仠鐢ㄣ€?

        Args:
            state: 褰撳墠寰幆鐘舵€?

        Returns:
            {"intent": "...", "confidence": 1.0, "reasoning": "..."} 鎴?None锛堟湭婵€娲伙級
        """
        if not self._active:
            return None

        if self._sequence_index >= len(self.FIXED_SEQUENCE):
            self.deactivate()
            return {"intent": "DONE", "confidence": 1.0, "reasoning": "鍥哄畾娴佹按绾垮畬鎴?}

        intent = self.FIXED_SEQUENCE[self._sequence_index]
        self._sequence_index += 1

        return {
            "intent": intent,
            "confidence": 0.95,
            "reasoning": f"SafetyCruise step {self._sequence_index}/{len(self.FIXED_SEQUENCE)}",
        }


