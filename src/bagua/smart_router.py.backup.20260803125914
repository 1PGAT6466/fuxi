def route_sync(
    user_input: str,
    context: Optional[List[Dict[str, str]]] = None,
) -> RoutingDecision:
    """鍚屾鍖呰鍣紝鍐呴儴杩愯 asyncio event loop"""
    try:
        loop = asyncio.get_event_loop()
        if loop.is_running():
            import nest_asyncio

            nest_asyncio.apply()
        return loop.run_until_complete(route(user_input, context))
    except RuntimeError:
        return asyncio.run(route(user_input, context))


