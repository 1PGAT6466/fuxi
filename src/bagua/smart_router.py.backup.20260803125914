async def route_to_qian_intent(
    user_input: str,
    context: Optional[List[Dict[str, str]]] = None,
) -> Optional[Dict[str, Any]]:
    """
    缁熶竴妗ユ帴锛歴mart_router 缁撴灉 鈫?qian 鍏崷鎰忓浘

    褰?smart_router L1-L5 楂樼疆淇″害鍛戒腑鏃讹紝鐩存帴鏄犲皠涓?qian 鎰忓浘锛?
    璺宠繃涔惧崷 LLM 鍐崇瓥锛岄檷浣庡欢杩熷拰鎴愭湰銆?

    Args:
        user_input: 鐢ㄦ埛杈撳叆
        context: 瀵硅瘽涓婁笅鏂?

    Returns:
        {
            "intent": "SEARCH|DECIDE|PRESENT|...",
            "confidence": float,
            "reasoning": str,
            "source": "smart_router_bridge",
            "router_level": int,
        }
        鎴?None锛堟湭鍛戒腑 / 缃俊搴︿笉瓒筹紝搴旇蛋 qian 瀹屾暣寰幆锛?
    """
    decision = await route(user_input, context)

    # 浠呴珮缃俊搴︾粨鏋滄墠妗ユ帴
    if decision.should_upgrade or decision.confidence < 0.85:
        return None

    # 浠?result 涓彁鍙栨剰鍥?
    intent = None
    if isinstance(decision.result, dict):
        intent = decision.result.get("intent", "")
    elif isinstance(decision.result, str):
        # L1 鍏抽敭璇嶇洿鎺ュ洖澶?鈫?璧?PRESENT
        intent = "chat"

    if not intent:
        return None

    qian_intent = _INTENT_TO_QIAN_INTENT.get(intent, "PRESENT")

    return {
        "intent": qian_intent,
        "confidence": decision.confidence,
        "reasoning": f"smart_router L{decision.level} 妗ユ帴: {intent}鈫抺qian_intent}",
        "source": "smart_router_bridge",
        "router_level": decision.level,
        "original_intent": intent,
    }


