    def digest_and_store(
        self,
        file_path: str,
        store_in_kun: bool = True,
    ) -> Dict[str, Any]:
        """绔埌绔枃浠舵秷鍖栵紙閲嶆瀯 v1.50锛?""
        start_time = time.time()
        errors: List[str] = []
        result: Dict[str, Any] = {
            "ok": False,
            "file_path": file_path,
            "file_hash": "",
            "chunks_count": 0,
            "digested": False,
            "duration_ms": 0,
            "errors": [],
        }

        path = Path(file_path)
        if not path.exists():
            errors.append(f"鏂囦欢涓嶅瓨鍦? {file_path}")
            result["errors"] = errors
            return result

        # Step 0: 鎸囩汗妫€娴?
        file_hash = self._check_file_fingerprint(file_path, result)
        if file_hash is None:
            result["duration_ms"] = (time.time() - start_time) * 1000
            return result

        try:
            # Step 1: 瑙ｆ瀽
            parsed = self._parse_file_content(file_path, errors)
            if parsed is None:
                result["errors"] = errors
                result["duration_ms"] = (time.time() - start_time) * 1000
                return result

            raw_text = parsed.get("text", "")
            if not raw_text.strip():
                errors.append("鏂囦欢瑙ｆ瀽缁撴灉涓虹┖")
                result["errors"] = errors
                result["duration_ms"] = (time.time() - start_time) * 1000
                return result

            # Step 2: 娓呮礂
            cleaned_text = self._clean_parsed_content(parsed, errors)

            # Step 3: 鍒嗗潡
            chunks = self._chunk_parsed_content(parsed, cleaned_text, errors)

            # Step 4: 鍒嗙被
            self._classify_chunks(chunks)

            # Step 5: 璁剧疆鍏冩暟鎹?
            self._set_chunk_metadata(chunks, file_hash, file_path)

            # Step 6: 鍚戦噺鍖?
            import asyncio

            loop = asyncio.get_event_loop()
            if loop.is_running():
                asyncio.ensure_future(self._embed_chunks_async(chunks, errors))
            else:
                loop.run_until_complete(self._embed_chunks_async(chunks, errors))

            # Step 7: 瀛樺偍
            if loop.is_running():
                asyncio.ensure_future(self._save_chunks_async(chunks, errors))
            else:
                loop.run_until_complete(self._save_chunks_async(chunks, errors))

            result["chunks_count"] = len(chunks)
            self._digested_count += 1
            self._fingerprint_cache[file_path] = file_hash
            self._dirty = False

            # Step 8: 鍧ゅ崷瀛樺偍
            if store_in_kun:
                self._store_to_kun_gua(file_path, chunks, cleaned_text, errors)

            result["ok"] = True
            result["digested"] = True
            result["errors"] = errors
            result["duration_ms"] = (time.time() - start_time) * 1000

            logger.info(
                "[%s] 娑堝寲瀹屾垚: %s 鈫?%d chunks, %.0fms",
                self.GUA_NAME,
                file_path,
                len(chunks),
                result["duration_ms"],
            )
            return result

        except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
            logger.error("[%s] 娑堝寲寮傚父: %s 鈥?%s", self.GUA_NAME, file_path, e, exc_info=True)
            errors.append(f"DigestError: {e}")
            result["errors"] = errors
            result["duration_ms"] = (time.time() - start_time) * 1000
            return result

    def batch_digest(
        self,
        file_paths: List[str],
        store_in_kun: bool = True,
    ) -> Dict[str, Any]:
        """鎵归噺娑堝寲澶氫釜鏂囦欢

        Args:
            file_paths: 鏂囦欢璺緞鍒楄〃
            store_in_kun: 鏄惁瀛樺叆鍧ゅ崷鐭ヨ瘑搴?

        Returns:
            {
                "ok": True,
                "total_files": int,
                "digested": int,
                "skipped": int,
                "failed": int,
                "results": [...],
            }
        """
        results = []
        digested = 0
        skipped = 0
        failed = 0

        for fp in file_paths:
            r = self.digest_and_store(fp, store_in_kun=store_in_kun)
            results.append(r)
            if r.get("digested"):
                digested += 1
            elif r.get("ok"):
                skipped += 1
            else:
                failed += 1

        return {
            "ok": failed == 0,
            "total_files": len(file_paths),
            "digested": digested,
            "skipped": skipped,
            "failed": failed,
            "results": results,
        }

    def _store_to_kun(
        self,
        file_path: str,
        chunks: list,
        cleaned_text: str,
    ) -> None:
        """灏嗘秷鍖栫粨鏋滃瓨鍏ュ潳鍗︾煡璇嗗簱

        璋冪敤鍧ゅ崷鐨?store_vector / store_wiki / build_knowledge_graph
        寤虹珛瀹屾暣鐨勭煡璇嗗瓨鍌ㄩ摼璺€?

        Args:
            file_path: 婧愭枃浠惰矾寰?
            chunks: 鍒嗗潡鍒楄〃
            cleaned_text: 娓呮礂鍚庣殑鏂囨湰
        """
        try:
            from src.bagua.kun import KunGua

            # 浠庡叏灞€涓婁笅鏂囪幏鍙栧潳鍗﹀疄渚嬶紝鎴栧垱寤烘柊瀹炰緥
            kun = _get_kun_instance()
            if kun is None:
                logger.warning("[%s] 鍧ゅ崷瀹炰緥涓嶅彲鐢紝璺宠繃鐭ヨ瘑搴撳瓨鍌?, self.GUA_NAME)
                return

            file_name = Path(file_path).name
            file_hash = self.compute_file_fingerprint(file_path)
            doc_id = file_hash[:16] if file_hash else file_name

            # 1. 瀛樺偍鍚戦噺
            vectorized_chunks = [c for c in chunks if hasattr(c, "embedding") and c.embedding]
            if vectorized_chunks:
                kun.store_vector(
                    doc_id=doc_id,
                    chunks=vectorized_chunks,
                    metadata={
                        "source_file": file_path,
                        "file_name": file_name,
                        "file_hash": file_hash,
                    },
                )

            # 2. 瀛樺偍 Wiki
            kun.store_wiki(
                doc_id=doc_id,
                content=cleaned_text,
                title=file_name,
                source=file_path,
                category=chunks[0].category if chunks else "閫氱敤鍔炲叕",
            )

            # 3. 鏋勫缓鐭ヨ瘑鍥捐氨
            kun.build_knowledge_graph(doc_id=doc_id)

            logger.info("[%s] 鍧ゅ崷鐭ヨ瘑搴撳凡鏇存柊: %s", self.GUA_NAME, doc_id)

        except Exception as e:  # TODO: Narrow exception type
            logger.warning("[%s] _store_to_kun 寮傚父: %s", self.GUA_NAME, e)

