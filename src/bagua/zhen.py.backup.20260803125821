    def _classify_chunks(self, chunks: list) -> None:
        """瀵?chunks 杩涜鍒嗙被"""
        from src.pipeline.unified import UnifiedClassifier

        classifier = UnifiedClassifier({})
        for chunk in chunks:
            try:
                chunk.category = classifier.classify(chunk)
            except (OSError, ValueError, KeyError, ConnectionError, TimeoutError):
                chunk.category = "閫氱敤鍔炲叕"

    def _set_chunk_metadata(self, chunks: list, file_hash: str, file_path: str) -> None:
        """璁剧疆 chunks 鍏冩暟鎹?""
        path = Path(file_path)
        for chunk in chunks:
            chunk.file_hash = file_hash
            chunk.file_name = path.name
            chunk.file_type = path.suffix.lower()
            chunk.source_pipeline = "zhen_digest"
            chunk.source_file = str(path)

    async def _embed_chunks_async(self, chunks: list, errors: list) -> None:
        """寮傛鍚戦噺鍖?chunks"""
        embedder_cb = self.get_dependency("embedder_server")
        if embedder_cb and not embedder_cb.is_healthy:
            logger.warning("[%s] embedder_server 鏂矾鍣ㄦ柇寮€锛岃烦杩囧悜閲忓寲", self.GUA_NAME)
            errors.append("embedder_server 鏂矾鍣ㄦ柇寮€锛岃烦杩囧悜閲忓寲")
            return

        try:
            from src.pipeline.unified import UnifiedEmbedder

            # 濡傛灉 chunks 宸叉湁 embedding锛岃烦杩?
            if chunks and hasattr(chunks[0], "embedding") and chunks[0].embedding is not None:
                return

            embedder = UnifiedEmbedder({})
            embeddings = await embedder.embed_batch([c.text for c in chunks])
            if embeddings:
                for chunk, emb in zip(chunks, embeddings):
                    if emb is not None:
                        chunk.embedding = emb
            if embedder_cb:
                embedder_cb.record_success()
        except (ConnectionError, TimeoutError, OSError, ValueError) as e:
            if embedder_cb:
                embedder_cb.record_failure()
            logger.warning("[%s] 鍚戦噺鍖栧け璐? %s", self.GUA_NAME, e)
            errors.append(f"EmbedWarning: {e}")

