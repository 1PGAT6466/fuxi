    def track_upload_progress(self, params: Dict[str, Any]) -> Dict[str, Any]:
        """璁板綍澶ф枃浠朵笂浼犺繘搴?

        鐢辫皟鐢ㄦ柟鍦ㄤ笂浼犺繃绋嬩腑瀹氭湡璋冪敤锛屾洿鏂版寚瀹氭枃浠剁殑杩涘害銆?
        杩涘害鏁版嵁鍐欏叆 in-memory dict锛岀敱 get_upload_progress 鏌ヨ銆?

        Args:
            params: {
                "file_path": str,   # 鏂囦欢璺緞/鏍囪瘑
                "progress": float,  # 杩涘害 [0.0, 1.0]
                "status": str,      # "uploading"|"processing"|"done"|"error"
                "message": str,     # 闄勫甫淇℃伅
            }

        Returns:
            {"ok": bool, "file_path": str, "progress": float}
        """
        file_path = params.get("file_path", "")
        if not file_path:
            return {"ok": False, "error": "缂哄皯 file_path"}

        if not hasattr(self, "_upload_progress"):
            self._upload_progress: Dict[str, Dict[str, Any]] = {}

        progress = max(0.0, min(1.0, float(params.get("progress", 0))))
        self._upload_progress[file_path] = {
            "progress": progress,
            "status": params.get("status", "uploading"),
            "message": params.get("message", ""),
            "updated_at": time.time(),
        }

        # 骞挎挱杩涘害鍙樺寲锛堥€氳繃 IntentBus 閫氱煡鍏戝崷锛?
        try:
            self._broadcast_progress(file_path, progress, params.get("status", ""), params.get("message", ""))
        except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:  # TODO: Narrow exception type
            pass

        return {
            "ok": True,
            "file_path": file_path,
            "progress": round(progress, 4),
        }

    def get_upload_progress(self, file_path: str) -> Dict[str, Any]:
        """鏌ヨ鏂囦欢鐨勪笂浼犺繘搴?

        Args:
            file_path: 鏂囦欢璺緞/鏍囪瘑

        Returns:
            {"progress": float, "status": str, ...} 鎴?{"error": "not_found"}
        """
        if not hasattr(self, "_upload_progress"):
            return {"error": "not_found", "message": "鏃犱笂浼犺褰?}

        entry = self._upload_progress.get(file_path)
        if entry is None:
            return {"error": "not_found", "message": f"鏈壘鍒版枃浠? {file_path}"}

        return dict(entry)

    def _broadcast_progress(self, file_path: str, progress: float, status: str, message: str) -> None:
        """閫氳繃 IntentBus 骞挎挱杩涘害淇″彿鍒板厬鍗?""
        try:
            self._intent_bus.send_progress(
                session_id="upload",
                source="闇?,
                target="鍏?,
                progress=progress,
                message=f"{file_path}: {status} 鈥?{message}"[:100],
            )
        except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:  # TODO: Narrow exception type
            pass

