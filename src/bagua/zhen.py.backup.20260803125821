    def _check_file_fingerprint(self, file_path: str, result: Dict) -> Optional[str]:
        """妫€鏌ユ枃浠舵寚绾癸紝杩斿洖 None 琛ㄧず闇€瑕佸鐞嗭紝杩斿洖 hash 琛ㄧず璺宠繃"""
        file_hash = self.compute_file_fingerprint(file_path)
        cached_fp = self._fingerprint_cache.get(file_path, "")
        result["file_hash"] = file_hash

        if file_hash and file_hash == cached_fp and cached_fp:
            logger.info("[%s] 鏂囦欢鏈彉鍖栵紝璺宠繃娑堝寲: %s", self.GUA_NAME, file_path)
            result["ok"] = True
            result["digested"] = False
            result["message"] = "鏂囦欢鏈彉鍖栵紝璺宠繃"
            self._check_count += 1
            return None
        return file_hash

    def _parse_file_content(self, file_path: str, errors: list) -> Optional[Dict]:
        """瑙ｆ瀽鏂囦欢鍐呭锛岃繑鍥?parsed dict 鎴?None"""
        from src.pipeline.unified import UnifiedParser

        parser = UnifiedParser({})

        file_io_cb = self.get_dependency("file_io")
        if file_io_cb and not file_io_cb.is_healthy:
            logger.warning("[%s] file_io 鏂矾鍣ㄦ柇寮€锛岃烦杩囨枃浠惰В鏋? %s", self.GUA_NAME, file_path)
            errors.append("file_io 鏂矾鍣ㄦ柇寮€")
            return None

        try:
            parsed = parser.parse(file_path)
            if file_io_cb:
                file_io_cb.record_success()
            return parsed
        except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
            if file_io_cb:
                file_io_cb.record_failure()
            raise

    def _clean_parsed_content(self, parsed: Dict, errors: list) -> str:
        """娓呮礂瑙ｆ瀽鍐呭"""
        from src.pipeline.unified import UnifiedCleaner

        cleaner = UnifiedCleaner({})
        raw_text = parsed.get("text", "")

        try:
            cleaned = cleaner.clean(parsed)
            return cleaned.get("text", raw_text)
        except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
            logger.warning("[%s] 娓呮礂澶辫触锛屼娇鐢ㄥ師鏂? %s", self.GUA_NAME, e)
            errors.append(f"CleanWarning: {e}")
