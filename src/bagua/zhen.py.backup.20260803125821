    def compute_file_fingerprint(self, file_path: str) -> str:
        """璁＄畻鏂囦欢鎸囩汗

        浣跨敤 MD5 璁＄畻鏂囦欢鍐呭鐨?hash 浣滀负鎸囩汗銆?
        濡傛灉鏂囦欢涓嶅瓨鍦ㄦ垨鏃犳硶璇诲彇锛岃繑鍥炵┖瀛楃涓层€?

        Args:
            file_path: 鏂囦欢璺緞

        Returns:
            鏂囦欢鍐呭鐨?MD5 hash锛?2 浣?hex 瀛楃涓诧級锛屽け璐ユ椂杩斿洖 ""
        """
        try:
            with open(file_path, "rb") as f:
                content = f.read()
            return hashlib.sha256(content).hexdigest()
        except FileNotFoundError:
            logger.debug("[%s] 鏂囦欢涓嶅瓨鍦紝fingerprint='': %s", self.GUA_NAME, file_path)
            return ""
        except PermissionError:
            logger.warning("[%s] 鏃犳潈闄愯鍙栨枃浠? %s", self.GUA_NAME, file_path)
            return ""
        except OSError as e:
            logger.warning("[%s] 鏂囦欢璇诲彇澶辫触: %s 鈥?%s", self.GUA_NAME, file_path, e)
            return ""
        except Exception as e:  # TODO: Narrow exception type
            logger.error(
                "[%s] compute_file_fingerprint 寮傚父: %s 鈥?%s",
                self.GUA_NAME,
                file_path,
                e,
                exc_info=True,
            )
            return ""

    def check_file_changed(self, file_path: str) -> bool:
        """妫€娴嬫枃浠舵槸鍚﹀彂鐢熷彉鍖?

        瀵规瘮褰撳墠鏂囦欢鎸囩汗涓庣紦瀛樹腑鐨勪笂涓€杞寚绾广€?
        棣栨妫€娴嬶紙鏃犵紦瀛橈級鏃惰涓烘湁鍙樺寲銆?
        姣忔妫€娴嬪悗鑷姩鏇存柊鎸囩汗缂撳瓨锛堝榻愯偤鐨?_inhale 琛屼负锛夈€?

        鍓綔鐢細
          - 鏇存柊 _dirty 鏍囪
          - 鏇存柊 _fingerprint_cache

        Args:
            file_path: 鏂囦欢璺緞

        Returns:
            True 琛ㄧず鏂囦欢鏈夊彉鍖栨垨棣栨妫€娴嬶紝False 琛ㄧず鏃犲彉鍖?
        """
        self._check_count += 1

        current_fp = self.compute_file_fingerprint(file_path)
        cached_fp = self._fingerprint_cache.get(file_path, "")

        # 姣忔妫€娴嬮兘鏇存柊鎸囩汗缂撳瓨锛堝榻愯偤鐨?_inhale 鈫?self._last_fingerprint = fingerprint锛?
        self._fingerprint_cache[file_path] = current_fp

        # 鏍囪鑴忔暟鎹?
        if current_fp != cached_fp:
            self._dirty = True
            self._change_count += 1
            logger.info(
                "[%s] 鏂囦欢宸插彉鍖? %s (fp: %s... 鈫?%s...)",
                self.GUA_NAME,
                file_path,
                cached_fp[:16] if cached_fp else "<none>",
                current_fp[:16] if current_fp else "<empty>",
            )
            return True

        logger.debug("[%s] 鏂囦欢鏃犲彉鍖? %s", self.GUA_NAME, file_path)
        return False

    def on_file_digested(self, file_path: str) -> None:
        """鏂囦欢娑堝寲瀹屾垚鍚庢洿鏂版寚绾圭紦瀛?

        褰撴枃浠跺唴瀹瑰凡琚秷璐?钂搁鍚庤皟鐢ㄦ鏂规硶锛?
        灏嗗綋鍓嶆寚绾瑰啓鍏ョ紦瀛橈紝骞舵竻闄よ剰鏍囪銆?

        Args:
            file_path: 鏂囦欢璺緞
        """
        current_fp = self.compute_file_fingerprint(file_path)
        self._fingerprint_cache[file_path] = current_fp
        self._dirty = False
        self._digested_count += 1
        logger.info(
            "[%s] 鏂囦欢宸叉秷鍖栵紝鎸囩汗宸叉洿鏂? %s 鈫?%s",
            self.GUA_NAME,
            file_path,
            current_fp[:16] if current_fp else "<empty>",
        )

