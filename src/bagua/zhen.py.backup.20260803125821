    def _execute_core(self, params: Dict[str, Any]) -> Any:
        """鏍稿績鎺ㄩ€侀€昏緫

        params:
          - action: "push" | "notify" | "broadcast" | "check_file" | "digest_file" |
                    "digest_and_store" | "batch_digest"
          - file_path: 鏂囦欢璺緞锛坈heck_file / digest_file / digest_and_store 鏃跺繀闇€锛?
          - message: 鎺ㄩ€佹秷鎭紙push 鏃朵娇鐢級
          - event: 浜嬩欢鏁版嵁锛坆roadcast 鏃朵娇鐢級
          - store_in_kun: 鏄惁灏嗘秷鍖栫粨鏋滃瓨鍏ュ潳鍗︼紙digest_and_store 鏃讹紝榛樿 True锛?
          - file_paths: 鎵归噺鏂囦欢璺緞鍒楄〃锛坆atch_digest 鏃讹級
        """
        action = params.get("action", "")

        if action == "check_file":
            file_path = params.get("file_path", "")
            if not file_path:
                raise ValueError("check_file 闇€瑕?file_path 鍙傛暟")
            return self.check_file_changed(file_path)

        if action == "digest_file":
            file_path = params.get("file_path", "")
            if not file_path:
                raise ValueError("digest_file 闇€瑕?file_path 鍙傛暟")
            self.on_file_digested(file_path)
            return {"ok": True, "file_path": file_path}

        if action == "digest_and_store":
            file_path = params.get("file_path", "")
            if not file_path:
                raise ValueError("digest_and_store 闇€瑕?file_path 鍙傛暟")
            store_in_kun = params.get("store_in_kun", True)
            return self.digest_and_store(file_path, store_in_kun=store_in_kun)

        if action == "batch_digest":
            file_paths = params.get("file_paths", [])
            if not file_paths:
                raise ValueError("batch_digest 闇€瑕?file_paths 鍙傛暟")
            store_in_kun = params.get("store_in_kun", True)
            return self.batch_digest(file_paths, store_in_kun=store_in_kun)

        if action == "fingerprint":
            file_path = params.get("file_path", "")
            if not file_path:
                raise ValueError("fingerprint 闇€瑕?file_path 鍙傛暟")
            return self.compute_file_fingerprint(file_path)

        if action == "stats":
            return self.stats()

        if action == "upload_progress":
            return self.track_upload_progress(params)

        if action == "get_progress":
            return self.get_upload_progress(params.get("file_path", ""))

        # 榛樿锛氭帹閫?閫氱煡/骞挎挱 鈥?Phase 0 鍗犱綅妯″紡
        message = params.get("message", "")
        event = params.get("event", {})
        logger.info(
            "[%s] 鎺ㄩ€佽姹? action=%s, message=%s, event=%s",
            self.GUA_NAME,
            action,
            message,
            event,
        )
        return {
            "ok": True,
            "action": action,
            "message": message,
            "event": event,
            "timestamp": time.time(),
        }

