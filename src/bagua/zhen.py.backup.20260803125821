    def _chunk_parsed_content(self, parsed: Dict, cleaned_text: str, errors: list) -> list:
        """鍒嗗潡澶勭悊"""
        from src.models.chunk import Chunk
        from src.pipeline.unified import UnifiedChunker

        chunker = UnifiedChunker({})

        try:
            tables = parsed.get("tables", [])
            return chunker.chunk(parsed, tables)
        except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
            logger.warning("[%s] 鍒嗗潡澶辫触锛岄檷绾т负鍗曞潡: %s", self.GUA_NAME, e)
            errors.append(f"ChunkWarning: {e}")
