"""
cache.py 鈥?璇箟缂撳瓨鏈嶅姟 (RAG 3.0)
涓ゅ眰缂撳瓨绛栫暐:
  L1: 绮剧‘鍖归厤 (query string 鈫?results)
  L2: 璇箟鐩镐技鍖归厤 (query embedding 浣欏鸡鐩镐技搴?> 0.92)
"""

import asyncio
import hashlib
import logging
import os
import time
from collections import OrderedDict
from typing import Optional

logger = logging.getLogger(__name__)

# LRU 缂撳瓨閰嶇疆 - 浠庣幆澧冨彉閲忚鍙?
MAX_CACHE_SIZE = int(os.getenv("FUXI_CACHE_MAX_SIZE", "500"))
MAX_CACHE_AGE_SECONDS = int(os.getenv("FUXI_CACHE_MAX_AGE_SECONDS", "7200"))
SIMILARITY_THRESHOLD = 0.92  # 璇箟鍖归厤闃堝€?
CACHE_ENABLED = os.getenv("FUXI_CACHE_ENABLED", "true").lower() == "true"

_l1_cache: OrderedDict = OrderedDict()  # exact match
_l2_cache: list = []  # semantic match: [(embedding, results, timestamp)]
_cache_lock = asyncio.Lock()
_cache_hits = 0
_cache_misses = 0


def _make_key(query: str, category: str, top_k: int) -> str:
    raw = f"{query}|{category}|{top_k}"
    return hashlib.sha256(raw.encode()).hexdigest()[:12]


async def get_cache(query: str, category: str = "", top_k: int = 15) -> Optional[list]:
    """鏌ヨ缂撳瓨 鈥?L1 绮剧‘ 鈫?L2 璇箟"""
    global _cache_hits, _cache_misses
    import time as _time

    _start = _time.time()

    async with _cache_lock:
        # L1: 绮剧‘鍖归厤
        key = _make_key(query, category, top_k)
        if key in _l1_cache:
            entry = _l1_cache[key]
            if time.time() - entry["ts"] < MAX_CACHE_AGE_SECONDS:
                _l1_cache.move_to_end(key)
                _cache_hits += 1
                latency_ms = (_time.time() - _start) * 1000
                try:
                    from src.infra.cache_stats import get_cache_stats

                    get_cache_stats().record_hit(latency_ms)
                except Exception as e:  # TODO: Narrow exception type
                    logger.warning("Exception 澶辫触: %s", e, exc_info=True)
                if logger.isEnabledFor(logging.DEBUG):
                    logger.info(f"[Cache] L1 hit: '{query[:40]}...'")
                else:
                    logger.info(f"[Cache] L1 hit: query_len={len(query)}")
                return entry["results"]
            else:
                del _l1_cache[key]

        # L2: 璇箟鍖归厤
        if _l2_cache:
            try:
                from src.db.vector_store import embed_texts

                q_emb = await embed_texts([query])
                if q_emb and q_emb[0]:
                    q_vec = q_emb[0]
                    now = time.time()
                    valid_count = 0
                    for i, (emb, results, ts) in enumerate(_l2_cache):
                        if now - ts > MAX_CACHE_AGE_SECONDS:
                            continue
                        valid_count += 1
                        sim = _cosine_similarity(q_vec, emb)
                        if sim >= SIMILARITY_THRESHOLD:
                            _cache_hits += 1
                            latency_ms = (_time.time() - _start) * 1000
                            try:
                                from src.infra.cache_stats import get_cache_stats

                                get_cache_stats().record_hit(latency_ms)
                            except Exception as e:  # TODO: Narrow exception type
                                logger.warning("Exception 澶辫触: %s", e, exc_info=True)
                            if logger.isEnabledFor(logging.DEBUG):
                                logger.info(f"[Cache] L2 hit (sim={sim:.3f}): '{query[:40]}...'")
                            else:
                                logger.info(f"[Cache] L2 hit: sim={sim:.3f}, query_len={len(query)}")
                            return results
                    # 濡傛灉澶ч噺杩囨湡锛岃Е鍙戞竻鐞?
                    if len(_l2_cache) - valid_count > 10:
                        _l2_cache[:] = [(e, r, t) for e, r, t in _l2_cache if now - t < MAX_CACHE_AGE_SECONDS]
            except Exception as e:  # TODO: Narrow exception type
                logger.warning(f"[cache] suppressed exception", exc_info=True)
    _cache_misses += 1
    latency_ms = (_time.time() - _start) * 1000
    try:
        from src.infra.cache_stats import get_cache_stats

        get_cache_stats().record_miss(latency_ms)
    except Exception as e:  # TODO: Narrow exception type
        logger.warning("Exception 澶辫触: %s", e, exc_info=True)
    return None


async def set_cache(query: str, results: list, category: str = "", top_k: int = 15):
    """鍐欏叆缂撳瓨"""
    async with _cache_lock:
        key = _make_key(query, category, top_k)

        # L1 鍐欏叆
        _l1_cache[key] = {"ts": time.time(), "results": results}
        _l1_cache.move_to_end(key)

        # 娣樻卑鏈€鏃х殑
        while len(_l1_cache) > MAX_CACHE_SIZE:
            _l1_cache.popitem(last=False)

        # L2 璇箟缂撳瓨锛堝紓姝ュ啓鍏?embedding锛?
        try:
            from src.db.vector_store import embed_texts

            q_emb = await embed_texts([query])
            if q_emb and q_emb[0]:
                now = time.time()
                _l2_cache.append((q_emb[0], results, now))
                # 娓呯悊杩囨湡鏉＄洰 + 澶у皬娣樻卑
                _l2_cache[:] = [(e, r, t) for e, r, t in _l2_cache if now - t < MAX_CACHE_AGE_SECONDS]
                while len(_l2_cache) > MAX_CACHE_SIZE // 2:
                    _l2_cache.pop(0)
        except Exception as e:  # TODO: Narrow exception type

            logger.warning(f"[cache] suppressed exception", exc_info=True)


def _cosine_similarity(a: list, b: list) -> float:
    """浣欏鸡鐩镐技搴?""
    if not a or not b or len(a) != len(b):
        return 0.0
    dot = sum(x * y for x, y in zip(a, b))
    norm_a = sum(x * x for x in a) ** 0.5
    norm_b = sum(y * y for y in b) ** 0.5
    if norm_a == 0 or norm_b == 0:
        return 0.0
    return dot / (norm_a * norm_b)


def get_cache_stats() -> dict:
    return {
        "l1_size": len(_l1_cache),
        "l2_size": len(_l2_cache),
        "hits": _cache_hits,
        "misses": _cache_misses,
        "hit_rate": round(_cache_hits / max(1, _cache_hits + _cache_misses), 3),
    }


def clear_cache():
    global _l1_cache, _l2_cache, _cache_hits, _cache_misses
    _l1_cache = OrderedDict()
    _l2_cache = []
    _cache_hits = 0
    _cache_misses = 0
    logger.info("[Cache] cleared")
