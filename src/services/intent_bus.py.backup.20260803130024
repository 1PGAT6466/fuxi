class IntentBus:
    """缁熶竴鎰忓浘鎬荤嚎 鈥?RAG 鎰忓浘鍒嗙被涓庤矾鐢变腑鏋?
    浣跨敤鏂瑰紡:
        bus = IntentBus()
        bus.register_handler(RAGIntent.SEARCH, my_search_handler)

        # 鍗曟鎰忓浘鍐崇瓥
        decision = await bus.classify_intent("浠€涔堟槸 VLAN")

        # 瀹屾暣鎰忓浘寰幆
        final_answer = await bus.run_intent_loop("浠€涔堟槸 VLAN", history=[])

    Lifecycle:
        - 鍒涘缓鍚庨€氳繃 register_handler() 娉ㄥ唽澶勭悊鍣?        - 璋冪敤 classify_intent() 鍋氭剰鍥惧垎绫?        - 璋冪敤 dispatch() 鍒嗗彂鎰忓浘鍒板鐞嗗櫒
        - 璋冪敤 run_intent_loop() 鑷姩瀹屾垚瀹屾暣鎰忓浘寰幆
    """

    # 寰幆绾︽潫
    MAX_TOTAL_ROUNDS: int = 8
    MAX_CONSECUTIVE_SAME_INTENT: int = 3
    DONE_MIN_CONFIDENCE: float = 0.7

    def __init__(self, session_id: str = "", data_dir: Optional[Path] = None):
        """
        Args:
            session_id: 浼氳瘽鏍囪瘑锛岀敤浜庨殧绂讳笉鍚屼細璇濈殑鎰忓浘鐘舵€?            data_dir: 鏁版嵁鐩綍锛堟寔涔呭寲鎰忓浘鏃ュ織锛?        """
        self.session_id = session_id or hashlib.sha256(str(time.time()).encode()).hexdigest()[:8]
        self._handlers: Dict[RAGIntent, List[Callable]] = {}
        self._intent_history: List[IntentRecord] = []
        self._round_count: int = 0
        self._query: str = ""
        self._last_intent: Optional[RAGIntent] = None
        self._consecutive_count: int = 0
        self._searched: bool = False
        self._data_dir = data_dir

        # 缂撳瓨
        self._cache: Dict[str, IntentDecision] = {}
        self._cache_hits: int = 0
        self._cache_misses: int = 0

        logger.debug(f"[IntentBus] 鍒濆鍖?session={self.session_id}")

    # ------------------------------------------------------------------
    # 澶勭悊鍣ㄦ敞鍐?    # ------------------------------------------------------------------

    def register_handler(self, intent: RAGIntent, handler: Callable) -> None:
        """娉ㄥ唽鎰忓浘澶勭悊鍣?
        Args:
            intent: 鎰忓浘绫诲瀷
            handler: async callable锛岀鍚嶄负 async def handler(query, context, decision) -> dict
        """
        if intent not in self._handlers:
            self._handlers[intent] = []
        self._handlers[intent].append(handler)
        logger.debug(f"[IntentBus] 娉ㄥ唽澶勭悊鍣? {intent.value} -> {handler.__name__}")

    def unregister_handler(self, intent: RAGIntent, handler: Callable) -> None:
        """鍙栨秷娉ㄥ唽澶勭悊鍣?""
        if intent in self._handlers and handler in self._handlers[intent]:
            self._handlers[intent].remove(handler)

    # ------------------------------------------------------------------
    # 鎰忓浘鍒嗙被
    # ------------------------------------------------------------------

    async def classify_intent(
        self,
        query: str,
        history: Optional[List[Dict[str, Any]]] = None,
        use_llm: bool = True,
    ) -> IntentDecision:
        """鍒嗙被鐢ㄦ埛鏌ヨ鎰忓浘

        鍒嗙被浼樺厛绾э細
          1. 棰勫姞杞界紦瀛橈紙绮剧‘/鍓嶇紑鍖归厤锛夆€?闆跺欢杩?          2. MD5 璇箟缂撳瓨 鈥?<1ms
          3. 姝ｅ垯瑙勫垯鍖归厤 鈥?<5ms
          4. LLM 鍒嗙被 鈥?1-3s锛堜粎澶嶆潅鏌ヨ锛?
        Args:
            query: 鐢ㄦ埛鏌ヨ鏂囨湰
            history: 瀵硅瘽鍘嗗彶
            use_llm: 鏄惁鍚敤 LLM 鍒嗙被锛堥粯璁?True锛?
        Returns:
            IntentDecision 瀵硅薄
        """
        query = query.strip()
        if not query:
            return IntentDecision(intent=RAGIntent.PRESENT, confidence=1.0, reasoning="绌烘煡璇?)

        # L1: 棰勫姞杞界紦瀛樺尮閰?        cached_intent = _match_preload_cache(query)
        if cached_intent:
            decision = IntentDecision(
                intent=RAGIntent(cached_intent),
                confidence=0.95,
                reasoning=f"棰勫姞杞界紦瀛樺懡涓? {cached_intent}",
            )
            return decision

        # L2: MD5 璇箟缂撳瓨
        cache_key = hashlib.sha256(query.encode("utf-8")).hexdigest()
        if cache_key in self._cache:
            self._cache_hits += 1
            cached = self._cache[cache_key]
            logger.debug(f"[IntentBus] 缂撳瓨鍛戒腑: {query[:30]}... -> {cached.intent.value}")
            return cached

        self._cache_misses += 1

        # L3: 姝ｅ垯瑙勫垯鍒嗙被
        rule_decision = _rule_based_classify(query, self._searched)
        if rule_decision and rule_decision.confidence >= 0.8:
            self._cache[cache_key] = rule_decision
            return rule_decision

        # L4: LLM 鍒嗙被锛堜粎澶嶆潅鏌ヨ锛?        if use_llm and len(query) > 10:
            try:
                llm_decision = await _llm_classify_intent(query, history, self._searched)
                if llm_decision:
                    self._cache[cache_key] = llm_decision
                    return llm_decision
            except Exception as e:
                logger.warning(f"[IntentBus] LLM 鎰忓浘鍒嗙被澶辫触: {e}")

        # 榛樿锛歋EARCH
        default = IntentDecision(intent=RAGIntent.SEARCH, confidence=0.6, reasoning="榛樿妫€绱?)
        self._cache[cache_key] = default
        return default

    # ------------------------------------------------------------------
    # 鎰忓浘璺敱涓庢淳鍙?    # ------------------------------------------------------------------

    async def dispatch(
        self,
        decision: IntentDecision,
        query: str,
        context: Optional[Dict[str, Any]] = None,
    ) -> Dict[str, Any]:
        """娲惧彂鎰忓浘鍒板搴旂殑澶勭悊鍣ㄦ墽琛?
        Args:
            decision: 鎰忓浘鍐崇瓥缁撴灉
            query: 鍘熷鏌ヨ
            context: 涓婁笅鏂囨暟鎹紙鍓嶅簭姝ラ鐨勭粨鏋滅瓑锛?
        Returns:
            澶勭悊鍣ㄨ繑鍥炵殑缁撴灉瀛楀吀
        """
        intent = decision.intent
        handlers = self._handlers.get(intent, [])

        if not handlers:
            logger.warning(f"[IntentBus] {intent.value} 鏃犳敞鍐屽鐞嗗櫒锛岃烦杩?)
            return {"intent": intent.value, "result": None, "skipped": True}

        # 鎸夋敞鍐岄『搴忎緷娆℃墽琛岋紙鏀寔閾惧紡澶勭悊锛?        result = {}
        current_context = context or {}
        current_context["query"] = query
        current_context["decision"] = {"intent": decision.intent.value, "confidence": decision.confidence}

        for handler in handlers:
            try:
                handler_result = await handler(query, current_context, decision)
                if handler_result:
                    current_context.update(handler_result)
                    result = {**result, **handler_result}
            except Exception as e:
                logger.error(f"[IntentBus] 澶勭悊鍣?{handler.__name__} 鎵ц澶辫触: {e}", exc_info=True)
                result["_error"] = str(e)

        result["intent"] = intent.value
        return result

    # ------------------------------------------------------------------
    # 瀹屾暣鎰忓浘寰幆
    # ------------------------------------------------------------------

    async def run_intent_loop(
        self,
        query: str,
        history: Optional[List[Dict[str, Any]]] = None,
    ) -> Dict[str, Any]:
        """鎵ц瀹屾暣鐨勪咕鍗︽剰鍥惧惊鐜?
        寰幆娴佺▼:
          while intent != DONE:
            1. classify_intent(query) -> 鎰忓浘鍐崇瓥
            2. 寰幆瀹堝崼妫€鏌ワ紙鍚屾剰鍥句笂闄?鎬昏疆鏁?鏈绱㈢DONE锛?            3. dispatch(intent) -> 娲惧彂鍒板鐞嗗櫒
            4. 璁板綍鎰忓浘鍘嗗彶
            5. 涓嬩竴杞喅绛?
        Args:
            query: 鐢ㄦ埛鏌ヨ
            history: 瀵硅瘽鍘嗗彶

        Returns:
            鍖呭惈 answer 鍜?intent_trace 鐨勭粨鏋滃瓧鍏?        """
        self._reset_cycle(query)
        context: Dict[str, Any] = {"history": history or []}
        final_result: Dict[str, Any] = {}

        start_time = time.time()

        while self._round_count < self.MAX_TOTAL_ROUNDS:
            self._round_count += 1

            # Step 1: 鎰忓浘鍒嗙被
            decision = await self.classify_intent(query, history)

            # Step 2: 寰幆瀹堝崼妫€鏌?            guard_result = self._cycle_guard(decision)
            if guard_result:
                logger.info(f"[IntentBus] 寰幆瀹堝崼鎷︽埅: {guard_result}")
                decision = guard_result

            # Step 3: 璁板綍鎰忓浘鍘嗗彶
            t0 = time.time()
            record = IntentRecord(
                step=self._round_count,
                intent=decision.intent,
                confidence=decision.confidence,
                reasoning=decision.reasoning,
            )

            # Step 4: 娲惧彂鎵ц
            if decision.intent == RAGIntent.DONE:
                record.latency_ms = (time.time() - t0) * 1000
                record.result_summary = "鎰忓浘寰幆缁撴潫"
                self._intent_history.append(record)
                logger.info(f"[IntentBus] 鎰忓浘寰幆瀹屾垚: {len(self._intent_history)} 杞?)
                break

            step_result = await self.dispatch(decision, query, context)

            record.latency_ms = (time.time() - t0) * 1000
            record.result_summary = str(step_result.get("summary", ""))[:100]
            self._intent_history.append(record)

            # Step 5: 鏇存柊涓婁笅鏂?            context.update(step_result)
            final_result = step_result

            # 璺熻釜 SEARCH 鎰忓浘
            if decision.intent == RAGIntent.SEARCH:
                self._searched = True

            # 璺熻釜杩炵画鎰忓浘
            if self._last_intent == decision.intent:
                self._consecutive_count += 1
            else:
                self._consecutive_count = 1
            self._last_intent = decision.intent

        total_ms = (time.time() - start_time) * 1000

        # 鏋勫缓杩斿洖缁撴灉
        return {
            "query": query,
            "session_id": self.session_id,
            "rounds": self._round_count,
            "intent_trace": [
                {
                    "step": r.step,
                    "intent": r.intent.value,
                    "confidence": r.confidence,
                    "reasoning": r.reasoning,
                    "latency_ms": round(r.latency_ms, 1),
                }
                for r in self._intent_history
            ],
            "result": final_result,
            "total_latency_ms": round(total_ms, 1),
            "cache_hits": self._cache_hits,
            "cache_misses": self._cache_misses,
        }

    # ------------------------------------------------------------------
    # 寰幆瀹堝崼
    # ------------------------------------------------------------------

    def _cycle_guard(self, decision: IntentDecision) -> Optional[IntentDecision]:
        """寰幆瀹堝崼锛氭嫤鎴笉鍚堢悊鐨勬剰鍥惧喅绛?
        瑙勫垯锛?          1. 鏈墽琛?SEARCH 鍓嶇姝?DONE
          2. 鍚屾剰鍥捐繛缁鏁拌秴闄?          3. 鎬昏疆鏁板嵆灏嗚揪鍒颁笂闄愭椂寮哄埗鏀舵潫
          4. DONE 缃俊搴︿笉澶熸椂闄嶇骇

        Returns:
            淇鍚庣殑鍐崇瓥锛屾垨 None锛堝師鍐崇瓥閫氳繃锛?        """
        # 瑙勫垯 1: 鏈绱㈢姝?DONE
        if decision.intent == RAGIntent.DONE and not self._searched:
            logger.info("[IntentBus] 寰幆瀹堝崼: 鏈绱㈢姝ONE锛屽己鍒禨EARCH")
            return IntentDecision(
                intent=RAGIntent.SEARCH,
                confidence=0.5,
                reasoning="鏈绱紝绂佹DONE",
            )

        # 瑙勫垯 2: 鍚屾剰鍥捐繛缁秴闄?        max_consecutive = _INTENT_CONFIG.get(decision.intent.value, {}).get("max_consecutive", 3)
        if self._last_intent == decision.intent and self._consecutive_count >= max_consecutive:
            fallback = self._fallback_intent(decision.intent)
            logger.info(f"[IntentBus] 寰幆瀹堝崼: {decision.intent.value} 杩炵画瓒呴檺锛岄檷绾у埌 {fallback.value}")
            return IntentDecision(
                intent=fallback,
                confidence=0.5,
                reasoning=f"{decision.intent.value} 杩炵画瓒呴檺({max_consecutive})",
            )

        # 瑙勫垯 3: 绗?7 杞己鍒舵敹鏉?        if self._round_count >= self.MAX_TOTAL_ROUNDS - 1 and decision.intent not in (
            RAGIntent.PRESENT,
            RAGIntent.DONE,
        ):
            logger.info("[IntentBus] 寰幆瀹堝崼: 鎺ヨ繎杞暟涓婇檺锛屽己鍒?PRESENT")
            return IntentDecision(intent=RAGIntent.PRESENT, confidence=0.6, reasoning="杞暟鏀舵潫")

        # 瑙勫垯 4: DONE 缃俊搴︿笉瓒?        if decision.intent == RAGIntent.DONE and decision.confidence < self.DONE_MIN_CONFIDENCE:
            logger.info(f"[IntentBus] 寰幆瀹堝崼: DONE 缃俊搴︿笉瓒?{decision.confidence})锛岄檷绾?)
            return IntentDecision(intent=RAGIntent.PRESENT, confidence=0.6, reasoning="DONE 缃俊搴︿笉瓒?)

        return None

    def _fallback_intent(self, current: RAGIntent) -> RAGIntent:
        """鑾峰彇褰撳墠鎰忓浘鐨勯檷绾ф剰鍥?""
        fallback_map = {
            RAGIntent.SEARCH: RAGIntent.REFINE,
            RAGIntent.DIGEST: RAGIntent.SEARCH,
            RAGIntent.REFINE: RAGIntent.PRESENT,
            RAGIntent.PRESENT: RAGIntent.DONE,
            RAGIntent.DONE: RAGIntent.DONE,
        }
        return fallback_map.get(current, RAGIntent.PRESENT)

    def _reset_cycle(self, query: str) -> None:
        """閲嶇疆鎰忓浘寰幆鐘舵€?""
        self._intent_history.clear()
        self._round_count = 0
        self._query = query
        self._last_intent = None
        self._consecutive_count = 0
        self._searched = False

    # ------------------------------------------------------------------
    # 灞炴€?& 缁熻
    # ------------------------------------------------------------------

    @property
    def intent_trace(self) -> List[Dict[str, Any]]:
        """杩斿洖鎰忓浘杞崲鍘嗗彶"""
        return [
            {
                "step": r.step,
                "intent": r.intent.value,
                "confidence": r.confidence,
                "reasoning": r.reasoning,
                "latency_ms": round(r.latency_ms, 1),
            }
            for r in self._intent_history
        ]

    @property
    def stats(self) -> Dict[str, Any]:
        """杩斿洖缁熻淇℃伅"""
        return {
            "session_id": self.session_id,
            "round_count": self._round_count,
            "intent_trace": self.intent_trace,
            "cache_hits": self._cache_hits,
            "cache_misses": self._cache_misses,
            "cache_size": len(self._cache),
        }

    def clear_cache(self) -> None:
        """娓呴櫎缂撳瓨"""
        self._cache.clear()
        self._cache_hits = 0
        self._cache_misses = 0


