def _match_preload_cache(query: str) -> Optional[str]:
    """鍖归厤棰勫姞杞芥剰鍥剧紦瀛?
    鍖归厤瑙勫垯锛?      1. 绮剧‘鍖归厤
      2. 鍓嶇紑閫氶厤锛?鎼?" 鍖归厤 "鎼? 寮€澶寸殑 query锛?      3. 瀛愪覆鍖呭惈锛堥潪閫氶厤妯″紡锛宷uery 鍖呭惈妯″紡鍏抽敭璇嶏級
    """
    # 绮剧‘鍖归厤
    if query in _PRELOAD_INTENT_CACHE:
        return _PRELOAD_INTENT_CACHE[query]

    # 鍓嶇紑閫氶厤
    for pattern, intent in _PRELOAD_INTENT_CACHE.items():
        if pattern.endswith("*") and query.startswith(pattern[:-1]):
            return intent

    # 瀛愪覆鍖呭惈锛堜粎闄愮煭鍏抽敭璇嶏紝閬垮厤璇尮閰嶏級
    for pattern, intent in _PRELOAD_INTENT_CACHE.items():
        if "*" not in pattern and len(pattern) >= 2 and pattern in query:
            # 鍙湪 query 杈冪煭鏃跺仛瀛愪覆鍖归厤
            if len(query) <= 20:
                return intent

    return None


def _rule_based_classify(query: str, has_searched: bool = False) -> Optional[IntentDecision]:
    """鍩轰簬瑙勫垯鐨勬鍒欏揩閫熷垎绫?
    鍒嗙被瑙勫垯浼樺厛绾э細
      1. 涓婁紶/瀵煎叆绫?鈫?DIGEST
      2. 瀵规瘮/鍒嗘瀽绫伙紙鏈夋绱㈢粨鏋滄椂锛?鈫?REFINE
      3. 绠€鍗曠煡璇嗛棶绛?鈫?SEARCH
      4. 宸叉绱笖淇℃伅瓒冲 鈫?PRESENT
    """
    # 涓婁紶/娑堝寲绫?    upload_patterns = [
        r"(涓婁紶|瀵煎叆|娑堝寲|瀛︿範).*(鏂囨。|鏂囦欢|鐭ヨ瘑|鏁版嵁)",
        r"(甯垜|璇?.*(涓婁紶|瀵煎叆|娑堝寲)",
    ]
    for pat in upload_patterns:
        if re.search(pat, query):
            return IntentDecision(intent=RAGIntent.DIGEST, confidence=0.85, reasoning="涓婁紶/娑堝寲妯″紡")

    # 绮剧偧绫伙紙闇€瑕佸幓閲?鎺掑簭锛?    refine_patterns = [
        r"(瀵规瘮|姣旇緝|鍖哄埆|vs\.?|鍝釜鏇村ソ|鍝釜鏇?",
        r"(姹囨€粅鎬荤粨|褰掔撼).*缁撴灉",
        r"(鎺掑簭|绛涢€墊鍘婚噸|绮剧偧)",
    ]
    for pat in refine_patterns:
        if re.search(pat, query):
            return IntentDecision(intent=RAGIntent.REFINE, confidence=0.80, reasoning="绮剧偧妯″紡")

    # 宸叉绱笖鏄畝鍗曠‘璁?鈫?PRESENT
    if has_searched and len(query) <= 15:
        confirm_patterns = [r"^(瀵圭殑|娌￠敊|鏄殑|涓嶅|涓嶆槸|鍙互|琛寍濂?", r"^(缁х画|鍐嶆潵|涓嬩竴涓獆杩樻湁)"]
        for pat in confirm_patterns:
            if re.search(pat, query):
                return IntentDecision(intent=RAGIntent.PRESENT, confidence=0.85, reasoning="纭/缁х画妯″紡")

    return None


async def _llm_classify_intent(
    query: str,
    history: Optional[List[Dict[str, Any]]] = None,
    has_searched: bool = False,
) -> Optional[IntentDecision]:
    """LLM 鎰忓浘鍒嗙被锛堝鏉傛煡璇㈠厹搴曪級

    浣跨敤杞婚噺 Prompt 璁?LLM 杈撳嚭 JSON 鏍煎紡鎰忓浘鍐崇瓥銆?    """
    try:
        from src.services.llm import call_llm_fast

        searched_note = "true" if has_searched else "false"

        prompt = f"""浣犳槸鎰忓浘鍒嗙被鍣ㄣ€傚垎鏋愮敤鎴锋煡璇紝杩斿洖 JSON銆?
## 鎰忓浘绫诲瀷
- SEARCH: 闇€瑕佹绱㈢煡璇嗗簱
- DIGEST: 闇€瑕佹秷鍖?瀵煎叆鏂扮煡璇?- REFINE: 闇€瑕佸宸叉湁缁撴灉绮剧偧/瀵规瘮/鎺掑簭
- PRESENT: 淇℃伅瓒冲锛岀洿鎺ョ敓鎴愬洖绛?- DONE: 缁撴潫

## 涓婁笅鏂?宸叉墽琛屾绱? {searched_note}

## 鐢ㄦ埛鏌ヨ
{query}

## 杈撳嚭锛堜粎 JSON锛?{{"intent":"SEARCH","confidence":0.85,"reasoning":"绠€鍥犫墹20瀛?}}"""

        result = await call_llm_fast(prompt, max_tokens=150)
        if not result:
            return None

        # 娓呯悊 JSON
        result = result.strip()
        if result.startswith("```"):
            result = result.split("\n", 1)[1].rsplit("```", 1)[0]

        data = json.loads(result)
        intent_str = data.get("intent", "SEARCH").upper()
        confidence = float(data.get("confidence", 0.7))
        reasoning = data.get("reasoning", "LLM鍒嗙被")[:20]

        # 楠岃瘉 intent 鏈夋晥鎬?        valid_intents = {e.value for e in RAGIntent}
        if intent_str not in valid_intents:
            intent_str = "SEARCH"

        return IntentDecision(
            intent=RAGIntent(intent_str),
            confidence=min(max(confidence, 0.0), 1.0),
            reasoning=reasoning,
        )

    except Exception as e:
        logger.debug(f"[IntentBus] LLM 鍒嗙被寮傚父: {e}")
        return None


