重定向到 src.shaoyang.parser，提供统一文档解析入口。

新增便捷函数（原 shell 未实现）：
  - identify_file(path) → str   识别文件类型
  - parse_file(path) → Dict     异步解析文档
"""

import logging
from pathlib import Path
from typing import Dict

logger = logging.getLogger(__name__)

# ============================================================
# 从实际实现导入核心类
# ============================================================
from src.shaoyang.parser import DocumentParser  # noqa: F401

# ============================================================
# 便捷函数：被 ingest.py 引用
# ============================================================

# 文件类型识别映射
_MIME_MAP = {
    ".pdf": "pdf",
    ".docx": "docx",
    ".doc": "docx",
    ".xlsx": "xlsx",
    ".xls": "xlsx",
    ".txt": "text",
    ".md": "text",
    ".html": "html",
    ".htm": "html",
    ".csv": "csv",
    ".pptx": "pptx",
    ".ppt": "pptx",
    ".png": "image",
    ".jpg": "image",
    ".jpeg": "image",
    ".gif": "image",
    ".bmp": "image",
}


def identify_file(file_path: str) -> str:
    """识别文件类型，返回已知类型字符串或 'unknown'。

    Args:
        file_path: 文件路径（字符串）

    Returns:
        文件类型标识（如 'pdf', 'docx', 'text', 'image'）或 'unknown'
    """
    suffix = Path(file_path).suffix.lower()
    return _MIME_MAP.get(suffix, "unknown")


async def parse_file(file_path: str) -> Dict:
    """异步解析文档，返回结构化结果。

    Args:
        file_path: 文件路径

    Returns:
        dict，包含 'text'、'type'、'tables' 等字段；
        解析失败返回 {"error": str, "text": ""}
    """
    import asyncio

    def _parse_sync() -> Dict:
        parser = DocumentParser()
        return parser.parse(file_path)

    try:
        result = await asyncio.to_thread(_parse_sync)
        return result
    except Exception as e:
        logger.warning("parse_file 失败 [%s]: %s", file_path, e)
        return {"error": str(e), "text": "", "type": identify_file(file_path)}


__all__ = [
    "DocumentParser",
    "identify_file",
    "parse_file",
]
