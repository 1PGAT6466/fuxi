        # 7. 鏇存柊缁熻 & 璁板綍浜嬩欢
        self._update_stats(report)
        if has_hallucination:
            asyncio.create_task(self._log_event(report))

        if logger.isEnabledFor(logging.DEBUG):
            logger.debug(
                f"[SafetyCritic] {report_id[:12]} 妫€娴嬪畬鎴? "
                f"overall={overall_score:.3f}, "
