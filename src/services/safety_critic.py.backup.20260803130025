    def sanitize_output(self, text: str) -> str:
        """
        LLM02: 涓嶅畨鍏ㄨ緭鍑哄鐞?鈥?鍑€鍖朙LM杈撳嚭锛岀Щ闄ゆ綔鍦ㄦ湁瀹冲唴瀹广€?
        闃插尽鑼冨洿锛?        - XSS锛圚TML鏍囩娉ㄥ叆锛?        - 鑴氭湰娉ㄥ叆锛坖avascript: 鍗忚锛?        - Markdown閾炬帴娉ㄥ叆

        Args:
            text: LLM 鍘熷杈撳嚭鏂囨湰

        Returns:
            鍑€鍖栧悗鐨勫畨鍏ㄦ枃鏈?        """
        if not text or not isinstance(text, str):
            return ""

        # 绉婚櫎HTML鏍囩锛堥槻姝SS锛?        text = re.sub(r"<[^>]+>", "", text)
        # 绉婚櫎娼滃湪鐨勮剼鏈敞鍏?        text = re.sub(r"javascript:", "", text, flags=re.IGNORECASE)
        # 绉婚櫎娼滃湪鐨刴arkdown閾炬帴娉ㄥ叆
        text = re.sub(r"\[([^\]]+)\]\(javascript:[^)]+\)", r"\1", text)
        return text.strip()

    def check_excessive_agency(self, action: str, context: dict = None) -> bool:
        """
        LLM08: 杩囧害鑷富鏉?鈥?妫€鏌ユ搷浣滄槸鍚﹁秴鍑烘巿鏉冭寖鍥淬€?
        闃叉 LLM 浠ｇ悊鎵ц楂橀闄╂搷浣滐紙鍒犻櫎銆佺郴缁熶慨鏀广€佷唬鐮佹墽琛岀瓑锛夈€?        浠呭厑璁稿畨鍏ㄧ殑鍙/鍒嗘瀽绫绘搷浣溿€?
        Args:
            action: 寰呮鏌ョ殑鎿嶄綔鍚嶇О
            context: 鎿嶄綔涓婁笅鏂囷紙棰勭暀鎵╁睍锛?
        Returns:
            True 琛ㄧず鎿嶄綔琚厑璁革紝False 琛ㄧず琚嫆缁?        """
        # 瀹氫箟鍏佽鐨勬搷浣滅被鍨嬶紙鍙/鍒嗘瀽绫伙級
        ALLOWED_ACTIONS = {
            "search",
            "read",
            "summarize",
            "analyze",
            "translate",
            "answer",
            "suggest",
            "explain",
            "compare",
        }
        # 瀹氫箟绂佹鐨勬搷浣滅被鍨嬶紙楂橀闄╁啓鎿嶄綔锛?        BLOCKED_ACTIONS = {
            "delete",
            "modify_system",
            "execute_code",
            "access_admin",
            "send_email",
            "make_payment",
            "change_password",
        }

        if not action or not isinstance(action, str):
            return False

        action_lower = action.lower()
        if action_lower in BLOCKED_ACTIONS:
            logger.warning(f"[SafetyCritic] 杩囧害鑷富鏉冮樆姝? action={action_lower}")
            return False  # 鎷掔粷
        return action_lower in ALLOWED_ACTIONS

    def detect_retrieval_poisoning(self, query: str, context: str) -> dict:
        """
        LLM03: 璁粌鏁版嵁鎶曟瘨 鈥?妫€娴嬫绱㈢粨鏋滄槸鍚﹀彲鑳借鎶曟瘨銆?
        妫€娴嬫寚鏍囷細
        - 杩囧澶栭儴閾炬帴锛堝彲鑳芥槸 SEO 鎶曟瘨锛?        - 閲嶅鍐呭锛堝彲鑳芥槸濉厖鍣煶锛?        - 鍙枒鎸囦护妯″紡锛堣瘯鍥捐鐩?LLM 琛屼负锛?
        Args:
            query: 鐢ㄦ埛鍘熷鏌ヨ
            context: 妫€绱㈠埌鐨勪笂涓嬫枃鍐呭

        Returns:
            {
                "risk_score": float,     # 0.0-1.0 鎶曟瘨椋庨櫓鍒嗘暟
                "indicators": dict,        # 鍚勬寚鏍囨娴嬬粨鏋?                "safe": bool               # 鏄惁瀹夊叏锛堥闄?< 0.3锛?            }
        """
        if not context or not isinstance(context, str):
            return {"risk_score": 0.0, "indicators": {}, "safe": True}

        indicators = {
            "excessive_links": len(re.findall(r"https?://", context)) > 10,
            "repetitive_content": self._check_repetition(context),
            "suspicious_patterns": bool(
                re.search(r"(?:ignore|forget|disregard).*(?:instructions|rules)", context, re.IGNORECASE)
            ),
        }

        risk_score = sum(indicators.values()) / len(indicators)

        if risk_score >= 0.3:
            logger.warning(f"[SafetyCritic] 妫€绱㈡姇姣掗闄? score={risk_score:.2f}, " f"indicators={indicators}")

        return {"risk_score": round(risk_score, 4), "indicators": indicators, "safe": risk_score < 0.3}

    @staticmethod
    def _check_repetition(text: str, threshold: float = 0.6) -> bool:
        """
        妫€娴嬫枃鏈腑鐨勯噸澶嶅唴瀹规瘮渚嬨€?        浣跨敤 n-gram 鍘婚噸鐜囦及绠楀唴瀹归噸澶嶅害銆?
        Args:
            text: 寰呮娴嬫枃鏈?            threshold: 閲嶅姣斾緥闃堝€硷紙榛樿 0.6锛?
        Returns:
            True 琛ㄧず瀛樺湪澶ч噺閲嶅锛堝彲鑳芥湁鎶曟瘨椋庨櫓锛?        """
        if len(text) < 100:
            return False

        # 浣跨敤 5-gram 妫€娴嬮噸澶?        n = 5
        if len(text) < n:
            return False

        ngrams = [text[i : i + n] for i in range(len(text) - n + 1)]
        total = len(ngrams)
        unique = len(set(ngrams))

        if total == 0:
            return False

        repetition_ratio = 1.0 - (unique / total)
        return repetition_ratio > threshold

    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ 宸ュ叿鏂规硶 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    @staticmethod
    def _make_report_id(query: str, response: str, timestamp: float) -> str:
        """鐢熸垚鍞竴鎶ュ憡 ID"""
        raw = f"{query[:100]}|{response[:100]}|{timestamp}"
        return "hrep_" + hashlib.sha256(raw.encode()).hexdigest()[:16]

    @staticmethod
    def _safe_json_parse(text: str) -> Dict[str, Any]:
        """瀹夊叏瑙ｆ瀽 LLM 杩斿洖鐨?JSON锛屽鐞嗗父瑙佹牸寮忛棶棰?""
        text = text.strip()

        # 鍘婚櫎 markdown 浠ｇ爜鍧?        if text.startswith("```"):
            lines = text.split("\n")
            if len(lines) > 2:
                text = "\n".join(lines[1:-1])
            elif lines[0].startswith("```json"):
                text = lines[0][7:].strip()

        # 鎻愬彇 JSON 瀵硅薄
        s = text.find("{")
        e = text.rfind("}")
        if s >= 0 and e > s:
            try:
                return json.loads(text[s : e + 1])
            except json.JSONDecodeError:
                pass

        # 鐩存帴瑙ｆ瀽
        try:
            return json.loads(text)
        except json.JSONDecodeError:
            pass

        return {}


