            )

        return report

    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ 鍚彂寮忔娴?鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    def _heuristic_detect(self, query: str, response: str, context: str) -> Dict[str, Any]:
        """
        鍚彂寮忓够瑙夋娴嬶細鍩轰簬姝ｅ垯妯″紡鍖归厤鍜岀畝鍗曡鍒欍€?
        杩斿洖:
            {
                "fabrication": [{"text": ..., "reason": ..., "start_pos": ..., "end_pos": ...}],
                "fact_distortion": [...],
                "logic_contradiction": [...],
                "claims_checked": [{"text": ..., "supported": bool}],
            }
        """
        result = {
            "fabrication": [],
            "fact_distortion": [],
            "logic_contradiction": [],
            "claims_checked": [],
        }

        # 鈹€鈹€ 妫€娴?1: 鏃犱腑鐢熸湁妯″紡 鈹€鈹€
        for pattern, reason in FABRICATION_PATTERNS:
            for match in re.finditer(pattern, response):
                span = {
                    "type": "fabrication",
                    "text": match.group(),
                    "start_pos": match.start(),
                    "end_pos": match.end(),
                    "confidence": 0.6,  # 鍚彂寮忕疆淇″害涓瓑
                    "reason": reason,
                    "conflicting_context": "",
                    "severity": "medium",
                }
                result["fabrication"].append(span)

        # 鈹€鈹€ 妫€娴?2: 浜嬪疄鎵洸锛堟暟瀛楀姣旓級 鈹€鈹€
        if context:
            result["fact_distortion"] = self._compare_numerics(response, context)

        # 鈹€鈹€ 妫€娴?3: 閫昏緫鐭涚浘 鈹€鈹€
        if context:
            result["logic_contradiction"] = self._check_logical_consistency(response, context)

        # 鈹€鈹€ 妫€娴?4: 澹版槑鏀寔妫€娴?鈹€鈹€
        result["claims_checked"] = self._check_claim_support(response, context)

        return result

    def _compare_numerics(self, response: str, context: str) -> List[Dict]:
        """
        瀵规瘮鍥炵瓟鍜屼笂涓嬫枃涓殑鏁板€煎瀷浜嬪疄銆?        浣跨敤姝ｅ垯鎻愬彇鏁板€硷紝瀵规瘮宸紓銆?        """
        spans = []

        # 浠庝笂涓嬫枃涓彁鍙?{鎻忚堪: 鏁板€紏 瀵?        ctx_pattern = re.compile(
            r"([\u4e00-\u9fff\w]+(?:鐩村緞|楂樺害|瀹藉害|鍘氬害|閲嶉噺|閫熷害|娓╁害|鍘嬪姏|棰戠巼|鍔熺巼|瀹归噺|鏁伴噺|浠锋牸|姣旂巼|绮惧害|璇樊))\s*(?:涓簗鏄瘄锛潀=|:|锛殀杈惧埌|D=)\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|km|g|kg|t|ms|s|min|h|鍏億涓噟浜縷%|掳C|鈩億掳|Hz|kHz|MHz|W|kW)?",
            re.IGNORECASE,
        )

        ctx_values: Dict[str, Tuple[str, str]] = {}
        for match in ctx_pattern.finditer(context):
            keyword = match.group(1).lower()
            value_str = match.group(2)
            unit = match.group(3) or ""
            ctx_values[keyword] = (value_str, unit)

        # 浠庡洖绛斾腑鎻愬彇瀵瑰簲鏁板€煎苟瀵规瘮
        resp_matches = list(ctx_pattern.finditer(response))
        for match in resp_matches:
            keyword = match.group(1).lower()
            resp_value_str = match.group(2)
            resp_unit = match.group(3) or ""

            if keyword in ctx_values:
                ctx_value_str, ctx_unit = ctx_values[keyword]
                # 瑙勮寖鍖栧姣?                try:
                    ctx_val = float(ctx_value_str)
                    resp_val = float(resp_value_str)
                    if abs(ctx_val - resp_val) > 0.001 and ctx_unit == resp_unit:
                        # 鏁板€间笉涓€鑷?                        spans.append(
                            {
                                "type": "fact_distortion",
                                "text": match.group(),
                                "start_pos": match.start(),
                                "end_pos": match.end(),
                                "confidence": 0.75,
                                "reason": f"鏁板€间笉涓€鑷达細涓婁笅鏂囦负 {ctx_value_str}{ctx_unit}锛屽洖绛斾负 {resp_value_str}{resp_unit}",
                                "conflicting_context": f"涓婁笅鏂囦腑 {keyword} = {ctx_value_str}{ctx_unit}",
                                "severity": (
                                    "high" if abs(ctx_val - resp_val) / max(abs(ctx_val), 1) > 0.5 else "medium"
                                ),
                            }
                        )
                except ValueError:
                    # 闈炴暟鍊煎姣旓紙濡傚瓧绗︿覆鍊硷級
                    if ctx_value_str != resp_value_str:
                        spans.append(
                            {
                                "type": "fact_distortion",
                                "text": match.group(),
                                "start_pos": match.start(),
                                "end_pos": match.end(),
                                "confidence": 0.65,
                                "reason": f"鍊间笉涓€鑷达細涓婁笅鏂囦负 '{ctx_value_str}'锛屽洖绛斾负 '{resp_value_str}'",
                                "conflicting_context": f"涓婁笅鏂囦腑 {keyword} = {ctx_value_str}",
                                "severity": "medium",
                            }
                        )

        return spans

    def _check_logical_consistency(self, response: str, context: str) -> List[Dict]:
        """
        妫€鏌ュ洖绛斾笌涓婁笅鏂囦箣闂寸殑閫昏緫涓€鑷存€с€?        涓嶈繘琛屽鏉傛帹鐞嗭紝鍙娴嬬畝鍗曠殑閫昏緫鍐茬獊妯″紡銆?        """
        spans = []

        # 妯″紡 1: "蹇呴』/鍙兘/浠?鍙? vs 涓婁笅鏂囦腑鐨勫涓€夐」
        exclusive_patterns = [
            (r"(?:蹇呴』|鍙兘|浠呮湁|鍙湁|浠呴檺|鍙兘浣跨敤|鍞竴.{0,4}鏄?\s*([^锛?銆?\n]{5,30})", "鎺掍粬鎬ф柇瑷€"),
        ]

        for pattern, reason in exclusive_patterns:
            for match in re.finditer(pattern, response):
                exclusive_text = match.group(1).strip()
                # 鍦ㄤ笂涓嬫枃涓悳绱㈡槸鍚︽湁澶氶€夐」
                multi_option_indicators = [
                    "鍙€?,
                    "涓夌",
                    "澶氱",
                    "鍖呮嫭",
                    "濡?,
                    "渚嬪",
                    "鍙互",
                    "涔熷彲",
                    "绛夋柟寮?,
                    "绛夌被鍨?,
                    "绛夋ā寮?,
                ]
                if any(ind in context for ind in multi_option_indicators):
                    spans.append(
                        {
                            "type": "logic_contradiction",
                            "text": match.group(),
                            "start_pos": match.start(),
                            "end_pos": match.end(),
                            "confidence": 0.55,
                            "reason": f"{reason}锛氫笂涓嬫枃鏆楃ず瀛樺湪澶氫釜閫夐」",
                            "conflicting_context": "涓婁笅鏂囧寘鍚閫夐」鎸囩ず璇?,
                            "severity": "low",
                        }
                    )

        # 妯″紡 2: 鍥犳灉鍏崇郴涓庝笂涓嬫枃鐭涚浘
        cause_effect_patterns = [
            (r"(?:鍥犱负|鐢变簬|鍩轰簬|閴翠簬)\s*([^锛?銆?\n]{10,50})(?:鎵€浠鍥犳|鏁厊浜庢槸|浠庤€?", "鍥犳灉鏂█"),
        ]

        for pattern, reason in cause_effect_patterns:
            for match in re.finditer(pattern, response):
                cause = match.group(1).strip()
                # 妫€鏌ュ師鍥犳槸鍚﹀湪涓婁笅鏂囦腑琚惁瀹?                negation_indicators = [
                    f"涓嶆槸{cause[:10]}",
                    f"骞堕潪{cause[:10]}",
                    f"涓嶈兘{cause[:10]}",
                ]
                if any(ind in context for ind in negation_indicators):
                    spans.append(
                        {
                            "type": "logic_contradiction",
                            "text": match.group(),
                            "start_pos": match.start(),
                            "end_pos": match.end(),
                            "confidence": 0.65,
                            "reason": f"{reason}锛氬墠鎻愭潯浠跺湪涓婁笅鏂囦腑琚惁瀹?,
                            "conflicting_context": "涓婁笅鏂囧惁瀹氫簡璇ュ洜鏋滃叧绯荤殑鍓嶆彁",
                            "severity": "medium",
                        }
                    )

        return spans

    def _check_claim_support(self, response: str, context: str) -> List[Dict]:
        """
        蹇€熸鏌ュ叧閿０鏄庢槸鍚︽湁涓婁笅鏂囨敮鎸併€?        浣跨敤鍩轰簬 n-gram 鐨勯噸鍙犲害浼扮畻锛堜笉鏇夸唬 LLM 娣卞害妫€鏌ワ級銆?        """
        claims = []

        # 鎻愬彇鍥炵瓟涓殑鍏抽敭鍙ュ瓙
        sentences = re.split(r"[銆傦紒锛燂紱\n]", response)
        for sentence in sentences:
            sentence = sentence.strip()
            if len(sentence) < 10:
                continue

            # 浣跨敤瀛楃绾?Jaccard 浼扮畻閲嶅彔
            resp_chars = set(sentence)
            ctx_chars = set(context)
            if len(resp_chars) > 0:
                overlap = len(resp_chars & ctx_chars) / len(resp_chars)
            else:
                overlap = 0.0

            # 浣跨敤璇嶇骇 n-gram 閲嶅彔
            ngram_overlap = self._ngram_overlap(sentence, context, n=3)

            supported = overlap > 0.3 or ngram_overlap > 0.15
            claims.append(
                {
                    "text": sentence[:100],
                    "supported": supported,
                    "char_overlap": round(overlap, 2),
                    "ngram_overlap": round(ngram_overlap, 2),
                }
            )

        return claims

    @staticmethod
    def _ngram_overlap(text1: str, text2: str, n: int = 3) -> float:
        """璁＄畻涓や釜鏂囨湰鐨?n-gram 閲嶅彔搴?""
        if len(text1) < n or len(text2) < n:
            return 0.0

        def _get_ngrams(t: str, k: int) -> Set[str]:
            return {t[i : i + k] for i in range(len(t) - k + 1)}

        ngrams1 = _get_ngrams(text1, n)
        ngrams2 = _get_ngrams(text2, n)

        if not ngrams1:
            return 0.0

        intersection = len(ngrams1 & ngrams2)
        return intersection / len(ngrams1)

    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ LLM 娣卞害妫€娴?鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    async def _llm_detect(
        self,
        query: str,
        response: str,
        context: str,
        sources: Optional[List[str]] = None,
    ) -> Dict[str, Any]:
        """
        浣跨敤 LLM 杩涜澶氱淮搴﹀够瑙夋娴嬨€?
        Returns:
            LLM 杩斿洖鐨?JSON 瑙ｆ瀽缁撴灉
        """
        from src.services.llm import call_llm_fast

        # 鍑嗗涓婁笅鏂?        ctx_text = context[:CONTEXT_MAX_CHARS]
        if sources:
            ctx_text += "\n\n--- 棰濆鏉ユ簮 ---\n"
            ctx_text += "\n".join(f"- {s[:200]}" for s in sources[:10])

        prompt = self.DETECTION_PROMPT_TEMPLATE.format(
            query=query[:500],
            context=ctx_text,
            response=response[:RESPONSE_MAX_CHARS],
        )

        try:
            raw_result = await call_llm_fast(
                prompt,
                max_tokens=CRITIC_MAX_TOKENS,
                temperature=CRITIC_TEMPERATURE,
                system_prompt=self.SYSTEM_PROMPT,
            )

            if not raw_result:
                logger.warning("[SafetyCritic] LLM 杩斿洖绌虹粨鏋?)
                return {}

            parsed = self._safe_json_parse(raw_result)
            if not parsed:
                logger.warning(f"[SafetyCritic] LLM 缁撴灉 JSON 瑙ｆ瀽澶辫触: {raw_result[:200]}")
                return {}

            return parsed

        except Exception as e:
            logger.warning(f"[SafetyCritic] LLM 妫€娴嬪紓甯? {e}", exc_info=True)
            raise

    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ 浜ゅ弶楠岃瘉涓庡悎骞?鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    def _merge_spans(
        self,
        heuristic: Dict[str, List[Dict]],
        llm_fab: List[Dict],
        llm_dist: List[Dict],
        llm_logic: List[Dict],
        response: str,
    ) -> List[Dict]:
        """
        鍚堝苟鍚彂寮忓拰 LLM 妫€娴嬬殑鐗囨锛屽幓閲嶅苟鎻愰珮缃俊搴︺€?
        绛栫暐锛?        - 涓よ€呴兘妫€娴嬪埌鐨?鈫?楂樼疆淇″害锛堝彇 max锛?        - 鍙湁涓€鏂规娴嬪埌鐨?鈫?淇濈暀浣嗗彲鑳介檷浣庣疆淇″害
        - LLM 妫€娴嬬殑 start_pos/end_pos 鍙兘涓嶇簿纭紝浼樺厛浣跨敤鍚彂寮忎綅缃?        """
        merged: List[Dict] = []

        # 1. 鍔犲叆鍚彂寮忕粨鏋?        for dim in ["fabrication", "fact_distortion", "logic_contradiction"]:
            for span in heuristic.get(dim, []):
                merged.append(
                    {
                        **span,
                        "source": "heuristic",
                        "confidence": span.get("confidence", 0.5),
                    }
                )

        # 2. 鍚堝苟 LLM 缁撴灉锛堟彁楂樺尮閰嶇墖娈电殑缃俊搴︼級
        llm_spans = []
        for s in llm_fab:
            s_copy = dict(s)
            s_copy["type"] = "fabrication"
            s_copy["source"] = "llm"
            llm_spans.append(s_copy)
        for s in llm_dist:
            s_copy = dict(s)
            s_copy["type"] = "fact_distortion"
            s_copy["source"] = "llm"
            llm_spans.append(s_copy)
        for s in llm_logic:
            s_copy = dict(s)
            s_copy["type"] = "logic_contradiction"
            s_copy["source"] = "llm"
            llm_spans.append(s_copy)

        for llm_s in llm_spans:
            llm_text = llm_s.get("text", "")
            # 妫€鏌ユ槸鍚︿笌宸叉湁鐗囨閲嶅彔
            is_duplicate = False
            for existing in merged:
                if self._text_overlap(existing.get("text", ""), llm_text) > 0.5:
                    # 鎻愰珮缃俊搴︼紙鍙?max锛?                    existing["confidence"] = max(existing.get("confidence", 0), llm_s.get("confidence", 0))
                    existing["source"] = "hybrid"
                    # 琛ュ厖 LLM 鎻愪緵鐨勯澶栦俊鎭?                    if not existing.get("conflicting_context"):
                        existing["conflicting_context"] = llm_s.get(
                            "conflicting_context",
                            llm_s.get("correct_value", ""),
                        )
                    is_duplicate = True
                    break

            if not is_duplicate:
                # 楠岃瘉骞朵慨姝?LLM 鎻愪緵鐨勪綅缃?                start_pos = llm_s.get("start_pos", -1)
                end_pos = llm_s.get("end_pos", -1)

                # 濡傛灉浣嶇疆鏃犳晥锛?1锛夛紝灏濊瘯浠庡洖绛斾腑鏌ユ壘鏂囨湰浣嶇疆
                if start_pos < 0 and llm_text:
                    idx = response.find(llm_text)
                    if idx >= 0:
                        start_pos = idx
                        end_pos = idx + len(llm_text)

                merged.append(
                    {
                        "type": llm_s["type"],
                        "text": llm_text,
                        "start_pos": start_pos if start_pos >= 0 else -1,
                        "end_pos": end_pos if end_pos >= 0 else -1,
                        "confidence": llm_s.get("confidence", 0.6),
                        "reason": llm_s.get("reason", ""),
                        "conflicting_context": llm_s.get(
                            "conflicting_context",
                            llm_s.get("correct_value", ""),
                        ),
                        "severity": llm_s.get("severity", "medium"),
                        "source": "llm",
                    }
                )

        # 3. 鎸変綅缃帓搴?        merged.sort(key=lambda x: (x["start_pos"] if x["start_pos"] >= 0 else 99999))

        # 4. 鍘婚噸閲嶅彔鐗囨
        deduped = []
        for span in merged:
            is_overlap = False
            for existing in deduped:
                if self._span_overlap(span, existing):
                    # 淇濈暀缃俊搴︽洿楂樼殑
                    if span.get("confidence", 0) > existing.get("confidence", 0):
                        existing.update(span)
                    is_overlap = True
                    break
            if not is_overlap:
                deduped.append(span)

        return deduped

    @staticmethod
    def _text_overlap(text1: str, text2: str) -> float:
        """璁＄畻涓や釜鏂囨湰鐨勯噸鍙犲害"""
        if not text1 or not text2:
            return 0.0
        chars1 = set(text1)
        chars2 = set(text2)
        if not chars1 or not chars2:
            return 0.0
        return len(chars1 & chars2) / max(len(chars1), len(chars2))

    @staticmethod
    def _span_overlap(span1: Dict, span2: Dict) -> bool:
        """鍒ゆ柇涓や釜鐗囨鏄惁閲嶅彔"""
        s1 = span1.get("start_pos", -1)
        e1 = span1.get("end_pos", -1)
        s2 = span2.get("start_pos", -1)
        e2 = span2.get("end_pos", -1)

        if s1 < 0 or e1 < 0 or s2 < 0 or e2 < 0:
            return False

        return not (e1 < s2 or e2 < s1)

    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ 寰楀垎璁＄畻 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    def _compute_dimension_score(
        self,
        heuristic_spans: List[Dict],
        llm_dim_result: Dict,
    ) -> float:
        """
        璁＄畻鍗曚釜缁村害鐨勫够瑙夊緱鍒嗐€?
        鍥犲瓙:
        - LLM 璇勫垎鏉冮噸 0.6
        - 鍚彂寮忚瘎鍒嗘潈閲?0.4锛堝熀浜庝弗閲嶅害鍜岀疆淇″害鐨勭墖娈碉級
        """
        llm_score = llm_dim_result.get("score", 0.0) if llm_dim_result else 0.0

        # 鍩轰簬鍚彂寮忕墖娈佃绠楀垎鏁?        heuristic_score = 0.0
        if heuristic_spans:
            severity_weights = {"critical": 0.4, "high": 0.3, "medium": 0.15, "low": 0.05}
            for span in heuristic_spans:
                sv_weight = severity_weights.get(span.get("severity", "medium"), 0.1)
                confidence = span.get("confidence", 0.5)
                heuristic_score += sv_weight * confidence
            heuristic_score = min(heuristic_score, 1.0)  # 涓婇檺 1.0

        if llm_dim_result:
            # 鏈?LLM 缁撴灉锛氬姞鏉冨悎骞?            return round(llm_score * 0.6 + heuristic_score * 0.4, 4)
        else:
            # 绾惎鍙戝紡
            return round(heuristic_score, 4)

    def _determine_flags(
        self,
        spans: List[Dict],
        has_hallucination: bool,
        overall_score: float,
    ) -> List[str]:
        """鏍规嵁妫€娴嬬粨鏋滅‘瀹氬憡璀︽爣璁?""
        flags = []

        if has_hallucination:
            flags.append("hallucination_detected")

            # 妫€鏌ュ悇绫诲瀷
            types_found = set(s.get("type", "") for s in spans)
            if "fabrication" in types_found:
                flags.append("fabrication_found")
            if "fact_distortion" in types_found:
                flags.append("fact_distortion_found")
            if "logic_contradiction" in types_found:
                flags.append("logic_contradiction_found")

        # 涓ラ噸搴︾骇鍒?        if overall_score > 0.7:
            flags.append("hallucination_critical")
        elif overall_score > 0.5:
            flags.append("hallucination_high")
        elif overall_score > 0.3:
            flags.append("hallucination_medium")

        # 楂樹弗閲嶅害鐗囨
        critical_spans = [s for s in spans if s.get("severity") == "critical"]
        high_spans = [s for s in spans if s.get("severity") == "high"]
        if critical_spans:
            flags.append(f"critical_spans_{len(critical_spans)}")
        if high_spans:
            flags.append(f"high_severity_spans_{len(high_spans)}")

        return flags

