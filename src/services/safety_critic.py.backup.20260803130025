    async def batch_check(
        self,
        items: List[Dict[str, str]],
        use_llm: bool = True,
        max_concurrent: int = 5,
    ) -> List[HallucinationReport]:
        """
        鎵归噺骞昏妫€娴嬨€?
        Args:
            items: [{"query": "...", "response": "...", "context": "..."}, ...]
            use_llm: 鏄惁浣跨敤 LLM
            max_concurrent: 鏈€澶у苟鍙戞暟

        Returns:
            妫€娴嬫姤鍛婂垪琛?        """
        semaphore = asyncio.Semaphore(max_concurrent)

        async def _check_one(item: Dict) -> HallucinationReport:
            async with semaphore:
                try:
                    return await self.detect_hallucination(
                        query=item.get("query", ""),
                        response=item.get("response", ""),
                        context=item.get("context", ""),
                        sources=item.get("sources"),
                        use_llm=use_llm,
                    )
                except Exception as e:
                    logger.warning(f"[SafetyCritic] 鎵归噺妫€娴?#{item.get('query', '?')[:30]} 澶辫触: {e}")
                    return HallucinationReport(
                        report_id=f"batch_error_{hash(item.get('query', ''))}",
                        timestamp=time.time(),
                        query=item.get("query", "")[:200],
                        response="",
                        context="",
                        has_hallucination=False,
                        flags=["detection_error"],
                    )

        tasks = [_check_one(item) for item in items]
        results = await asyncio.gather(*tasks, return_exceptions=True)

        reports = []
        for i, r in enumerate(results):
            if isinstance(r, Exception):
                reports.append(
                    HallucinationReport(
                        report_id=f"batch_err_{i}",
                        timestamp=time.time(),
                        query=items[i].get("query", "")[:200],
                        response="",
                        context="",
                        flags=["batch_error"],
                    )
                )
            else:
                reports.append(r)

        return reports

