            fabrication_score=round(fab_score, 4),
            fact_distortion_score=round(dist_score, 4),
            logic_contradiction_score=round(logic_score, 4),
            spans=[
                {
                    "type": s.get("type", "unknown"),
                    "text": s.get("text", ""),
