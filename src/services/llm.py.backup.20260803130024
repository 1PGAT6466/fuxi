async def call_llm(
    prompt: str,
    system_prompt: str = None,
    max_tokens: int = 2048,
    temperature: float = 0.3,
    model: str = None,
    context: str = None,
    query: str = None,
    task_type: str = "general",
) -> str:
    """

    LLM Fallback 閾撅細MiMo 2.5 Pro  DeepSeek  绌?

    鎵€鏈夌敓鎴愪换鍔＄粺涓€鍏ュ彛

    v1.50 淇: 娣诲姞鍏ㄥ眬瓒呮椂淇濇姢锛?20绉掞級锛岄槻姝㈣皟鐢ㄩ摼鑰楁椂杩囬暱

    P1 浼樺寲:
      - context 鍙傛暟鏀寔妫€绱㈣川閲忚瘎浼颁笌娉ㄥ叆
      - 杈撳嚭鍚庡鐞嗚繃婊ゆ€濊€冮摼绛夊啑浣欏唴瀹?

    Args:

        prompt:       鐢ㄦ埛鎻愮ず璇?

        system_prompt: 绯荤粺鎻愮ず璇?

        max_tokens:   鏈€澶ц緭鍑?token 鏁?

        temperature:  娓╁害鍙傛暟

        model:        鎸囧畾妯″瀷锛堝彲閫夛級

        context:      RAG 妫€绱㈢粨鏋滄枃鏈紙鍙€夛紝浼犲叆鏃惰嚜鍔ㄨ瘎浼拌川閲忓苟娉ㄥ叆鎻愮ず锛?

        query:        鐢ㄦ埛鍘熷鏌ヨ锛堝彲閫夛紝鐢ㄤ簬璐ㄩ噺璇勪及锛涗笉浼犳椂浠?prompt 鎴彇锛?

        task_type:    浠诲姟绫诲瀷锛坓eneral/extraction/planning 绛夛紝褰卞搷鍚庡鐞嗙瓥鐣ワ級

    """

    # 濡傛灉浼犲叆浜?context锛屾敞鍏ユ绱㈣川閲忔彁绀哄埌 prompt

    effective_prompt = prompt

    if context is not None:

        if context.strip():

            quality_hint = _inject_quality_hint(query or prompt[:200], context)

            effective_prompt = f"{quality_hint}\n\n{prompt}"

        else:

            empty_hint = _QUALITY_HINT_TEMPLATES["empty"]

            effective_prompt = f"{empty_hint}\n\n{prompt}"

    # 鏋勫缓 messages 鐢ㄤ簬缂撳瓨key
    _messages_for_cache = []
    if system_prompt:
        _messages_for_cache.append({"role": "system", "content": system_prompt})
    _messages_for_cache.append({"role": "user", "content": _smart_truncate(effective_prompt, 8000)})

    # P0淇锛氭鏌ヨ涔夌紦瀛?
    cached = await get_cached_response(_messages_for_cache)
    if cached:
        return cached

    async def _inner():
        messages_inner = list(_messages_for_cache)
        # Level 1: MiMo 2.5 Pro
        for attempt in range(MAX_RETRIES):
            result = await _call_api(
                MIMO_BASE_URL,
                MIMO_API_KEY,
                model or MIMO_MODEL,
                messages_inner,
                max_tokens,
                temperature,
                MIMO_TIMEOUT,
            )
            if result:
                return _post_process_llm_output(result, task_type)
            if attempt < MAX_RETRIES - 1:
                await asyncio.sleep(RETRY_DELAY)
        # Level 2: DeepSeek v4 Pro
        if DEEPSEEK_API_KEY:
            result = await _call_api(
                DEEPSEEK_BASE_URL,
                DEEPSEEK_API_KEY,
                DEEPSEEK_MODEL,
                messages_inner,
                max_tokens,
                temperature,
                DEEPSEEK_TIMEOUT,
            )
            if result:
                return _post_process_llm_output(result, task_type)
        return ""

    try:
