def _post_process_llm_output(text: str, task_type: str = "general") -> str:
    """鍚庡鐞哃LM杈撳嚭锛岃繃婊ゆ€濊€冮摼绛夊啑浣欏唴瀹?""
    import re

    # 1. 绉婚櫎鎬濊€冮摼鏍囪锛?thinking>...</thinking> 鎴?<reasoning>...</reasoning>锛?
    text = re.sub(r"<thinking>.*?</thinking>", "", text, flags=re.DOTALL)
    text = re.sub(r"<reasoning>.*?</reasoning>", "", text, flags=re.DOTALL)

    # 2. 绉婚櫎澶ч噺閲嶅鐨勮В閲婃枃瀛楋紙浠ｇ爜鐢熸垚鍦烘櫙锛?
    if task_type == "code":
        # 鎻愬彇浠ｇ爜鍧楋紝涓㈠純瑙ｉ噴
        code_blocks = re.findall(r"```[\w]*\n(.*?)```", text, re.DOTALL)
        if code_blocks:
            return "\n\n".join(code_blocks)

    return text.strip()


def _smart_truncate(text: str, max_len: int = 8000) -> str:
    """鏅鸿兘鎴柇锛氫繚鐣欓灏?涓棿鍏抽敭娈?""
    if len(text) <= max_len:
        return text

    # 棣栭儴 40%锛堥€氬父鍖呭惈闂鍜岃儗鏅級
    head_len = int(max_len * 0.4)
    # 灏鹃儴 30%锛堥€氬父鍖呭惈缁撹鍜岃姹傦級
    tail_len = int(max_len * 0.3)
    # 涓棿 30%锛堝叧閿钀斤級
    mid_len = max_len - head_len - tail_len

    head = text[:head_len]
    tail = text[-tail_len:]
    mid_start = head_len + (len(text) - max_len) // 2
    mid = text[mid_start : mid_start + mid_len]

    return head + "\n\n... [涓棿鍐呭宸茬渷鐣 ...\n\n" + mid + "\n\n... [涓棿鍐呭宸茬渷鐣 ...\n\n" + tail


