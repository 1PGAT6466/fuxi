def _inject_quality_hint(query_text: str, context: str) -> str:
    """
    鏍规嵁妫€绱笂涓嬫枃璇勪及璐ㄩ噺骞惰繑鍥炲搴旂殑鎻愮ず淇℃伅銆?

    璇勫垎鍩轰簬涓や釜缁村害锛?
      - 闀垮害锛歝ontext 鐨勫瓧绗︽暟锛?200/200-1000/>1000锛?
      - 瀵嗗害锛氭湁鏁堟钀芥暟锛?/2-5/>5锛?
    """
    if not context or not context.strip():
        return _QUALITY_HINT_TEMPLATES["empty"]

    context_len = len(context)

    # 闀垮害璇勫垎
    if context_len < 200:
        length_score = 0  # low
    elif context_len < 1000:
        length_score = 1  # medium
    else:
        length_score = 2  # high

    # 瀵嗗害璇勫垎锛堟寜娈佃惤鍒嗛殧绗﹁鏁帮級
    paragraphs = [p.strip() for p in re.split(r"\n\n+|\n(?=[#\-鈥)", context) if p.strip()]
    para_count = len(paragraphs)
    if para_count <= 1:
        density_score = 0
    elif para_count <= 5:
        density_score = 1
    else:
        density_score = 2

    total = length_score + density_score

    if total <= 1:
        return _QUALITY_HINT_TEMPLATES["low"]
    elif total <= 3:
        return _QUALITY_HINT_TEMPLATES["medium"]
    else:
        return _QUALITY_HINT_TEMPLATES["high"]


