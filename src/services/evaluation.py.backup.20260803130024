                "recommendations": result.recommendations,
            }

            # 鎵归噺鍐欏叆浼樺寲
            self._batch_buffer.append(record)
            if len(self._batch_buffer) >= BATCH_FLUSH_SIZE:
                await self._flush_buffer()

        except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
            logger.warning(f"[Evaluation] 搴忓垪鍖栬瘎浼扮粨鏋滃け璐? {e}", exc_info=True)

    async def _flush_buffer(self) -> Any:
        """鎵归噺鍒锋柊缂撳啿鍖哄埌鏂囦欢"""
        if not self._batch_buffer:
            return

        buf = list(self._batch_buffer)
        self._batch_buffer.clear()

        try:

            def _write() -> Any:
                with open(EVAL_DB_PATH, "a", encoding="utf-8") as f:
                    for record in buf:
                        f.write(json.dumps(record, ensure_ascii=False) + "\n")

            await asyncio.to_thread(_write)
            if logger.isEnabledFor(logging.DEBUG):
                logger.debug(f"[Evaluation] 鎵归噺鍐欏叆 {len(buf)} 鏉¤瘎浼扮粨鏋?)
        except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
            logger.warning(f"[Evaluation] 鎵归噺鍐欏叆澶辫触: {e}", exc_info=True)
            # 澶辫触鏃舵斁鍥炵紦鍐插尯
            self._batch_buffer = buf + self._batch_buffer

