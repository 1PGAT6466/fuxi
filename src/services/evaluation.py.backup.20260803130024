class Evaluation:
    """
    妯″瀷璐ㄩ噺璇勪及闂幆

    鐢ㄦ硶:
        evaluator = Evaluation()
        result = await evaluator.evaluate_response(
            query="浠€涔堟槸 SAG 涓夐樁娈?,
            response="SAG 鏄竴绉嶆绱㈠寮虹敓鎴愮瓥鐣?..",
            context="妫€绱㈠埌鐨勬枃妗ｅ唴瀹?.."
        )
        print(f"缁煎悎寰楀垎: {result.overall_score}")
    """

    # 鏉冮噸閰嶇疆锛氬洓缁村姞鏉冩眰鍜岋紙鍙€氳繃鐜鍙橀噺瑕嗙洊锛?
    WEIGHTS = {
        "relevancy": 0.25,
        "accuracy": 0.30,
        "completeness": 0.20,
        "hallucination": 0.25,
    }

    # 鍒嗘暟闃堝€?
    PASS_THRESHOLD = 0.60  # 缁煎悎寰楀垎閫氳繃绾?
    WARNING_THRESHOLD = 0.50  # 缁煎悎寰楀垎璀﹀憡绾?
    CRITICAL_THRESHOLD = 0.35  # 缁煎悎寰楀垎涓ラ噸绾?
    HALLUCINATION_ALERT = 0.30  # 骞昏寰楀垎 > 姝ゅ€艰Е鍙戝憡璀︼紙鍊艰秺楂樿秺宸級

    def __init__(self):
        self._eval_semaphore = asyncio.Semaphore(MAX_CONCURRENT_EVALS)
        self._batch_buffer: List[Dict] = []
        self._dedup_cache: Dict[str, float] = {}
        self._last_dedup_cleanup = time.time()
        self._eval_index: Dict[str, str] = {}
        self._load_index()

    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ 涓诲叆鍙?鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    async def evaluate_response(
        self,
        query: str,
        response: str,
        context: str = "",
        sources: List[str] = None,
        model: str = "mimo-v2.5",
        trace_id: str = "",
        session_id: str = "",
        threshold: float = None,
    ) -> EvaluationResult:
        """
        瀵逛竴娆?RAG 鍥炵瓟杩涜鍏ㄧ淮搴﹁川閲忚瘎浼般€?

        Args:
            query: 鐢ㄦ埛鍘熷鏌ヨ
            response: 妯″瀷鐢熸垚鐨勫洖绛?
            context: 妫€绱㈠埌鐨勪笂涓嬫枃鍐呭
            sources: 妫€绱㈡潵婧愬垪琛紙鐢ㄤ簬骞昏妫€娴嬶級
            model: 浣跨敤鐨勬ā鍨嬪悕绉?
            trace_id: 閾捐矾杩借釜 ID
            session_id: 浼氳瘽 ID
            threshold: 鑷畾涔夐€氳繃闃堝€?

        Returns:
            EvaluationResult: 鍖呭惈鍥涚淮寰楀垎鍜岀患鍚堝緱鍒嗙殑璇勪及缁撴灉
        """
        t0 = time.time()

        if threshold is None:
            threshold = self.PASS_THRESHOLD

        # 1. 鍘婚噸妫€鏌?
        dedup_key = self._make_dedup_key(query, response)
        if self._is_duplicate(dedup_key):
            logger.debug(f"[Evaluation] 璺宠繃閲嶅璇勪及: {dedup_key[:16]}")
            # 杩斿洖缂撳瓨鏍囪
            return EvaluationResult(
                eval_id=dedup_key,
                timestamp=t0,
                query=query[:200],
                response=response[:200],
                context=context[:200],
                overall_score=-1.0,
                passed=True,
                dimensions=[],
                flags=["cached_duplicate"],
            )

        async with self._eval_semaphore:
            # 鐢熸垚璇勪及 ID
            eval_id = self._make_eval_id(query, response, t0)

            # 2. 骞惰璇勪及鍥涗釜缁村害锛堟帶鍒?LLM 璋冪敤娆℃暟 鈮?3锛?
            dim_results = await self._evaluate_dimensions(query, response, context, sources)

            # 3. 璁＄畻缁煎悎寰楀垎
            overall, dim_scores = self._compute_overall(dim_results)
            passed = overall >= threshold

            # 4. 骞昏鍛婅妫€娴?
            flags = self._check_flags(dim_scores)

            # 5. 鐢熸垚鏀硅繘寤鸿
            recommendations = self._generate_recommendations(dim_scores, overall)

            # 6. 鏋勫缓缁撴灉
            latency = (time.time() - t0) * 1000

            result = EvaluationResult(
                eval_id=eval_id,
                timestamp=t0,
                query=query[:500],
                response=response[:500],
                context=context[:500],
                relevancy_score=dim_scores.get("relevancy", 0.0),
                accuracy_score=dim_scores.get("accuracy", 0.0),
                completeness_score=dim_scores.get("completeness", 0.0),
                hallucination_score=dim_scores.get("hallucination", 0.0),
                overall_score=round(overall, 4),
                passed=passed,
                threshold=threshold,
                dimensions=[
                    {
                        "dimension": k,
                        "score": v,
                        "detail": dim_results.get(f"{k}_detail", ""),
                        "issues": dim_results.get(f"{k}_issues", []),
                    }
                    for k, v in dim_scores.items()
                ],
                model=model,
                trace_id=trace_id,
                session_id=session_id,
                latency_ms=round(latency, 1),
                recommendations=recommendations,
                flags=flags,
            )

            # 7. 寮傛鎸佷箙鍖?+ 瑙﹀彂鍙嶉闂幆
            asyncio.create_task(self._persist_and_trigger(result))

            if logger.isEnabledFor(logging.DEBUG):
                logger.debug(
                    f"[Evaluation] {eval_id[:12]} 瀹屾垚: overall={overall:.3f}, "
                    f"relevancy={dim_scores.get('relevancy', 0):.2f}, "
                    f"accuracy={dim_scores.get('accuracy', 0):.2f}, "
                    f"completeness={dim_scores.get('completeness', 0):.2f}, "
                    f"hallucination={dim_scores.get('hallucination', 0):.2f}, "
                    f"passed={passed}, flags={flags}"
                )
            elif logger.isEnabledFor(logging.INFO):
                if not passed:
                    logger.warning(f"[Evaluation] {eval_id[:12]} 鏈€氳繃: overall={overall:.3f}, " f"flags={flags}")

            # 璁板綍鍘婚噸
            self._dedup_cache[dedup_key] = t0

            return result

    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ 缁村害璇勪及 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    async def _evaluate_dimensions(
        self,
        query: str,
        response: str,
        context: str,
        sources: Optional[List[str]] = None,
    ) -> Dict[str, Any]:
        """骞惰璇勪及鍥涗釜缁村害銆侺LM 璋冪敤娆℃暟锛?-3 娆★紙鐩稿叧鎬?鍑嗙‘鎬?1 娆★紝瀹屾暣鎬?1 娆★紝骞昏 0-1 娆★級"""

        dimensions = {}

        # 璋冪敤 1: 鐩稿叧鎬?+ 鍑嗙‘鎬э紙鍚堝苟涓轰竴娆?LLM 璋冪敤锛?
        rel_acc_task = self._eval_relevancy_accuracy(query, response, context)

        # 璋冪敤 2: 瀹屾暣鎬э紙鐙珛璋冪敤锛?
        comp_task = self._eval_completeness(query, response)

        rel_acc_result, comp_result = await asyncio.gather(rel_acc_task, comp_task, return_exceptions=True)

        # 澶勭悊鐩稿叧鎬?鍑嗙‘鎬х粨鏋?
        if isinstance(rel_acc_result, Exception):
            logger.warning(f"[Evaluation] 鐩稿叧鎬?鍑嗙‘鎬ц瘎浼板け璐? {rel_acc_result}")
            dimensions.update(
                {
                    "relevancy": 0.5,
                    "relevancy_detail": f"璇勪及澶辫触: {rel_acc_result}",
                    "accuracy": 0.5,
                    "accuracy_detail": f"璇勪及澶辫触: {rel_acc_result}",
                }
            )
        else:
            dimensions.update(rel_acc_result)

        # 澶勭悊瀹屾暣鎬х粨鏋?
        if isinstance(comp_result, Exception):
            logger.warning(f"[Evaluation] 瀹屾暣鎬ц瘎浼板け璐? {comp_result}")
            dimensions["completeness"] = 0.5
            dimensions["completeness_detail"] = f"璇勪及澶辫触: {comp_result}"
        else:
            dimensions["completeness"] = comp_result.get("completeness", 0.5)
            dimensions["completeness_detail"] = comp_result.get("detail", "")
            dimensions["completeness_issues"] = comp_result.get("issues", [])

        # 璋冪敤 3: 骞昏妫€娴嬶紙浠呭湪涓婁笅鏂囧瓨鍦ㄦ椂鎵嶈繘琛?LLM 妫€娴嬶級
        if context and len(context.strip()) > 20:
            try:
                hall_result = await self._eval_hallucination(query, response, context, sources)
                if isinstance(hall_result, Exception):
                    logger.warning(f"[Evaluation] 骞昏妫€娴嬪け璐? {hall_result}")
                    dimensions["hallucination"] = 0.5
                    dimensions["hallucination_detail"] = f"妫€娴嬪け璐? {hall_result}"
                else:
                    dimensions.update(hall_result)
            except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
                logger.warning(f"[Evaluation] 骞昏妫€娴嬪紓甯? {e}")
                dimensions["hallucination"] = 0.5
                dimensions["hallucination_detail"] = f"妫€娴嬪紓甯? {e}"
        else:
            # 鏃犱笂涓嬫枃鏃朵娇鐢ㄥ惎鍙戝紡瑙勫垯
            dims = self._heuristic_hallucination_check(query, response)
            dimensions.update(dims)

        return dimensions

