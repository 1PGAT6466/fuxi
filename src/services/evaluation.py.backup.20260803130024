    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ 璇勪及鎶ュ憡 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    async def generate_report(
        self,
        start_time: float = None,
        end_time: float = None,
        min_samples: int = 1,
    ) -> Dict[str, Any]:
        """
        鐢熸垚璇勪及鎶ュ憡锛氭眹鎬绘寚瀹氭椂闂磋寖鍥村唴鐨勮瘎浼扮粨鏋溿€?

        Args:
            start_time: 寮€濮嬫椂闂存埑
            end_time: 缁撴潫鏃堕棿鎴?
            min_samples: 鏈€灏忔牱鏈暟锛堜笉瓒虫椂杩斿洖 insufficient_data锛?

        Returns:
            璇勪及鎶ュ憡 dict
        """
        if start_time is None:
            start_time = time.time() - 3600  # 榛樿鏈€杩?1 灏忔椂
        if end_time is None:
            end_time = time.time()

        records = await self._load_evaluations(start_time, end_time)

        if len(records) < min_samples:
            return {
                "status": "insufficient_data",
                "sample_count": len(records),
                "required_min": min_samples,
                "period": {
                    "start": start_time,
                    "end": end_time,
                },
            }

        # 姹囨€荤粺璁?
        overall_scores = []
        dim_scores = {"relevancy": [], "accuracy": [], "completeness": [], "hallucination": []}
        pass_count = 0
        flag_counts = {}
        hallucination_count = 0

        for r in records:
            scores = r.get("scores", r)
            ov = scores.get("overall", 0)
            if ov > 0:  # 鎺掗櫎缂撳瓨鐨勯噸澶嶉」
                overall_scores.append(ov)
            for dim in dim_scores:
                val = scores.get(dim, 0)
                dim_scores[dim].append(val)

            if r.get("passed", False):
                pass_count += 1

            for flag in r.get("flags", []):
                flag_counts[flag] = flag_counts.get(flag, 0) + 1
            if "hallucination_detected" in r.get("flags", []):
                hallucination_count += 1

        total = len(records)
        report = {
            "status": "ok",
            "timestamp": time.time(),
            "period": {
                "start": start_time,
                "end": end_time,
            },
            "sample_count": total,
            "overall": {
                "avg": round(sum(overall_scores) / len(overall_scores), 4) if overall_scores else 0,
                "min": round(min(overall_scores), 4) if overall_scores else 0,
                "max": round(max(overall_scores), 4) if overall_scores else 0,
                "p50": self._percentile(overall_scores, 50),
                "p95": self._percentile(overall_scores, 95),
            },
            "pass_rate": round(pass_count / total, 4) if total > 0 else 0,
            "dimensions": {
                dim: {
                    "avg": round(sum(vals) / len(vals), 4) if vals else 0,
                    "min": round(min(vals), 4) if vals else 0,
                }
                for dim, vals in dim_scores.items()
                if vals
            },
            "flags_summary": flag_counts,
            "hallucination_rate": round(hallucination_count / total, 4) if total > 0 else 0,
            "recommendations": self._report_recommendations(pass_count, total, hallucination_count, dim_scores),
        }

        # 淇濆瓨鎶ュ憡
        asyncio.create_task(self._save_report(report))

        return report

    def _report_recommendations(
        self,
        pass_count: int,
        total: int,
        hallucination_count: int,
        dim_scores: Dict[str, List[float]],
    ) -> List[str]:
        """鐢熸垚鎶ュ憡绾у埆鐨勬敼杩涘缓璁?""
        recs = []
        pass_rate = pass_count / total if total > 0 else 0

        if pass_rate < 0.6:
            recs.append(f"閫氳繃鐜囦粎 {pass_rate:.1%}锛屽缓璁鏌ユā鍨嬪拰妫€绱㈤厤缃?)
        if hallucination_count / total > 0.2 if total > 0 else False:
            recs.append(f"骞昏鐜?{hallucination_count/total:.1%} 鍋忛珮锛屽缓璁惎鐢ㄤ弗鏍间簨瀹炴牎楠?)

        for dim, vals in dim_scores.items():
            if vals:
                avg = sum(vals) / len(vals)
                if dim == "relevancy" and avg < 0.5:
                    recs.append("妫€绱㈢浉鍏虫€у亸浣庯紝寤鸿浼樺寲鏌ヨ鏀瑰啓")
                elif dim == "accuracy" and avg < 0.5:
                    recs.append("鍥炵瓟鍑嗙‘鎬у亸浣庯紝寤鸿闄嶄綆鐢熸垚娓╁害")
                elif dim == "completeness" and avg < 0.5:
                    recs.append("鍥炵瓟瀹屾暣鎬т笉瓒筹紝寤鸿澧炲姞妫€绱㈡繁搴?)

        return recs

    async def _save_report(self, report: Dict) -> Any:
        """淇濆瓨璇勪及鎶ュ憡鍒版枃浠?""
        try:
            date_str = datetime.fromtimestamp(report["timestamp"]).strftime("%Y%m%d_%H%M%S")
            report_file = EVAL_REPORTS_DIR / f"quality_report_{date_str}.json"

            def _write_report() -> Any:
                with open(report_file, "w", encoding="utf-8") as f:
                    json.dump(report, f, ensure_ascii=False, indent=2)

            await asyncio.to_thread(_write_report)
            logger.info(f"[Evaluation] 璐ㄩ噺鎶ュ憡宸蹭繚瀛? {report_file}")
        except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
            logger.warning(f"[Evaluation] 鎶ュ憡淇濆瓨澶辫触: {e}", exc_info=True)

    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ 鏁版嵁鍔犺浇 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    async def _load_evaluations(self, start_time: float, end_time: float) -> List[Dict]:
        """鍔犺浇鎸囧畾鏃堕棿鑼冨洿鍐呯殑璇勪及缁撴灉"""
        if not EVAL_DB_PATH.exists():
            return []

        # 鍏堝埛鏂扮紦鍐插尯
        if self._batch_buffer:
            await self._flush_buffer()

        records = []
        try:

            def _read() -> Any:
                result = []
                with open(EVAL_DB_PATH, "r", encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if not line:
                            continue
                        try:
                            record = json.loads(line)
                            ts = record.get("timestamp", 0)
                            if start_time <= ts <= end_time:
                                result.append(record)
                        except json.JSONDecodeError:
                            continue
                return result

            records = await asyncio.to_thread(_read)
        except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
            logger.warning(f"[Evaluation] 鍔犺浇璇勪及鏁版嵁澶辫触: {e}", exc_info=True)

        return records

    def _load_index(self) -> Any:
        """鍔犺浇璇勪及绱㈠紩"""
        if EVAL_INDEX_PATH.exists():
            try:
                self._eval_index = json.loads(EVAL_INDEX_PATH.read_text(encoding="utf-8"))
            except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
                self._eval_index = {}

    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ 鏌ヨ鎺ュ彛 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    async def get_stats(self, hours: int = 24) -> Dict[str, Any]:
        """鑾峰彇璇勪及缁熻鎽樿"""
        cutoff = time.time() - hours * 3600
        records = await self._load_evaluations(cutoff, time.time())

        total = len(records)
        if total == 0:
            return {
                "total_evaluations": 0,
                "avg_overall_score": 0,
                "pass_rate": 0,
                "hallucination_rate": 0,
            }

        scores = []
        passed = 0
        hallucinations = 0
        for r in records:
            s = r.get("scores", r)
            ov = s.get("overall", 0)
            if ov > 0:
                scores.append(ov)
            if r.get("passed"):
                passed += 1
            if "hallucination_detected" in r.get("flags", []):
                hallucinations += 1

        return {
            "total_evaluations": total,
            "avg_overall_score": round(sum(scores) / len(scores), 4) if scores else 0,
            "pass_rate": round(passed / total, 4),
            "hallucination_rate": round(hallucinations / total, 4),
            "dimensions": self._aggregate_dimensions(records),
        }

    def _aggregate_dimensions(self, records: List[Dict]) -> Dict[str, float]:
        """姹囨€荤淮搴﹀緱鍒?""
        dims = {"relevancy": [], "accuracy": [], "completeness": [], "hallucination": []}
        for r in records:
            scores = r.get("scores", r.get("dimensions", r))
            for dim in dims:
                val = scores.get(dim, None)
                if val is not None:
                    dims[dim].append(val)

        return {dim: round(sum(vals) / len(vals), 4) if vals else 0.0 for dim, vals in dims.items()}

    async def get_recent_failures(self, limit: int = 20) -> List[Dict]:
        """鑾峰彇鏈€杩戣瘎浼板け璐ョ殑璁板綍"""
        cutoff = time.time() - 86400  # 鏈€杩?24 灏忔椂
        records = await self._load_evaluations(cutoff, time.time())
        failures = [r for r in records if not r.get("passed", True)]
        failures.sort(key=lambda x: x.get("timestamp", 0), reverse=True)
        return failures[:limit]

    # 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€ 宸ュ叿鏂规硶 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€

    def _make_dedup_key(self, query: str, response: str) -> str:
        """鐢熸垚鍘婚噸 key"""
        raw = f"{query[:200]}|{response[:200]}"
        return hashlib.sha256(raw.encode()).hexdigest()[:32]

    def _is_duplicate(self, key: str) -> bool:
        """妫€鏌ユ槸鍚﹂噸澶?""
        now = time.time()
        # 瀹氭湡娓呯悊杩囨湡鍘婚噸椤?
        if now - self._last_dedup_cleanup > 600:  # 姣?10 鍒嗛挓娓呯悊
            self._dedup_cache = {k: v for k, v in self._dedup_cache.items() if now - v < DEDUP_WINDOW}
            self._last_dedup_cleanup = now

        return key in self._dedup_cache and now - self._dedup_cache[key] < DEDUP_WINDOW

    def _make_eval_id(self, query: str, response: str, timestamp: float) -> str:
        """鐢熸垚鍞竴璇勪及 ID"""
        raw = f"{query[:100]}|{response[:100]}|{timestamp}"
        return "eval_" + hashlib.sha256(raw.encode()).hexdigest()[:16]

    @staticmethod
    def _safe_json_parse(text: str) -> Dict[str, Any]:
        """瀹夊叏瑙ｆ瀽 LLM 杩斿洖鐨?JSON"""
        text = text.strip()
        # 鎻愬彇 JSON 鍧?
        s = text.find("{")
        e = text.rfind("}")
        if s >= 0 and e > s:
            try:
                return json.loads(text[s : e + 1])
            except json.JSONDecodeError:
                pass
        # 灏濊瘯淇甯歌鏍煎紡闂
        try:
            return json.loads(text)
        except json.JSONDecodeError:
            pass
        return {}

    @staticmethod
    def _percentile(data: List[float], p: float) -> float:
        """璁＄畻鐧惧垎浣嶆暟"""
        if not data:
            return 0.0
        sorted_data = sorted(data)
        k = (len(sorted_data) - 1) * p / 100.0
        f = int(k)
        c = k - f
        if f + 1 < len(sorted_data):
            return round(sorted_data[f] + c * (sorted_data[f + 1] - sorted_data[f]), 4)
        return round(sorted_data[f], 4)

    async def flush(self) -> Any:
        """寮哄埗鍒锋柊鎵€鏈夌紦鍐插尯锛坓raceful shutdown 鏃惰皟鐢級"""
        await self._flush_buffer()
        await self._flush_index()
        logger.info("[Evaluation] 宸插埛鏂版墍鏈夌紦鍐叉暟鎹?)

    async def clear_dedup_cache(self) -> Any:
        """娓呯┖鍘婚噸缂撳瓨"""
        self._dedup_cache.clear()
        self._last_dedup_cleanup = time.time()
        logger.info("[Evaluation] 鍘婚噸缂撳瓨宸叉竻绌?)


