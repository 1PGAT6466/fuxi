    async def _eval_hallucination(
        self,
        query: str,
        response: str,
        context: str,
        sources: Optional[List[str]] = None,
    ) -> Dict[str, Any]:
        """
        妫€娴嬪够瑙夛細浣跨敤 SafetyCritic 杩涜澶氱淮搴︽娴嬨€?

