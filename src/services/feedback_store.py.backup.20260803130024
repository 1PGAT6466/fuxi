import asyncio
import hashlib
import logging
import threading
import time
from collections import deque
from typing import Dict, List, Optional

try:
    from cachetools import TTLCache
except ImportError:
    TTLCache = None  # fallback to manual dict LRU

logger = logging.getLogger(__name__)

# 鍘婚噸绐楀彛锛堢锛夛細鍚屼竴涓敤鎴峰悓涓€鏉℃煡璇㈢殑鍙嶉 300 绉掑唴鍙褰曚竴娆?
DEDUP_WINDOW = 300
# 鎵归噺瀛︿範闃堝€硷細buffer 绉疮鍒板灏戞潯鏃惰Е鍙戝涔?
LEARN_BUFFER_SIZE = 20
# 鏈€澶у幓閲嶇紦瀛樺ぇ灏忥紙绠€鍗?LRU锛?
MAX_DEDUP_CACHE = 2000
# 鎵归噺澶辫触鏈€澶ч噸璇曟鏁?
MAX_RETRY = 3

# 鈹€鈹€ P1: 鎵归噺鍐欏叆缂撳啿 鈹€鈹€
_WRITE_BUFFER_MAX_SIZE = 100  # 鏈€澶х紦鍐叉潯鏁?
_WRITE_BUFFER_FLUSH_INTERVAL = 5.0  # 姣?绉?flush
_write_buffer: List[Dict] = []
_write_buffer_lock = threading.Lock()
_flush_task: Optional[asyncio.Task] = None

# 妯″潡绾у幓閲嶇紦瀛橈紙TTLCache 鑷姩杩囨湡 + maxsize 闄愬埗锛宼hreadsafe锛?
if TTLCache is not None:
    _feedback_dedup = TTLCache(maxsize=MAX_DEDUP_CACHE, ttl=DEDUP_WINDOW)
    _use_ttl_cache = True
else:
    _feedback_dedup: Dict[str, float] = {}  # fallback
    _use_ttl_cache = False
_feedback_dedup_lock = threading.Lock()
_learn_buffer: deque = deque()
_learn_buffer_lock = threading.Lock()


# 鈹€鈹€ P1: 鎵归噺鍐欏叆缂撳啿 鈹€鈹€


async def _start_flush_scheduler():
    """鍚姩瀹氭椂 flush 璋冨害鍣?""
    global _flush_task
    if _flush_task is not None:
        return

    async def _scheduler():
        while True:
            try:
                await asyncio.sleep(_WRITE_BUFFER_FLUSH_INTERVAL)
                await _flush_write_buffer()
            except asyncio.CancelledError:
                logger.info("[鍙嶉闂幆] 瀹氭椂 flush 璋冨害鍣ㄥ凡鍋滄")
                break
            except Exception as e:
                logger.error(f"[鍙嶉闂幆] 瀹氭椂 flush 寮傚父: {e}", exc_info=True)

    _flush_task = asyncio.create_task(_scheduler())
    logger.info(
        f"[鍙嶉闂幆] 鎵归噺鍐欏叆缂撳啿宸插惎鍔?"
        f"(max_buffer={_WRITE_BUFFER_MAX_SIZE}, flush_interval={_WRITE_BUFFER_FLUSH_INTERVAL}s)"
    )


async def _stop_flush_scheduler():
    """鍋滄瀹氭椂 flush 璋冨害鍣?""
    global _flush_task
    if _flush_task:
        # 鏈€缁?flush
        await _flush_write_buffer()
        _flush_task.cancel()
        try:
            await _flush_task
        except asyncio.CancelledError:
            pass
        _flush_task = None


async def _flush_write_buffer():
    """灏嗙紦鍐插尯涓殑鏉＄洰鎵归噺鍐欏叆鏂囦欢"""
    global _write_buffer
    with _write_buffer_lock:
        if not _write_buffer:
            return
        batch = _write_buffer[:]
        _write_buffer.clear()

    if not batch:
        return

    try:
        import json
        import os

        from src.config import FEEDBACK_DIR

        # 鎸夋棩鏈熷垎缁?
        entries_by_day: Dict[str, list] = {}
        for entry in batch:
            day = time.strftime("%Y-%m-%d", time.localtime(entry.get("timestamp", time.time())))
            if day not in entries_by_day:
                entries_by_day[day] = []
            entries_by_day[day].append(
                {
                    "user_id": entry["user_id"],
                    "query": entry["query"],
                    "action": entry["action"],
                    "timestamp": entry["timestamp"],
                    "results_count": len(entry.get("results", [])),
                    "metadata": entry.get("metadata"),
                }
            )

        # 鎵归噺鍐欏叆
        for day, day_entries in entries_by_day.items():
            os.makedirs(FEEDBACK_DIR, exist_ok=True)
            log_path = os.path.join(FEEDBACK_DIR, f"feedback_{day}.jsonl")
            with open(log_path, "a", encoding="utf-8") as f:
                for entry in day_entries:
                    f.write(json.dumps(entry, ensure_ascii=False) + "\n")

        logger.debug(f"[鍙嶉闂幆] 鎵归噺鍐欏叆 {len(batch)} 鏉″弽棣?)
    except Exception as e:
        logger.warning(f"[鍙嶉闂幆] 鎵归噺鍐欏叆澶辫触: {e}", exc_info=True)
        # 澶辫触鏃舵斁鍥炵紦鍐插尯锛堟渶澶氶噸璇曪級
        with _write_buffer_lock:
            for entry in batch:
                entry["_write_retry"] = entry.get("_write_retry", 0) + 1
            still_retry = [e for e in batch if e.get("_write_retry", 0) < MAX_RETRY]
            _write_buffer = still_retry + _write_buffer


def _add_to_write_buffer(
    user_id: str, query: str, action: str, results: Optional[List], metadata: Optional[Dict], timestamp: float
):
    """娣诲姞鏉＄洰鍒板啓鍏ョ紦鍐插尯锛圥1: 鎵归噺缂撳啿鏇夸唬鐩存帴鍐欏叆锛?""
    with _write_buffer_lock:
        _write_buffer.append(
            {
                "user_id": user_id,
                "query": query,
                "action": action,
                "results": results,
                "metadata": metadata,
                "timestamp": timestamp,
            }
        )

        buffer_size = len(_write_buffer)

    # 濡傛灉缂撳啿鍖烘弧锛岃Е鍙戝紓姝?flush
    if buffer_size >= _WRITE_BUFFER_MAX_SIZE:
        try:
            loop = asyncio.get_event_loop()
            if loop.is_running():
                asyncio.create_task(_flush_write_buffer())
        except RuntimeError:
            pass  # 浜嬩欢寰幆鏈繍琛岋紝涓嬫瀹氭椂 flush 鏃跺啓鍏?


def _make_feedback_key(user_id: str, query: str, action: str) -> str:
    """鐢熸垚鍙嶉鍘婚噸 key"""
    raw = f"{user_id}|{query}|{action}"
    return hashlib.sha256(raw.encode()).hexdigest()[:16]


# FAKE-ASYNC: 鏈嚱鏁版爣璁?async 浠呬负鎺ュ彛缁熶竴锛屽唴閮ㄥ悓姝ユ墽琛?
async def log_feedback_unified(
    user_id: str, query: str, action: str, results: Optional[List] = None, metadata: Optional[Dict] = None
) -> Dict:
    """
    缁熶竴鍙嶉璁板綍鍏ュ彛
    杩斿洖: {"ok": True, "dedup": bool, "learn_triggered": bool}
    """
    now = time.time()

    # 1. 鍘婚噸妫€鏌ワ紙threadsafe锛?
    key = _make_feedback_key(user_id, query, action)
    is_dup = False
    with _feedback_dedup_lock:
        if _use_ttl_cache:
            # TTLCache 鑷姩澶勭悊杩囨湡鍜?maxsize锛屽彧闇€ set
            if key in _feedback_dedup:
                is_dup = True
            else:
                _feedback_dedup[key] = now
        else:
            # fallback: 鎵嬪姩妫€鏌ヨ繃鏈?+ LRU
            if key in _feedback_dedup and now - _feedback_dedup[key] < DEDUP_WINDOW:
                is_dup = True
            else:
                _feedback_dedup[key] = now
                # LRU 娣樻卑
                if len(_feedback_dedup) > MAX_DEDUP_CACHE:
                    sorted_keys = sorted(_feedback_dedup.items(), key=lambda x: x[1])
                    for old_key, _ in sorted_keys[: len(_feedback_dedup) // 2]:
                        del _feedback_dedup[old_key]

    if is_dup:
        return {"ok": True, "dedup": True, "learn_triggered": False}

    # 2. 鍐欏叆鍙嶉缂撳啿鍖猴紙P1: 鎵归噺缂撳啿鏇夸唬鐩存帴鍐欏叆锛?
    try:
        _add_to_write_buffer(user_id, query, action, results, metadata, now)
    except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:
        logger.warning("娣诲姞鍙嶉鍒扮紦鍐插尯澶辫触", exc_info=True)

    # 3. 绉疮瀛︿範 buffer
    learn_triggered = False
    with _learn_buffer_lock:
        _learn_buffer.append(
            {
                "user_id": user_id,
                "query": query,
                "action": action,
                "results": results,
                "timestamp": now,
            }
        )

        # 4. buffer 婊′簡瑙﹀彂瀛︿範
        if len(_learn_buffer) >= LEARN_BUFFER_SIZE:
            asyncio.create_task(_maybe_learn_batch())
            learn_triggered = True

    return {"ok": True, "dedup": False, "learn_triggered": learn_triggered}


def _write_feedback_log(
    user_id: str, query: str, action: str, results: Optional[List], metadata: Optional[Dict], timestamp: float
):
    """灏嗗弽棣堝啓鍏ユ棩蹇楁枃浠?""
    import json
    import os

    from src.config import FEEDBACK_DIR

    os.makedirs(FEEDBACK_DIR, exist_ok=True)
    day = time.strftime("%Y-%m-%d", time.localtime(timestamp))
    log_path = os.path.join(FEEDBACK_DIR, f"feedback_{day}.jsonl")

    entry = {
        "user_id": user_id,
        "query": query,
        "action": action,
        "timestamp": timestamp,
        "results_count": len(results) if results else 0,
        "metadata": metadata,
    }
    with open(log_path, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


async def _maybe_learn_batch():
    """鎵归噺瀛︿範锛氫粠 buffer 涓彁鍙栨璐熸牱鏈紝璋冪敤 learner"""
    global _learn_buffer
    with _learn_buffer_lock:
        if len(_learn_buffer) < LEARN_BUFFER_SIZE:
            return
        batch = list(_learn_buffer)
        _learn_buffer.clear()

    try:
        from src.services.learner import learn_from_feedback

        await learn_from_feedback(batch)
        logger.info(f"[鍙嶉闂幆] 瀛︿範瀹屾垚: {len(batch)} 鏉″弽棣?)
    except ImportError:
        logger.debug("[鍙嶉闂幆] learner 妯″潡涓嶅瓨鍦紝璺宠繃鎵归噺瀛︿範")
    except (OSError, ValueError, KeyError, ConnectionError, TimeoutError) as e:  # TODO: Narrow exception type
        logger.warning("[鍙嶉闂幆] 瀛︿範澶辫触", exc_info=True)
        # 澶辫触鏃舵斁鍥?buffer锛堟渶澶氶噸璇?MAX_RETRY 娆★級
        for item in batch:
            item["_retry_count"] = item.get("_retry_count", 0) + 1
        still_retry = [i for i in batch if i.get("_retry_count", 0) < MAX_RETRY]
        with _learn_buffer_lock:
            _learn_buffer.extendleft(still_retry[::-1])


def get_feedback_stats() -> Dict:
    """鑾峰彇鍙嶉缁熻"""
    with _feedback_dedup_lock:
        dedup_size = len(_feedback_dedup)
    with _learn_buffer_lock:
        buffer_size = len(_learn_buffer)
    return {
        "dedup_cache_size": dedup_size,
        "learn_buffer_size": buffer_size,
        "learn_buffer_threshold": LEARN_BUFFER_SIZE,
    }


def clear_feedback_cache():
    """娓呯┖鍘婚噸缂撳瓨"""
    global _feedback_dedup
    with _feedback_dedup_lock:
        if _use_ttl_cache:
            _feedback_dedup.clear()
        else:
            _feedback_dedup = {}
    logger.info("[鍙嶉闂幆] 鍘婚噸缂撳瓨宸叉竻绌?)
