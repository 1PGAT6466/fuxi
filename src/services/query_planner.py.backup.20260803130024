_COMPLEX_PATTERNS = [
    (r"(鍒嗘瀽|璇勪及|缁煎悎).*(褰卞搷|鏁堟灉|鎬ц兘|鍘熷洜|椋庨櫓)", QueryComplexity.COMPLEX),
    (r"濡傛灉.*(閭ｄ箞|浼殀灏唡鍙互|鑳?|鍋囪.*鍒檤鍦?*鏉′欢涓?, QueryComplexity.COMPLEX),
    (r"涓轰粈涔?*(浼殀杩欎箞|閭ｄ箞|瀵艰嚧)|浠€涔堝師鍥?*瀵艰嚧|鎬庝箞.*浼樺寲", QueryComplexity.COMPLEX),
    (r"鎬荤粨.*瀵规瘮|鍏ㄩ潰.*鍒嗘瀽|娣卞害.*璇勪及", QueryComplexity.COMPLEX),
    (r"(澶氳烦|鎺ㄧ悊|褰掔撼|婕旂粠|鍥犳灉)", QueryComplexity.COMPLEX),
]

_MEDIUM_PATTERNS = [
    (r"(.+)鍜?.+)鐨勫尯鍒珅(.+)涓?.+)瀵规瘮|(.+)vs\.?(.+)", QueryComplexity.MEDIUM),
    (r"(.+)鏈夊摢浜?.+)", QueryComplexity.MEDIUM),
    (r"(鎬庝箞|濡備綍)(閰嶇疆|璁剧疆|閮ㄧ讲|瀹夎|瀹炵幇|鎼缓)", QueryComplexity.MEDIUM),
    (r"(鍒楀嚭|鍒椾妇|姹囨€粅鎬荤粨).*(鍙傛暟|瑙勬牸|鐗规€鐗圭偣)", QueryComplexity.MEDIUM),
]


def analyze_query_complexity(query: str) -> Tuple[QueryComplexity, float]:
    """鍒嗘瀽鏌ヨ澶嶆潅搴?

    Args:
        query: 鐢ㄦ埛鏌ヨ鏂囨湰

    Returns:
        (complexity, confidence)
    """
    q = query.strip()

    for pattern, complexity in _COMPLEX_PATTERNS:
        if re.search(pattern, q):
            return QueryComplexity.COMPLEX, 0.85

    for pattern, complexity in _MEDIUM_PATTERNS:
        if re.search(pattern, q):
            return QueryComplexity.MEDIUM, 0.80

    if len(q) > 30:
        return QueryComplexity.MEDIUM, 0.65

    return QueryComplexity.SIMPLE, 0.90


async def llm_analyze_complexity(query: str) -> Tuple[QueryComplexity, float]:
    """閫氳繃 LLM 鍒嗘瀽鏌ヨ澶嶆潅搴︼紙澶嶆潅鏌ヨ鍏滃簳锛?""
    try:
        from src.services.llm import call_llm_fast

        prompt = f"""鍒嗘瀽浠ヤ笅鏌ヨ鐨勫鏉傚害锛岃繑鍥?JSON銆?

## 鏌ヨ
{query}

## 澶嶆潅搴﹀畾涔?
- simple: 鍗曟妫€绱㈠嵆鍙洖绛旓紙瀹氫箟鏌ヨ銆佷簨瀹炴煡璇級
- medium: 闇€瑕佸璺彫鍥炴垨瀵规瘮鍒嗘瀽
- complex: 闇€瑕佸姝ユ帹鐞嗐€佸洜鏋滃垎鏋愭垨缁煎悎璇勪及

## 杈撳嚭锛堜粎 JSON锛?
{{"complexity":"simple|medium|complex","confidence":0.9,"reason":"绠€鍥犫墹20瀛?}}"""

        result = await call_llm_fast(prompt, max_tokens=100)
        if not result:
            return QueryComplexity.SIMPLE, 0.7

        result = result.strip()
        if result.startswith("```"):
            result = result.split("\n", 1)[1].rsplit("```", 1)[0]

        data = json.loads(result)
        cmap = {"simple": QueryComplexity.SIMPLE, "medium": QueryComplexity.MEDIUM, "complex": QueryComplexity.COMPLEX}
        return cmap.get(data.get("complexity", "simple"), QueryComplexity.SIMPLE), float(data.get("confidence", 0.8))

    except Exception as e:
        logger.debug(f"[QueryPlanner] LLM 澶嶆潅搴﹀垎鏋愬け璐? {e}")
        return QueryComplexity.SIMPLE, 0.7


