def _augment_with_graph(
    results: List[Dict[str, Any]],
    categories: List[str],
    relations: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    """灏嗗浘璋卞垎绫诲拰鍏崇郴淇℃伅娉ㄥ叆妫€绱㈢粨鏋?""
    augmented = list(results)
    for cat in categories[:3]:
        augmented.append(
            {
                "file_hash": f"graph:category:{cat}",
                "text": f"[鍥捐氨鍒嗙被] 鐩稿叧棰嗗煙: {cat}",
                "file_name": "[鐭ヨ瘑鍥捐氨]",
                "category": cat,
                "chunk_index": 0,
                "score": 8.0,
                "_source": "graph_category",
            }
        )
    for rel in relations[:5]:
        subj = rel.get("subject", "")
        obj = rel.get("object", "")
        rel_type = rel.get("relation", "鍏宠仈")
        augmented.append(
            {
                "file_hash": f"graph:rel:{subj}:{obj}",
                "text": f"[鍥捐氨鍏崇郴] {subj} --{rel_type}--> {obj}",
                "file_name": "[鐭ヨ瘑鍥捐氨]",
                "category": "",
                "chunk_index": 0,
                "score": 7.0,
                "_source": "graph_relation",
                "_relation": rel,
            }
        )
    return augmented


