        """灏嗗鏉傛煡璇㈠垎瑙ｄ负瀛愭煡璇?""
        try:
            from src.services.llm import call_llm_fast

            prompt = f"""灏嗕互涓嬪鏉傛煡璇㈠垎瑙ｄ负 2-3 涓瓙鏌ヨ銆傚彧杈撳嚭 JSON 鏁扮粍銆?

鏌ヨ锛歿query}

绀轰緥锛歔"瀛愭煡璇?", "瀛愭煡璇?", "瀛愭煡璇?"]
