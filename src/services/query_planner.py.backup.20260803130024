    async def _execute_l3_graph(self, query: str, context: Dict[str, Any], step: PlanStep) -> LayerResult:
        """L3 鍥捐氨妫€绱?鈥?瀹炰綋璇嗗埆 + 鍏崇郴鍥捐氨閬嶅巻"""
        try:
