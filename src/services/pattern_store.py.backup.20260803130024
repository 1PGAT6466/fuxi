def record_episode(
    skill: str,
    situation: str,
    action: str,
    outcome: str,
    lesson: str,
    related_pattern: Optional[str] = None,
    user_feedback: Optional[Dict] = None,
) -> Dict:
    """璁板綍涓€娆″叿浣撶粡鍘嗭紙鎯呮櫙璁板繂锛?""
    episode = {
        "id": f"ep-{time.strftime('%Y%m%d-%H%M%S')}",
        "timestamp": time.time(),
        "skill": skill,
        "situation": situation,
        "action": action,
        "outcome": outcome,
        "lesson": lesson,
        "related_pattern": related_pattern,
        "user_feedback": user_feedback,
    }

    # 鍐欏叆鎸夋棩鏈熷垎鏂囦欢
    date_str = time.strftime("%Y-%m-%d")
    ep_file = EPISODIC_DIR / f"{date_str}.jsonl"
    with open(ep_file, "a", encoding="utf-8") as f:
        f.write(json.dumps(episode, ensure_ascii=False) + "\n")

    # 璁板綍杩涘寲鏃ュ織
    _log_evolution("episode_recorded", episode["id"], {"skill": skill, "outcome": outcome, "lesson": lesson})

    logger.info(f"[PatternStore] 鎯呮櫙璁板綍: {episode['id']} ({skill})")
    return episode


def get_recent_episodes(days: int = 7, skill: Optional[str] = None) -> List[Dict]:
    """鑾峰彇鏈€杩?N 澶╃殑鎯呮櫙璁板繂"""
    episodes = []
    for i in range(days):
        date_str = time.time() - i * 86400
        date_str = time.strftime("%Y-%m-%d", time.localtime(date_str))
        ep_file = EPISODIC_DIR / f"{date_str}.jsonl"
        if ep_file.exists():
            for line in ep_file.read_text(encoding="utf-8").strip().split("\n"):
                if line.strip():
                    try:
                        ep = json.loads(line)
                        if skill and ep.get("skill") != skill:
                            continue
                        episodes.append(ep)
                    except json.JSONDecodeError:
                        continue
    return episodes


# 鈹€鈹€ 杩涘寲鏃ュ織 鈹€鈹€


def _log_evolution(event_type: str, target_id: str, details: Dict):
    """璁板綍杩涘寲浜嬩欢锛堝彲杩芥函锛?""
    entry = {
        "timestamp": time.time(),
        "time_str": time.strftime("%Y-%m-%d %H:%M:%S"),
        "event": event_type,
        "target": target_id,
        "details": details,
    }
    with open(EVOLUTION_LOG, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


def get_evolution_log(limit: int = 50) -> List[Dict]:
    """鑾峰彇杩涘寲鏃ュ織"""
    if not EVOLUTION_LOG.exists():
        return []
    lines = EVOLUTION_LOG.read_text(encoding="utf-8").strip().split("\n")
    entries = []
    for line in lines[-limit:]:
        if line.strip():
            try:
                entries.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    return entries


